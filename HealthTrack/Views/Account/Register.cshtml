@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>HealthTrack - Register</title>

    <link rel="stylesheet"
          href="~/css/account.css"
          asp-append-version="true" />

</head>

<body>

    <div class="account-page">

        <div class="account-card">

            <!-- =====================================================
             LEFT FITNESS PANEL
             ===================================================== -->

            <section class="brand-panel">

                <div class="brand-content">

                    <div>

                        <!-- LOGO -->

                        <div class="brand-logo">

                            <div class="logo-icon">

                                <svg viewBox="0 0 64 64"
                                     xmlns="http://www.w3.org/2000/svg">

                                    <rect x="7" y="25"
                                          width="8"
                                          height="14"
                                          rx="2" />

                                    <rect x="15" y="20"
                                          width="7"
                                          height="24"
                                          rx="2" />

                                    <rect x="42" y="20"
                                          width="7"
                                          height="24"
                                          rx="2" />

                                    <rect x="49" y="25"
                                          width="8"
                                          height="14"
                                          rx="2" />

                                    <rect x="20" y="29"
                                          width="24"
                                          height="6"
                                          rx="3" />

                                </svg>

                            </div>

                            <div class="brand-name">
                                Health<span>Track</span>
                            </div>

                        </div>


                        <p class="brand-subtitle">
                            Personal Health &amp; Fitness
                            Management System
                        </p>


                        <!-- FEATURES -->

                        <div class="feature-list">

                            <div class="feature">

                                <div class="feature-icon">

                                    <svg viewBox="0 0 24 24">
                                        <path d="M4 19V9" />
                                        <path d="M10 19V5" />
                                        <path d="M16 19v-7" />
                                        <path d="M22 19V3" />
                                    </svg>

                                </div>

                                <div class="feature-text">

                                    <strong>
                                        Track Your Progress
                                    </strong>

                                    <span>
                                        Monitor your fitness journey
                                    </span>

                                </div>

                            </div>


                            <div class="feature">

                                <div class="feature-icon">

                                    <svg viewBox="0 0 24 24">

                                        <circle cx="12"
                                                cy="5"
                                                r="2.5" />

                                        <path d="M8 10l4-2 4 2" />
                                        <path d="M8 10l-2 5" />
                                        <path d="M16 10l2 5" />
                                        <path d="M12 8v7" />
                                        <path d="M8 18l4-3 4 3" />

                                    </svg>

                                </div>

                                <div class="feature-text">

                                    <strong>
                                        Stay Fit &amp; Healthy
                                    </strong>

                                    <span>
                                        Get personalized guidance
                                    </span>

                                </div>

                            </div>


                            <div class="feature">

                                <div class="feature-icon">

                                    <svg viewBox="0 0 24 24">

                                        <path d="M12 20S5 16 5 9a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 7-7 11-7 11z" />

                                    </svg>

                                </div>

                                <div class="feature-text">

                                    <strong>
                                        Personalized Plans
                                    </strong>

                                    <span>
                                        Nutrition &amp; workout plans
                                    </span>

                                </div>

                            </div>


                            <div class="feature">

                                <div class="feature-icon">

                                    <svg viewBox="0 0 24 24">

                                        <rect x="3"
                                              y="4"
                                              width="18"
                                              height="17"
                                              rx="2" />

                                        <path d="M16 2v4" />
                                        <path d="M8 2v4" />
                                        <path d="M3 9h18" />

                                        <path d="M8 13h2" />
                                        <path d="M14 13h2" />
                                        <path d="M8 17h2" />
                                        <path d="M14 17h2" />

                                    </svg>

                                </div>

                                <div class="feature-text">

                                    <strong>
                                        Manage Appointments
                                    </strong>

                                    <span>
                                        Book and manage sessions
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="brand-bottom">

                        <div class="quote">
                            A Healthier You<br />
                            A Better Tomorrow
                        </div>

                        <div class="quote-line"></div>

                    </div>

                </div>

            </section>


            <!-- =====================================================
             RIGHT REGISTER PANEL
             ===================================================== -->

            <section class="form-panel">

                <div class="form-container">


                    <!-- BACK TO LOGIN -->

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="back-link">

                        ← Back to Login

                    </a>


                    <h1 class="form-title">
                        Create Account
                    </h1>

                    <p class="form-subtitle">
                        Join HealthTrack and start your fitness journey
                    </p>


                    @if (ViewBag.Error != null)
                    {
                        <div class="validation-summary">
                            @ViewBag.Error
                        </div>
                    }


                    <form asp-controller="Account"
                          asp-action="Register"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- FULL NAME -->

                        <div class="form-group">

                            <label class="form-label">
                                Full Name
                            </label>

                            <div class="input-wrapper">

                                <div class="input-icon">

                                    <svg viewBox="0 0 24 24">

                                        <circle cx="12"
                                                cy="8"
                                                r="3.5" />

                                        <path d="M5 21a7 7 0 0 1 14 0" />

                                    </svg>

                                </div>


                                <input type="text"
                                       name="FullName"
                                       class="form-input"
                                       placeholder="Enter your full name"
                                       autocomplete="name"
                                       required />

                            </div>

                        </div>


                        <!-- EMAIL -->

                        <div class="form-group">

                            <label class="form-label">
                                Email Address
                            </label>

                            <div class="input-wrapper">

                                <div class="input-icon">

                                    <svg viewBox="0 0 24 24">

                                        <rect x="3"
                                              y="5"
                                              width="18"
                                              height="14"
                                              rx="2" />

                                        <path d="m3 7 9 6 9-6" />

                                    </svg>

                                </div>


                                <input type="email"
                                       name="Email"
                                       class="form-input"
                                       placeholder="Enter your email"
                                       autocomplete="email"
                                       required />

                            </div>

                        </div>


                        <!-- PHONE NUMBER -->

                        <div class="form-group">

                            <label class="form-label">
                                Phone Number
                            </label>

                            <div class="input-wrapper">

                                <div class="input-icon">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M6.6 3.5h2.2l1.1 4.2-1.8 1.5a15.4 15.4 0 0 0 6.7 6.7l1.5-1.8 4.2 1.1v2.2c0 1.2-1 2.1-2.1 2.1C10.8 19.5 4.5 13.2 4.5 5.6 4.5 4.5 5.4 3.5 6.6 3.5z" />
                                    </svg>
                                </div>

                                <input type="tel"
                                       name="Phone"
                                       class="form-input"
                                       placeholder="Enter your phone number"
                                       autocomplete="tel"
                                       inputmode="numeric"
                                       maxlength="15"
                                       required />

                            </div>

                        </div>


                        <!-- PASSWORD -->

                        <div class="form-group">

                            <label class="form-label">
                                Password
                            </label>

                            <div class="input-wrapper">

                                <div class="input-icon">

                                    <svg viewBox="0 0 24 24">

                                        <rect x="5"
                                              y="10"
                                              width="14"
                                              height="11"
                                              rx="2" />

                                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />

                                    </svg>

                                </div>


                                <input type="password"
                                       id="registerPassword"
                                       name="Password"
                                       class="form-input"
                                       placeholder="Create a password"
                                       autocomplete="new-password"
                                       required />


                                <button type="button"
                                        class="password-toggle"
                                        onclick="togglePassword('registerPassword', this)">

                                    <svg viewBox="0 0 24 24">

                                        <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z" />

                                        <circle cx="12"
                                                cy="12"
                                                r="2.5" />

                                    </svg>

                                </button>

                            </div>

                        </div>


                        <!-- CONFIRM PASSWORD -->

                        <div class="form-group">

                            <label class="form-label">
                                Confirm Password
                            </label>

                            <div class="input-wrapper">

                                <div class="input-icon">

                                    <svg viewBox="0 0 24 24">

                                        <rect x="5"
                                              y="10"
                                              width="14"
                                              height="11"
                                              rx="2" />

                                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />

                                    </svg>

                                </div>


                                <input type="password"
                                       id="confirmPassword"
                                       name="ConfirmPassword"
                                       class="form-input"
                                       placeholder="Confirm your password"
                                       autocomplete="new-password"
                                       required />


                                <button type="button"
                                        class="password-toggle"
                                        onclick="togglePassword('confirmPassword', this)">

                                    <svg viewBox="0 0 24 24">

                                        <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z" />

                                        <circle cx="12"
                                                cy="12"
                                                r="2.5" />

                                    </svg>

                                </button>

                            </div>

                        </div>


                        <!-- REGISTER -->

                        <button type="submit"
                                class="submit-btn">

                            Register
                            <span style="margin-left:8px;">
                                →
                            </span>

                        </button>

                    </form>


                    <!-- SOCIAL -->

                    <div class="divider">
                        OR CONTINUE WITH
                    </div>


                    <div class="social-buttons">

                        <!-- GOOGLE -->

                        <button type="button"
                                class="social-btn">

                            <svg viewBox="0 0 24 24">

                                <path fill="#4285F4"
                                      d="M21.6 12.23c0-.79-.07-1.55-.22-2.28H12v4.32h5.38a4.6 4.6 0 0 1-1.99 3.02v2.51h3.22c1.89-1.74 2.99-4.31 2.99-7.57z" />

                                <path fill="#34A853"
                                      d="M12 22c2.7 0 4.96-.9 6.61-2.43l-3.22-2.51c-.9.6-2.05.95-3.39.95-2.61 0-4.82-1.76-5.61-4.13H3.06v2.59A9.99 9.99 0 0 0 12 22z" />

                                <path fill="#FBBC05"
                                      d="M6.39 13.88A6.01 6.01 0 0 1 6.08 12c0-.65.11-1.28.31-1.88V7.53H3.06A10 10 0 0 0 2 12c0 1.61.39 3.14 1.06 4.47l3.33-2.59z" />

                                <path fill="#EA4335"
                                      d="M12 5.98c1.47 0 2.79.5 3.83 1.48l2.87-2.87C16.95 2.9 14.7 2 12 2a9.99 9.99 0 0 0-8.94 5.53l3.33 2.59C7.18 7.74 9.39 5.98 12 5.98z" />

                            </svg>

                        </button>


                        <!-- MICROSOFT -->

                        <button type="button"
                                class="social-btn">

                            <svg viewBox="0 0 24 24">

                                <rect x="3"
                                      y="3"
                                      width="8"
                                      height="8"
                                      fill="#f35325" />

                                <rect x="13"
                                      y="3"
                                      width="8"
                                      height="8"
                                      fill="#81bc06" />

                                <rect x="3"
                                      y="13"
                                      width="8"
                                      height="8"
                                      fill="#05a6f0" />

                                <rect x="13"
                                      y="13"
                                      width="8"
                                      height="8"
                                      fill="#ffba08" />

                            </svg>

                        </button>


                        <!-- APPLE -->

                        <button type="button"
                                class="social-btn">

                            <svg viewBox="0 0 24 24"
                                 fill="#111">

                                <path d="M17.05 12.54c-.02-2.06 1.68-3.05 1.76-3.1a3.76 3.76 0 0 0-2.96-1.6c-1.25-.13-2.44.74-3.07.74-.64 0-1.62-.72-2.67-.7a3.93 3.93 0 0 0-3.32 2.02c-1.43 2.47-.36 6.11 1.02 8.12.68.98 1.48 2.08 2.53 2.04 1.02-.04 1.4-.66 2.63-.66 1.23 0 1.57.66 2.65.64 1.1-.02 1.79-.99 2.46-1.98.77-1.12 1.08-2.2 1.1-2.25-.02-.01-2.11-.81-2.13-3.21z" />

                                <path d="M15.02 6.52c.56-.68.94-1.62.83-2.56-.81.03-1.78.54-2.36 1.22-.52.6-.97 1.56-.85 2.47.9.07 1.82-.46 2.38-1.13z" />

                            </svg>

                        </button>

                    </div>


                    <!-- LOGIN -->

                    <div class="account-switch">

                        Already have an account?

                        <a asp-controller="Account"
                           asp-action="Login">

                            Login
                            →

                        </a>

                    </div>

                </div>

            </section>

        </div>

    </div>


    <script>

            function togglePassword(id, button) {

                const input = document.getElementById(id);

                if (input.type === "password") {

                    input.type = "text";

                } else {

                    input.type = "password";

                }

            }

    </script>

</body>
</html>