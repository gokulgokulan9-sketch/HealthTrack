@using System
@using HealthTrack.Models

@{
    Layout = null;
    ViewData["Title"] = "Messages";

    var clientName = ViewBag.ClientName as string;
    if (string.IsNullOrWhiteSpace(clientName)) clientName = User?.Identity?.Name;
    if (string.IsNullOrWhiteSpace(clientName)) clientName = "Client";
    if (clientName.Contains("@")) clientName = clientName.Split('@')[0];

    var clientInitial = !string.IsNullOrWhiteSpace(clientName)
        ? clientName.Substring(0, 1).ToUpper()
        : "C";

    var profileImage = ViewBag.ProfileImage as string;
    if (string.IsNullOrWhiteSpace(profileImage))
        profileImage = "/images/default-user.png";
    else if (!profileImage.StartsWith("/images/", StringComparison.OrdinalIgnoreCase))
        profileImage = "/images/" + profileImage.TrimStart('/');

    var trainerName = ViewBag.TrainerName as string ?? "Trainer";
    var trainerImage = ViewBag.TrainerImage as string ?? "/images/default-trainer.jpg";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Messages - HealthTrack</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<style>

    /* ============================================================
           GLOBAL
           ============================================================ */

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0 !important;
        padding: 0 !important;
        width: 100%;
        min-height: 100%;
        font-family: "Segoe UI", Arial, sans-serif;
        background: radial-gradient(circle at 85% 10%, rgba(22,138,74,0.08), transparent 30%), #090b0e;
        color: #ffffff;
    }

    body > * {
        margin-top: 0 !important;
    }

    main {
        margin-top: 0 !important;
    }

    a {
        text-decoration: none;
    }

    /* ============================================================
           MAIN CLIENT LAYOUT
           ============================================================ */

    .client-layout {
        min-height: 100vh;
        width: 100%;
        background: linear-gradient( 135deg, #080a0d 0%, #0d1014 45%, #080a0d 100% );
    }

    /* ============================================================
           SIDEBAR
           ============================================================ */

    .client-sidebar {
        width: 245px;
        min-width: 245px;
        height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        background: linear-gradient( 180deg, #08090c 0%, #101216 55%, #08090b 100% );
        border-right: 1px solid rgba(255,255,255,0.08);
        box-shadow: 5px 0 30px rgba(0,0,0,0.35);
        overflow-y: auto;
        overflow-x: hidden;
    }

        .client-sidebar::-webkit-scrollbar {
            width: 5px;
        }

        .client-sidebar::-webkit-scrollbar-track {
            background: transparent;
        }

        .client-sidebar::-webkit-scrollbar-thumb {
            background: rgba(22,138,74,0.55);
            border-radius: 10px;
        }

    /* ============================================================
           EXACT HEALTH TRACK LOGO
           ============================================================ */

    .healthtrack-logo {
        height: 82px;
        display: flex;
        align-items: center;
        padding: 0 20px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .healthtrack-logo-symbol {
        width: 45px;
        height: 45px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #168A4A;
        color: #ffffff;
        font-size: 23px;
        box-shadow: 0 5px 18px rgba(22,138,74,0.32);
    }

    .healthtrack-logo-text {
        margin-left: 10px;
        font-size: 22px;
        font-weight: 800;
        letter-spacing: -0.7px;
        color: #ffffff;
    }

        .healthtrack-logo-text span {
            color: #168A4A;
        }

    /* ============================================================
           PROFILE
           ============================================================ */

    .client-profile {
        margin: 18px 12px 16px;
        padding: 14px;
        display: flex;
        align-items: center;
        border-radius: 13px;
        background: linear-gradient( 135deg, rgba(255,255,255,0.07), rgba(255,255,255,0.025) );
        border: 1px solid rgba(255,255,255,0.07);
    }

    .client-profile-image {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #168A4A;
        background: #222;
    }

    .client-profile-info {
        margin-left: 11px;
        min-width: 0;
    }

    .client-profile-name {
        color: #ffffff;
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .client-profile-role {
        margin-top: 3px;
        color: #a7a7a7;
        font-size: 11px;
    }

    /* ============================================================
           MENU TITLE
           ============================================================ */

    .menu-title {
        padding: 0 22px;
        margin: 2px 0 8px;
        color: #777b83;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.2px;
    }

    /* ============================================================
           SIDEBAR MENU
           ============================================================ */

    .client-menu {
        padding: 0 10px;
    }

    .client-menu-item {
        height: 45px;
        margin-bottom: 4px;
        padding: 0 14px;
        display: flex;
        align-items: center;
        gap: 13px;
        border-radius: 10px;
        color: #d7d7d7;
        font-size: 13px;
        font-weight: 500;
        transition: all 0.2s ease;
    }

        .client-menu-item i {
            width: 20px;
            text-align: center;
            font-size: 15px;
            color: #d9d9d9;
        }

        .client-menu-item:hover {
            color: #ffffff;
            background: rgba(255,255,255,0.08);
            transform: translateX(2px);
        }

            .client-menu-item:hover i {
                color: #168A4A;
            }

        .client-menu-item.active {
            color: #ffffff;
            background: linear-gradient( 90deg, #168A4A, #0B6335 );
            box-shadow: 0 7px 20px rgba(22,138,74,0.28);
        }

            .client-menu-item.active i {
                color: #ffffff;
            }

    .notification-count {
        margin-left: auto;
        min-width: 20px;
        height: 20px;
        padding: 0 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #168A4A;
        color: #ffffff;
        font-size: 10px;
        font-weight: 700;
    }

    /* ============================================================
           SIDEBAR BOTTOM BRAND AREA
           ============================================================ */

    .sidebar-bottom {
        margin-top: auto;
        min-height: 145px;
        padding: 22px 20px;
        position: relative;
        overflow: hidden;
        background: radial-gradient( circle at 15% 100%, rgba(22,138,74,0.34), transparent 55% );
    }

        .sidebar-bottom::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            left: -70px;
            bottom: -115px;
            border-radius: 50%;
            border: 1px solid rgba(22,138,74,0.45);
            box-shadow: 0 0 35px rgba(22,138,74,0.18);
        }

    .sidebar-bottom-title {
        position: relative;
        z-index: 2;
        font-size: 15px;
        font-weight: 800;
        line-height: 1.4;
        color: #ffffff;
    }

        .sidebar-bottom-title span {
            display: block;
            color: #168A4A;
        }

    .sidebar-line {
        width: 48px;
        height: 3px;
        margin-top: 12px;
        border-radius: 5px;
        background: #168A4A;
    }

    /* ============================================================
       PAGE / BODY RESET
       ============================================================ */

    html,
    body {
        margin: 0 !important;
        padding: 0 !important;
        width: 100%;
        min-height: 100%;
    }

    * {
        box-sizing: border-box;
    }


    /* ============================================================
       CLIENT MAIN CONTENT
       ============================================================ */

    .client-main {
        margin-left: 245px !important;
        margin-top: 0 !important;
        padding-top: 0 !important;
        min-height: 100vh;
        background: radial-gradient(circle at 92% 8%, rgba(239,35,60,0.13), transparent 22%), radial-gradient(circle at 15% 15%, rgba(24,169,87,0.12), transparent 28%), #10231D;
        position: relative;
        top: 0 !important;
    }


    /* ============================================================
       TOPBAR
       ============================================================ */

    .client-topbar {
        height: 68px;
        margin: 0 !important;
        padding: 0 25px;
        display: flex;
        align-items: center;
        border-bottom: 1px solid rgba(255,255,255,0.07);
        background: linear-gradient( 90deg, #090a0d, #101216 );
        position: sticky;
        top: 0 !important;
        z-index: 900;
    }

    .mobile-menu-btn {
        width: 40px;
        height: 40px;
        display: none;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: rgba(255,255,255,0.06);
        color: #ffffff;
        font-size: 17px;
    }

    .search-box {
        width: 365px;
        height: 40px;
        display: flex;
        align-items: center;
        padding: 0 14px;
        border-radius: 9px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.07);
        color: #8f949c;
    }

        .search-box i {
            font-size: 14px;
        }

        .search-box input {
            width: 100%;
            border: none;
            outline: none;
            background: transparent;
            color: #ffffff;
            padding-left: 10px;
            font-size: 12px;
        }

            .search-box input::placeholder {
                color: #858991;
            }

    .topbar-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 22px;
    }

    .notification-icon {
        position: relative;
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #d7d7d7;
        font-size: 17px;
    }

    .notification-badge {
        position: absolute;
        top: -1px;
        right: -1px;
        min-width: 17px;
        height: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 4px;
        border-radius: 50%;
        background: #18A957;
        color: #ffffff;
        font-size: 9px;
        font-weight: 700;
        border: 2px solid #132A22;
    }

    .top-profile {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .top-profile-image {
        width: 39px;
        height: 39px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,0.15);
    }

    .top-profile-text {
        line-height: 1.25;
    }

    .top-profile-name {
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
    }

    .top-profile-role {
        color: #888d96;
        font-size: 10px;
    }

    .top-profile i {
        color: #858991;
        font-size: 11px;
        margin-left: 4px;
    }

    /* ============================================================
           DASHBOARD CONTENT
           ============================================================ */

    .dashboard-content {
        padding: 24px 26px 35px;
    }

    /* ============================================================
           WELCOME HEADER
           ============================================================ */

    .welcome-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
    }

    .welcome-title {
        margin: 0;
        color: #ffffff;
        font-size: 27px;
        font-weight: 800;
        letter-spacing: -0.7px;
    }

        .welcome-title span {
            color: #18A957;
        }

    .welcome-subtitle {
        margin: 6px 0 0;
        color: #90959d;
        font-size: 13px;
    }

    .today-card {
        min-width: 220px;
        padding: 11px 15px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-radius: 11px;
        background: linear-gradient( 135deg, rgba(255,255,255,0.05), rgba(255,255,255,0.025) );
        border: 1px solid rgba(255,255,255,0.09);
    }

    .today-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: rgba(24,169,87,0.12);
        color: #18A957;
        font-size: 18px;
    }

    .today-label {
        color: #8d929a;
        font-size: 10px;
    }

    .today-date {
        margin-top: 2px;
        color: #ffffff;
        font-size: 12px;
        font-weight: 600;
    }

    /* ============================================================
           STAT CARDS
           ============================================================ */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 15px;
    }

    .stat-card {
        min-height: 92px;
        display: flex;
        align-items: center;
        padding: 14px;
        border-radius: 12px;
        background: linear-gradient( 145deg, #172B24, #13251F );
        border: 1px solid rgba(255,255,255,0.10);
        box-shadow: 0 10px 25px rgba(0,40,25,0.24);
        transition: 0.2s ease;
    }

        .stat-card:hover {
            transform: translateY(-2px);
            border-color: rgba(24,169,87,0.35);
        }

    .stat-icon {
        width: 57px;
        height: 57px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 22px;
    }

        .stat-icon.red {
            color: #ffffff;
            background: #EF233C;
            box-shadow: 0 8px 20px rgba(24,169,87,0.22);
        }

        .stat-icon.green {
            color: #ffffff;
            background: #20B85A;
        }

        .stat-icon.purple {
            color: #ffffff;
            background: #198754;
        }

        .stat-icon.orange {
            color: #ffffff;
            background: #2DB56B;
        }

    .stat-info {
        margin-left: 13px;
    }

    .stat-number {
        color: #ffffff;
        font-size: 25px;
        font-weight: 800;
        line-height: 1;
    }

    .stat-label {
        margin-top: 5px;
        color: #989da5;
        font-size: 11px;
    }

    /* ============================================================
           HERO BANNER
           ============================================================ */

    .hero-banner {
        min-height: 160px;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        padding: 28px 42px;
        margin-bottom: 15px;
        border-radius: 13px;
        border: 1px solid rgba(255,255,255,0.09);
        background: linear-gradient( 90deg, rgba(5,35,25,0.92) 0%, rgba(8,52,36,0.72) 42%, rgba(8,35,26,0.22) 100% ), url("https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=1600&q=85") center/cover no-repeat;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 500px;
    }

    .hero-title {
        margin: 0;
        color: #ffffff;
        font-size: 27px;
        font-weight: 800;
        line-height: 1.08;
    }

        .hero-title span {
            display: block;
            color: #18A957;
        }

    .hero-text {
        margin: 10px 0 0;
        color: #dedede;
        font-size: 13px;
    }

    .hero-line {
        width: 48px;
        height: 3px;
        margin-top: 14px;
        border-radius: 5px;
        background: #18A957;
    }

    /* ============================================================
           CONTENT GRID
           ============================================================ */

    .dashboard-grid {
        display: grid;
        grid-template-columns: 1.15fr 1fr 1fr;
        gap: 14px;
        margin-bottom: 14px;
    }

    .dashboard-card {
        min-width: 0;
        padding: 17px;
        border-radius: 12px;
        background: linear-gradient( 145deg, #172B24, #152922 );
        border: 1px solid rgba(255,255,255,0.09);
        box-shadow: 0 10px 25px rgba(0,40,25,0.22);
    }

    .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
    }

    .card-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #ffffff;
        font-size: 14px;
        font-weight: 700;
    }

        .card-title i {
            color: #18A957;
            font-size: 16px;
        }

    .view-link {
        color: #18A957;
        font-size: 11px;
        font-weight: 600;
    }

        .view-link:hover {
            color: #35C978;
        }

    /* ============================================================
           TRAINER CARD
           ============================================================ */

    .trainer-box {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .trainer-image {
        width: 91px;
        height: 91px;
        flex-shrink: 0;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid rgba(24,169,87,0.55);
        background: #222;
    }

    .trainer-details {
        min-width: 0;
    }

    .trainer-name {
        color: #ffffff;
        font-size: 16px;
        font-weight: 700;
    }

    .trainer-role {
        margin-top: 4px;
        color: #92979f;
        font-size: 11px;
    }

    .message-btn {
        margin-top: 12px;
        height: 35px;
        padding: 0 15px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 8px;
        color: #ffffff;
        background: #18A957;
        font-size: 11px;
        font-weight: 600;
        box-shadow: 0 6px 15px rgba(24,169,87,0.22);
    }

        .message-btn:hover {
            color: #ffffff;
            background: #C91F35;
        }

    /* ============================================================
           APPOINTMENT
           ============================================================ */

    .appointment-box {
        display: flex;
        gap: 13px;
        padding: 11px;
        border-radius: 10px;
        background: rgba(255,255,255,0.035);
        border: 1px solid rgba(255,255,255,0.05);
    }

    .appointment-date {
        width: 56px;
        flex-shrink: 0;
        overflow: hidden;
        border-radius: 8px;
        text-align: center;
        background: #1B3028;
    }

    .appointment-month {
        padding: 6px 0;
        background: #18A957;
        color: #ffffff;
        font-size: 10px;
        font-weight: 700;
    }

    .appointment-day {
        padding: 7px 0;
        color: #ffffff;
        font-size: 20px;
        font-weight: 800;
    }

    .appointment-info {
        min-width: 0;
    }

    .appointment-title {
        color: #ffffff;
        font-size: 13px;
        font-weight: 700;
    }

    .appointment-trainer,
    .appointment-time,
    .appointment-location {
        margin-top: 6px;
        color: #92979f;
        font-size: 10px;
    }

        .appointment-time i,
        .appointment-location i {
            width: 15px;
            color: #18A957;
        }

    .status-badge {
        display: inline-block;
        margin-top: 8px;
        padding: 5px 9px;
        border-radius: 20px;
        background: rgba(32,184,90,0.15);
        color: #4AD982;
        font-size: 9px;
        font-weight: 700;
    }

    /* ============================================================
           PROGRESS
           ============================================================ */

    .progress-row {
        margin-bottom: 13px;
    }

    .progress-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .progress-name {
        color: #d6d8dc;
        font-size: 11px;
    }

    .progress-value {
        color: #ffffff;
        font-size: 10px;
        font-weight: 600;
    }

    .progress-track {
        height: 7px;
        overflow: hidden;
        border-radius: 20px;
        background: #294038;
    }

    .progress-fill {
        height: 100%;
        border-radius: 20px;
        background: #EF233C;
    }

        .progress-fill.green {
            background: #20B85A;
        }

        .progress-fill.purple {
            background: #25A65F;
        }

        .progress-fill.orange {
            background: #39C978;
        }

    /* ============================================================
           PLANS
           ============================================================ */

    .plan-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .plan-item {
        min-height: 55px;
        display: flex;
        align-items: center;
        padding: 9px 10px;
        border-radius: 9px;
        background: rgba(255,255,255,0.035);
        border: 1px solid rgba(255,255,255,0.045);
    }

    .plan-icon {
        width: 37px;
        height: 37px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        color: #18A957;
        background: rgba(24,169,87,0.10);
        font-size: 16px;
    }

        .plan-icon.green {
            color: #46D17A;
            background: rgba(70,209,122,0.10);
        }

    .plan-info {
        margin-left: 10px;
        min-width: 0;
    }

    .plan-name {
        color: #ffffff;
        font-size: 11px;
        font-weight: 600;
    }

    .plan-date {
        margin-top: 3px;
        color: #858a92;
        font-size: 9px;
    }

    .active-badge {
        margin-left: auto;
        padding: 5px 9px;
        border-radius: 15px;
        background: rgba(26,180,104,0.14);
        color: #28d57e;
        font-size: 9px;
        font-weight: 700;
    }

    /* ============================================================
           MESSAGES
           ============================================================ */

    .message-list {
        display: flex;
        flex-direction: column;
    }

    .message-item {
        display: flex;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

        .message-item:last-child {
            border-bottom: none;
        }

    .message-avatar {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        object-fit: cover;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.12);
    }

    .message-info {
        margin-left: 9px;
        min-width: 0;
        flex: 1;
    }

    .message-name {
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
    }

    .message-preview {
        margin-top: 3px;
        color: #838890;
        font-size: 9px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .message-time {
        color: #8a8f97;
        font-size: 9px;
    }

    .message-unread {
        width: 17px;
        height: 17px;
        margin-left: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #18A957;
        color: #ffffff;
