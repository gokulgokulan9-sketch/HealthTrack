    /* ============================================================
           RESPONSIVE
           ============================================================ */

    @@media (max-width: 1200px) {

        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .dashboard-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
