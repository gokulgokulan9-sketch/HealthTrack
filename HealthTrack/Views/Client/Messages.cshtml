                transform: translateX(0);
            }

        .client-main {
            margin-left: 0;
        }

        .mobile-menu-btn {
            display: flex;
            margin-right: 12px;
        }

        .search-box {
            width: 250px;
        }
    }

    @@media (max-width: 700px) {

        .dashboard-content {
            padding: 18px 15px 25px;
        }

