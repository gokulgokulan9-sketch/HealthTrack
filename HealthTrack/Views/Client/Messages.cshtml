<script>
function toggleClientSidebar() {
    const sidebar = document.getElementById("clientSidebar");
    if (sidebar) sidebar.classList.toggle("open");
}

let trainerId = 0;
let currentTrainerName = "Trainer";
let currentTrainerImage = "/images/default-trainer.jpg";

function escapeHtml(value) {
    const div = document.createElement("div");
    div.textContent = value == null ? "" : String(value);
    return div.innerHTML;
}

async function loadChat() {
    const box = document.getElementById("chatMessages");
    if (!box) return;

    box.innerHTML = '<div class="chat-empty">Loading conversation...</div>';

    try {
        const response = await fetch('@Url.Action("ClientChatHistory", "Home")', {
            method: "GET",
            credentials: "same-origin",
            headers: { "X-Requested-With": "XMLHttpRequest" }
        });

        if (response.status === 401) {
            window.location.href = '@Url.Action("Login", "Account")';
            return;
        }

        const contentType = response.headers.get("content-type") || "";
        const raw = await response.text();

        if (!contentType.includes("application/json")) {
            console.error("Client chat history server response:", raw);
            box.innerHTML = '<div class="chat-error">Unable to load messages. Please refresh the page.</div>';
            return;
        }

        const data = JSON.parse(raw);

        if (!response.ok || data.success === false) {
            box.innerHTML =
                '<div class="chat-error">' +
                escapeHtml(data.message || "Unable to load messages.") +
                '</div>';
            return;
        }

        if (data.hasTrainer === false || !data.trainerId) {
            box.innerHTML = '<div class="chat-empty">No trainer is currently assigned to you.</div>';
            return;
        }

        trainerId = Number(data.trainerId || 0);
        currentTrainerName = data.trainerName || "Trainer";
        currentTrainerImage = data.trainerImage || "/images/default-trainer.jpg";

        document.getElementById("chatTrainerName").textContent = currentTrainerName;
        document.getElementById("trainerSideName").textContent = currentTrainerName;
        document.getElementById("trainerSideImage").src = currentTrainerImage;
        document.getElementById("callTrainerImage").src = currentTrainerImage;
        document.getElementById("callName").textContent = currentTrainerName;

        const avatar = document.getElementById("chatTrainerAvatar");
        const initial = currentTrainerName.trim().charAt(0).toUpperCase() || "T";
        if (currentTrainerImage) {
            avatar.outerHTML = '<img id="chatTrainerAvatar" class="chat-header-avatar" src="' + escapeHtml(currentTrainerImage) + '" alt="Trainer" onerror="this.src=\'/images/default-trainer.jpg\';" />';
        } else {
            avatar.textContent = initial;
        }

        renderMessages(data.messages || []);
    } catch (error) {
        console.error(error);
        box.innerHTML = '<div class="chat-error">Unable to load messages.</div>';
    }
}

function renderMessages(messages) {
    const box = document.getElementById("chatMessages");
    if (!box) return;

    if (!messages || messages.length === 0) {
        box.innerHTML = '<div class="chat-empty">No messages yet. Start the conversation.</div>';
        return;
    }

    box.innerHTML = "";

    messages.forEach(function (item) {
        const mine = item.isClient !== undefined ? item.isClient : item.isMine;
        const textValue = item.messageText !== undefined ? item.messageText : item.message;
        const timeValue = item.sentAt || "";

        const row = document.createElement("div");
        row.className = "client-message-row " + (mine ? "mine" : "theirs");

        const bubble = document.createElement("div");
        bubble.className = "client-message-bubble";

        if (String(textValue || "").startsWith("__HT_ATTACHMENT__|")) {
            const parts = String(textValue).split("|");
            const name = parts[1] || "Attachment";
            const url = parts[2] || "#";
            const type = parts[3] || "";

            const attachment = document.createElement("a");
            attachment.className = "attachment-card";
            attachment.href = url;
            attachment.target = "_blank";
            attachment.rel = "noopener";

            let icon = "fa-file";
            if (type.startsWith("image/")) icon = "fa-image";
            else if (type.startsWith("video/")) icon = "fa-video";
            else if (type.startsWith("audio/")) icon = "fa-file-audio";
            else if (type.includes("pdf")) icon = "fa-file-pdf";

            attachment.innerHTML =
                '<i class="fa-solid ' + icon + '"></i>' +
                '<span class="attachment-name"></span>';

            attachment.querySelector(".attachment-name").textContent = name;
            bubble.appendChild(attachment);
        } else {
            const text = document.createElement("div");
            text.textContent = textValue || "";
            bubble.appendChild(text);
        }

        const time = document.createElement("span");
        time.className = "client-message-time";
        time.textContent = timeValue;

        bubble.appendChild(time);
        row.appendChild(bubble);
        box.appendChild(row);
    });

    box.scrollTop = box.scrollHeight;
}

async function sendMessage(event) {
    if (event) event.preventDefault();

    const input = document.getElementById("messageInput");
    const send = document.getElementById("sendBtn");
    if (!input || !send) return;

    const message = input.value.trim();
    if (!message) return;

    if (!trainerId) {
        await loadChat();
        if (!trainerId) return;
    }

    const form = document.getElementById("clientChatForm");

    if (!form) {
        alert("Chat form is not available. Please refresh the page.");
        return;
    }

    send.disabled = true;

    try {
        const body = new URLSearchParams(new FormData(form));

        body.set("receiverId", String(trainerId));
        body.set("message", message);

        const response = await fetch('@Url.Action("SendClientMessage", "Home")', {
            method: "POST",
            credentials: "same-origin",
            headers: {
                "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
                "X-Requested-With": "XMLHttpRequest"
            },
            body: body.toString()
        });

        if (response.status === 401) {
            window.location.href = '@Url.Action("Login", "Account")';
            return;
        }

        const contentType = response.headers.get("content-type") || "";
        const raw = await response.text();

        if (!contentType.includes("application/json")) {
            console.error("Send message server response:", raw);
            alert("Server rejected the message request. Please refresh the page and try again.");
            return;
        }

        const data = JSON.parse(raw);

        if (!response.ok || !data.success) {
            alert(data.message || "Message could not be sent.");
            return;
        }

        input.value = "";

        // Render the newly sent message immediately.
        await loadChat();

        input.focus();

    } catch (error) {
        console.error("Client chat send error:", error);
        alert(error.message || "Unable to send the message.");
    } finally {
        send.disabled = false;
    }
}

let callState = {
    active: false,
    isCaller: false,
    peerId: 0,
    roomId: "",
    type: "",
    pc: null,
    localStream: null,
    remoteStream: null,
    pendingCandidates: [],
    pollTimer: null
};

async function sendCallSignal(signalType, payload) {
    if (!callState.peerId || !callState.roomId) return;

    const form = document.getElementById("clientChatForm");
    const token = form?.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

    const body = new URLSearchParams();
    body.set("__RequestVerificationToken", token);
    body.set("receiverId", String(callState.peerId));
    body.set("roomId", callState.roomId);
    body.set("callType", callState.type);
    body.set("signalType", signalType);
    body.set("payload", JSON.stringify(payload || {}));

    try {
        await fetch('@Url.Action("SendCallSignal", "Home")', {
            method: "POST",
            credentials: "same-origin",
            headers: {
                "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
                "X-Requested-With": "XMLHttpRequest"
            },
            body: body.toString()
        });
    } catch (error) {
        console.error("Call signal error:", error);
    }
}

function showCallPanel(type) {
    const panel = document.getElementById("callPanel");
    if (!panel) return;

    document.getElementById("callTitle").textContent =
        type === "video" ? "Video Call" : "Voice Call";

    document.getElementById("callSubtitle").textContent = currentTrainerName;
    document.getElementById("callName").textContent = currentTrainerName;
    document.getElementById("callStatus").textContent =
        callState.isCaller ? "Calling trainer..." : "Incoming call...";

    document.getElementById("callTrainerImage").src =
        currentTrainerImage || "/images/default-trainer.jpg";

    const remoteVideo = document.getElementById("callRemoteVideo");
    const localVideo = document.getElementById("callLocalVideo");
    const avatar = document.getElementById("callTrainerImage");

    remoteVideo.style.display = type === "video" ? "block" : "none";
    localVideo.style.display = type === "video" ? "block" : "none";
    avatar.style.display = type === "video" ? "none" : "block";

    panel.classList.add("show");
}

async function getLocalCallMedia(type) {
    if (callState.localStream) return;

    callState.localStream =
        await navigator.mediaDevices.getUserMedia({
            audio: true,
            video: type === "video"
        });

    const localVideo = document.getElementById("callLocalVideo");

    if (type === "video") {
        localVideo.srcObject = callState.localStream;
        localVideo.play().catch(() => {});
    }
}

async function createCallPeerConnection() {
    if (callState.pc) return callState.pc;

    callState.remoteStream = new MediaStream();

    const pc = new RTCPeerConnection({
        iceServers: [
            { urls: "stun:stun.l.google.com:19302" }
        ]
    });

    callState.pc = pc;

    callState.localStream?.getTracks().forEach(track => {
        pc.addTrack(track, callState.localStream);
    });

    pc.onicecandidate = function (event) {
        if (event.candidate) {
            sendCallSignal("ice", event.candidate.toJSON());
        }
    };

    pc.ontrack = function (event) {
        event.streams[0]?.getTracks().forEach(track => {
            callState.remoteStream.addTrack(track);
        });

        const remoteVideo = document.getElementById("callRemoteVideo");
        const remoteAudio = document.getElementById("callRemoteAudio");

        remoteVideo.srcObject = callState.remoteStream;
        remoteAudio.srcObject = callState.remoteStream;

        remoteVideo.play().catch(() => {});
        remoteAudio.play().catch(() => {});

        document.getElementById("callStatus").textContent = "Connected";
    };

    pc.onconnectionstatechange = function () {
        if (pc.connectionState === "failed") {
            document.getElementById("callStatus").textContent =
                "Call connection failed";
        }
    };

    return pc;
}

async function startTrainerCall(type) {
    if (!trainerId || callState.active) return;

    if (!navigator.mediaDevices?.getUserMedia) {
        alert("Camera and microphone are not available in this browser.");
        return;
    }

    callState = {
        active: true,
        isCaller: true,
        peerId: Number(trainerId),
        roomId:
            "ht-" +
            Date.now() +
            "-" +
            Math.random().toString(36).slice(2, 9),
        type: type,
        pc: null,
        localStream: null,
        remoteStream: null,
        pendingCandidates: [],
        pollTimer: callState.pollTimer
    };

    try {
        showCallPanel(type);

        await getLocalCallMedia(type);

        const pc = await createCallPeerConnection();

        const offer = await pc.createOffer();

        await pc.setLocalDescription(offer);

        await sendCallSignal("offer", {
            sdp: offer.sdp,
            type: offer.type
        });

        document.getElementById("callStatus").textContent =
            "Calling trainer...";
    } catch (error) {
        console.error(error);
        alert(
            "Unable to start the call. Please allow camera/microphone access."
        );
        await endTrainerCall(false);
    }
}

async function handleCallSignal(signal) {
    if (!signal) return;

    if (signal.signalType === "offer") {
        if (callState.active) return;

        if (Number(signal.senderId) !== Number(trainerId)) {
            return;
        }

        let offer;

        try {
            offer = JSON.parse(signal.payload || "{}");
        } catch {
            return;
        }

        callState = {
            active: true,
            isCaller: false,
            peerId: Number(signal.senderId),
            roomId: signal.roomId,
            type: signal.callType === "video" ? "video" : "voice",
            pc: null,
            localStream: null,
            remoteStream: null,
            pendingCandidates: [],
            pollTimer: callState.pollTimer
        };

        try {
            showCallPanel(callState.type);

            await getLocalCallMedia(callState.type);

            const pc = await createCallPeerConnection();

            await pc.setRemoteDescription(
                new RTCSessionDescription(offer)
            );

            const answer = await pc.createAnswer();

            await pc.setLocalDescription(answer);

            await sendCallSignal("answer", {
                sdp: answer.sdp,
                type: answer.type
            });

            document.getElementById("callStatus").textContent =
                "Connecting...";
        } catch (error) {
            console.error(error);
            alert(
                "Unable to answer the call. Please allow camera/microphone access."
            );
            await endTrainerCall(false);
        }

        return;
    }

    if (
        !callState.active ||
        Number(signal.senderId) !== Number(callState.peerId) ||
        signal.roomId !== callState.roomId
    ) {
        return;
    }

    if (signal.signalType === "answer") {
        let answer;

        try {
            answer = JSON.parse(signal.payload || "{}");
        } catch {
            return;
        }

        if (
            callState.pc &&
            !callState.pc.remoteDescription
        ) {
            await callState.pc.setRemoteDescription(
                new RTCSessionDescription(answer)
            );

            for (const candidate of callState.pendingCandidates) {
                await callState.pc
                    .addIceCandidate(candidate)
                    .catch(() => {});
            }

            callState.pendingCandidates = [];
        }
    }

    if (signal.signalType === "ice") {
        let candidate;

        try {
            candidate = JSON.parse(signal.payload || "{}");
        } catch {
            return;
        }

        if (
            callState.pc &&
            callState.pc.remoteDescription
        ) {
            await callState.pc
                .addIceCandidate(candidate)
                .catch(() => {});
        } else {
            callState.pendingCandidates.push(candidate);
        }
    }

    if (signal.signalType === "hangup") {
        await endTrainerCall(false);
    }
}

async function pollCallSignals() {
    try {
        const response = await fetch(
            '@Url.Action("GetCallSignals", "Home")',
            {
                credentials: "same-origin",
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            }
        );

        if (response.ok) {
            const data = await response.json();

            for (const signal of data.signals || []) {
                await handleCallSignal(signal);
            }
        }
    } catch (error) {
        console.error("Call polling error:", error);
    }

    callState.pollTimer =
        setTimeout(pollCallSignals, 700);
}

async function endTrainerCall(sendHangup = true) {
    if (
        sendHangup &&
        callState.active &&
        callState.peerId
    ) {
        await sendCallSignal("hangup", {});
    }

    callState.pc?.close();

    callState.localStream?.getTracks().forEach(track => {
        track.stop();
    });

    ["callRemoteVideo", "callLocalVideo", "callRemoteAudio"]
        .forEach(id => {
            const element = document.getElementById(id);

            if (element) {
                element.srcObject = null;
            }
        });

    document
        .getElementById("callPanel")
        ?.classList.remove("show");

    callState.active = false;
    callState.isCaller = false;
    callState.peerId = 0;
    callState.roomId = "";
    callState.type = "";
    callState.pc = null;
    callState.localStream = null;
    callState.remoteStream = null;
    callState.pendingCandidates = [];
}

function toggleCallMute(button) {
    if (callState.localStream) {
        callState.localStream
            .getAudioTracks()
            .forEach(track => {
                track.enabled = !track.enabled;
            });

        const muted =
            callState.localStream
                .getAudioTracks()
                .some(track => !track.enabled);

        button.classList.toggle("active", muted);

        const icon = button.querySelector("i");

        if (icon) {
            icon.className = muted
                ? "fa-solid fa-microphone-slash"
                : "fa-solid fa-microphone";
        }

        return;
    }

    button.classList.toggle("active");
}

function toggleCallCamera(button) {
    if (callState.localStream) {
        callState.localStream
            .getVideoTracks()
            .forEach(track => {
                track.enabled = !track.enabled;
            });

        const off =
            callState.localStream
                .getVideoTracks()
                .some(track => !track.enabled);

        button.classList.toggle("active", off);

        const icon = button.querySelector("i");

        if (icon) {
            icon.className = off
                ? "fa-solid fa-video-slash"
                : "fa-solid fa-video";
        }

        return;
    }

    button.classList.toggle("active");
}

document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("clientChatForm");
    if (form) form.addEventListener("submit", sendMessage);

    const input = document.getElementById("messageInput");
    if (input) {
        input.addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                if (form) form.requestSubmit();
            }
        });
    }

    const attachment = document.getElementById("chatAttachment");

    if (attachment) {
        attachment.addEventListener("change", async function () {
            if (!this.files || !this.files.length || !trainerId) return;

            const form = document.getElementById("clientChatForm");
            const token =
                form?.querySelector(
                    'input[name="__RequestVerificationToken"]'
                )?.value || "";

            const formData = new FormData();

            formData.append(
                "__RequestVerificationToken",
                token
            );

            formData.append(
                "receiverId",
                String(trainerId)
            );

            formData.append(
                "file",
                this.files[0]
            );

            try {
                const response = await fetch(
                    '@Url.Action("UploadChatAttachment", "Home")',
                    {
                        method: "POST",
                        credentials: "same-origin",
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        body: formData
                    }
                );

                const data = await response.json();

                if (!response.ok || !data.success) {
                    alert(
                        data.message ||
                        "Unable to upload the attachment."
                    );

                    return;
                }

                await loadChat();
            } catch (error) {
                console.error(error);

                alert(
                    "Unable to upload the attachment."
                );
            } finally {
                this.value = "";
            }
        });
    }

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") endTrainerCall();
    });

    loadChat();
    pollCallSignals();
});
</script>

</body>
</html>
