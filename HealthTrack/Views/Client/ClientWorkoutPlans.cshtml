    }

    .activity-item {
        min-height: 48px;
        display: flex;
        align-items: center;
        border-top: 1px solid rgba(255,255,255,0.06);
    }

    .activity-icon {
        width: 31px;
        height: 31px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        color: #ffffff;
        background: #18A957;
        font-size: 12px;
    }

        .activity-icon.green {
            background: #20a968;
        }

        .activity-icon.purple {
            background: #7a43dd;
        }

        .activity-icon.orange {
            background: #f28c1b;
        }

    .activity-name {
        width: 25%;
        margin-left: 11px;
        color: #ffffff;
        font-size: 11px;
        font-weight: 600;
    }

    .activity-detail {
        flex: 1;
        color: #8d929a;
        font-size: 10px;
    }

    .activity-time {
        color: #8d929a;
        font-size: 10px;
    }

    /* ============================================================
           RESPONSIVE
           ============================================================ */

    @@media (max-width: 1200px) {

        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .dashboard-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

            .dashboard-grid .dashboard-card:last-child {
                grid-column: span 2;
            }
    }

    @@media (max-width: 900px) {

        .client-sidebar {
            transform: translateX(-100%);
            transition: 0.25s ease;
        }

            .client-sidebar.open {
                transform: translateX(0);
            }

        .client-main {
            margin-left: 0;
        }

        .mobile-menu-btn {
            display: flex;
            margin-right: 12px;
        }

        .search-box {
            width: 250px;
        }
    }

    @@media (max-width: 700px) {

        .dashboard-content {
            padding: 18px 15px 25px;
        }

        .welcome-row {
            flex-direction: column;
        }

        .today-card {
            width: 100%;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }

            .dashboard-grid .dashboard-card:last-child {
                grid-column: span 1;
            }

        .top-profile-text {
            display: none;
        }

        .search-box {
            flex: 1;
            width: auto;
        }

        .hero-banner {
            padding: 25px;
        }

        .hero-title {
            font-size: 22px;
        }

        .activity-name {
            width: 32%;
        }
    }

    @@media (max-width: 480px) {

        .client-topbar {
            padding: 0 12px;
        }

        .topbar-right {
            gap: 8px;
        }

        .search-box {
            display: none;
        }

        .welcome-title {
            font-size: 23px;
        }

        .trainer-box {
            align-items: flex-start;
        }

        .trainer-image {
            width: 70px;
            height: 70px;
        }

        .activity-detail {
            display: none;
        }

        .activity-name {
            flex: 1;
            width: auto;
        }
    }



    .page-content{padding:30px;min-height:calc(100vh - 76px);}
    .page-heading-row{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px;}
    .page-title{margin:0;font-size:26px;font-weight:800;color:#fff;}
    .page-subtitle{margin:7px 0 0;color:#8fa1ad;font-size:13px;}
    .page-count{min-width:100px;padding:12px 16px;border-radius:12px;background:rgba(24,169,87,.10);border:1px solid rgba(24,169,87,.22);text-align:center;}
    .page-count strong{display:block;color:#20c978;font-size:20px;line-height:1.1;}
    .page-count span{display:block;margin-top:4px;color:#91a1ac;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;}
    .content-card{background:linear-gradient(145deg,rgba(19,24,29,.98),rgba(11,14,18,.98));border:1px solid rgba(255,255,255,.07);border-radius:16px;box-shadow:0 12px 35px rgba(0,0,0,.20);overflow:hidden;}
    .content-card-header{padding:18px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid rgba(255,255,255,.06);}
    .content-card-title{display:flex;align-items:center;gap:10px;color:#fff;font-size:14px;font-weight:800;}
    .content-card-title i{color:#20c978;}
    .empty-state{padding:55px 20px;text-align:center;color:#71818c;}
    .empty-state i{display:block;font-size:34px;margin-bottom:13px;color:#20c978;}
    .empty-state h3{margin:0 0 7px;color:#dce7ed;font-size:16px;}
    .empty-state p{margin:0;font-size:12px;}
    .data-list{display:flex;flex-direction:column;}
    .data-row{display:grid;grid-template-columns:1.2fr 1fr 1fr 120px;gap:16px;align-items:center;padding:16px 20px;border-bottom:1px solid rgba(255,255,255,.05);}
    .data-row:last-child{border-bottom:0;}
    .data-primary{color:#fff;font-size:13px;font-weight:750;}
    .data-secondary{color:#8797a2;font-size:11px;margin-top:4px;line-height:1.4;}
    .data-label{display:block;color:#657680;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;}
    .status-pill{display:inline-flex;align-items:center;justify-content:center;min-width:72px;padding:5px 9px;border-radius:999px;font-size:9px;font-weight:800;background:rgba(32,201,120,.10);color:#20c978;border:1px solid rgba(32,201,120,.20);}
    .status-pill.pending{color:#f2b94b;background:rgba(242,185,75,.10);border-color:rgba(242,185,75,.20);}
    .status-pill.cancelled{color:#ff7373;background:rgba(255,115,115,.10);border-color:rgba(255,115,115,.20);}
    .status-pill.completed{color:#73b7ff;background:rgba(115,183,255,.10);border-color:rgba(115,183,255,.20);}
    .plan-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;}
    .plan-card{padding:20px;background:linear-gradient(145deg,#141a1f,#0d1115);border:1px solid rgba(255,255,255,.06);border-radius:15px;}
    .view-plan-btn{margin-top:15px;width:100%;display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:10px 14px;border:1px solid rgba(32,201,120,.28);border-radius:10px;background:rgba(32,201,120,.10);color:#20c978;text-decoration:none;font-size:10px;font-weight:800;transition:.2s ease;}
    .view-plan-btn:hover{background:rgba(32,201,120,.18);color:#20c978;transform:translateY(-1px);}

    .plan-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:14px;}
    .plan-name{color:#fff;font-size:15px;font-weight:800;}
    .plan-trainer{color:#81919b;font-size:10px;margin-top:5px;}
    .plan-description{color:#9aaab4;font-size:11px;line-height:1.6;min-height:36px;}
    .plan-dates{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:15px;padding-top:13px;border-top:1px solid rgba(255,255,255,.05);}
    .metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:18px;}
    .metric-card{padding:18px;background:linear-gradient(145deg,#141a1f,#0d1115);border:1px solid rgba(255,255,255,.06);border-radius:14px;}
    .metric-label{color:#758691;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;}
    .metric-value{margin-top:8px;color:#fff;font-size:22px;font-weight:800;}
    .metric-value small{color:#71828d;font-size:10px;font-weight:700;}
    .notification-row{display:flex;gap:14px;padding:17px 20px;border-bottom:1px solid rgba(255,255,255,.05);}
    .notification-row:last-child{border-bottom:0;}
    .notification-dot{flex:0 0 38px;width:38px;height:38px;display:flex;align-items:center;justify-content:center;border-radius:11px;background:rgba(32,201,120,.10);color:#20c978;}
    .notification-row.unread{background:rgba(32,201,120,.035);}
    .notification-title{color:#fff;font-size:13px;font-weight:800;}
    .notification-message{color:#91a1ab;font-size:11px;line-height:1.5;margin-top:4px;}
    .notification-time{color:#5f707b;font-size:9px;margin-top:7px;}
    .page-action{display:inline-flex;align-items:center;gap:7px;padding:9px 13px;border-radius:9px;border:1px solid rgba(32,201,120,.22);background:rgba(32,201,120,.08);color:#20c978;font-size:10px;font-weight:800;text-decoration:none;cursor:pointer;}
    .page-action:hover{background:rgba(32,201,120,.15);color:#fff;}
    @@media(max-width:1000px){.data-row{grid-template-columns:1fr 1fr}.plan-grid{grid-template-columns:1fr}.metric-grid{grid-template-columns:repeat(2,1fr)}}
    @@media(max-width:650px){.page-content{padding:20px 14px}.page-heading-row{flex-direction:column}.data-row{grid-template-columns:1fr;gap:9px}.metric-grid{grid-template-columns:1fr 1fr}}

</style>

<div class="client-layout">
<aside class="client-sidebar" id="clientSidebar">

        <!-- EXACT HEALTH TRACK BRAND -->
        <div class="healthtrack-logo">

            <div class="healthtrack-logo-symbol">
                <i class="fa-solid fa-dumbbell"></i>
            </div>

            <div class="healthtrack-logo-text">
                Health<span>Track</span>
            </div>

        </div>

        <!-- PROFILE -->
        <div class="client-profile">

            <img src="@profileImage"
                 class="client-profile-image"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

            <div style="
                display:none;
                width:45px;
                height:45px;
                border-radius:50%;
                background:#18A957;
                color:#fff;
                align-items:center;
                justify-content:center;
                font-weight:800;">
                @clientInitial
            </div>

            <div class="client-profile-info">

                <div class="client-profile-name">
                    @clientName
                </div>

                <div class="client-profile-role">
                    Client
                </div>

            </div>

        </div>

        <div class="menu-title">
            MAIN MENU
        </div>

        <!-- MENU -->
        <nav class="client-menu">

            <a href="@Url.Action("ClientDashboard", "Home")"
               class="client-menu-item">

                <i class="fa-solid fa-house"></i>

                <span>Dashboard</span>

            </a>


            <a href="@Url.Action("ClientAppointments", "Home")"
               class="client-menu-item">

                <i class="fa-regular fa-calendar"></i>

                <span>Appointments</span>

            </a>

            <a href="@Url.Action("ClientWorkoutPlans", "Home")"
               class="client-menu-item active">

                <i class="fa-solid fa-dumbbell"></i>

                <span>Workout Plan</span>

            </a>

            <a href="@Url.Action("ClientDietPlans", "Home")"
               class="client-menu-item">

                <i class="fa-solid fa-utensils"></i>

                <span>Diet Plan</span>

            </a>

            <a href="@Url.Action("ClientProgress", "Home")"
               class="client-menu-item">

                <i class="fa-solid fa-chart-line"></i>

                <span>Progress</span>

            </a>

            <a href="@Url.Action("Messages", "Home")"
               class="client-menu-item">

                <i class="fa-regular fa-comment"></i>

                <span>Messages</span>

            </a>

            <a href="@Url.Action("ClientNotifications", "Home")"
               class="client-menu-item">

                <i class="fa-regular fa-bell"></i>

                <span>Notifications</span>

                <span class="notification-count">
                    3
                </span>

            </a>

            <a href="@Url.Action("Logout", "Home")"
               class="client-menu-item">

                <i class="fa-solid fa-right-from-bracket"></i>

                <span>Logout</span>

            </a>

        </nav>

        <!-- SIDEBAR BOTTOM -->
        <div class="sidebar-bottom">

            <div class="sidebar-bottom-title">

                STRONGER PEOPLE

                <span>
                    HEALTHIER TOMORROW
                </span>

            </div>

            <div class="sidebar-line"></div>

        </div>

    </aside>


    <!-- ========================================================
         MAIN
         ======================================================== -->

    

<header class="client-topbar">

            <button class="mobile-menu-btn"
                    type="button"
                    onclick="toggleClientSidebar()">

                <i class="fa-solid fa-bars"></i>

            </button>

            <div class="search-box">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input type="text"
                       placeholder="Search here..." />

            </div>

            <div class="topbar-right">

                <a href="@Url.Action("ClientNotifications", "Home")"
                   class="notification-icon">

                    <i class="fa-regular fa-bell"></i>

                    <span class="notification-badge">
                        @(ViewBag.UnreadNotifications ?? 0)
                    </span>

                </a>

                <div class="top-profile">

                    <img src="@profileImage"
                         class="top-profile-image"
                         onerror="this.src='/images/default-user.png';" />

                    <div class="top-profile-text">

                        <div class="top-profile-name">
                            @clientName
                        </div>

                        <div class="top-profile-role">
                            Client
                        </div>

                    </div>

                    <i class="fa-solid fa-chevron-down"></i>

                </div>

            </div>

        </header>

<main class="client-main">
<section class="page-content">
<div class="page-heading-row"><div><h1 class="page-title">Workout Plan</h1><p class="page-subtitle">Your trainer-assigned workout plans and schedules.</p></div><div class="page-count"><strong>@(ViewBag.TotalWorkoutPlans ?? 0)</strong><span>Total Plans</span></div></div>
@{ var plans=ViewBag.WorkoutPlans as IEnumerable<WorkoutPlan> ?? Enumerable.Empty<WorkoutPlan>(); }
@if(plans.Any()){<div class="plan-grid">@foreach(var plan in plans){var status=plan.Status??"Active";var statusClass=status.Equals("Completed",StringComparison.OrdinalIgnoreCase)?"completed":status.Equals("Pending",StringComparison.OrdinalIgnoreCase)?"pending":status.Equals("Cancelled",StringComparison.OrdinalIgnoreCase)?"cancelled":"";
<div class="plan-card"><div class="plan-top"><div><div class="plan-name">@plan.PlanName</div><div class="plan-trainer">Trainer: @(plan.Trainer?.FullName??"Trainer")</div></div><span class="status-pill @statusClass">@status</span></div><div class="plan-description">@(string.IsNullOrWhiteSpace(plan.Description)?"No description provided.":plan.Description)</div><div class="plan-dates"><div><span class="data-label">Start Date</span><div class="data-primary">@plan.StartDate.ToString("dd MMM yyyy")</div></div><div><span class="data-label">End Date</span><div class="data-primary">@(plan.EndDate?.ToString("dd MMM yyyy")??"Ongoing")</div></div></div><a class="view-plan-btn" href="@Url.Action("ViewWorkoutPlan", "Home", new { id = plan.WorkoutPlanId })"><i class="fa-solid fa-eye"></i>View Plan</a></div>
}</div>}else{<div class="content-card"><div class="empty-state"><i class="fa-solid fa-dumbbell"></i><h3>No Workout Plans</h3><p>Your trainer has not assigned a workout plan yet.</p></div></div>}
</section>
</main>
</div>

<script>
function toggleClientSidebar() {
    const sidebar = document.getElementById("clientSidebar");
    if (sidebar) sidebar.classList.toggle("open");
}
</script>
