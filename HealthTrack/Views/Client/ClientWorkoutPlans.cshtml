@using System
@using System.Linq
@using HealthTrack.Models

@{
    Layout = null;
    ViewData["Title"] = "Workout Plan";

    var clientName = ViewBag.ClientName as string;
    if (string.IsNullOrWhiteSpace(clientName))
        clientName = User?.Identity?.Name;
    if (string.IsNullOrWhiteSpace(clientName))
        clientName = "Client";
    if (clientName.Contains("@"))
        clientName = clientName.Split('@')[0];

    var clientInitial = !string.IsNullOrWhiteSpace(clientName)
        ? clientName.Substring(0, 1).ToUpper()
        : "C";

    var profileImage = ViewBag.ProfileImage as string;
    if (string.IsNullOrWhiteSpace(profileImage))
        profileImage = "/images/default-user.png";
    else
    {
        profileImage = profileImage.Trim();
        if (!profileImage.StartsWith("/images/", StringComparison.OrdinalIgnoreCase))
            profileImage = "/images/" + profileImage.TrimStart('/');
    }

    var unreadNotifications = ViewBag.UnreadNotifications ?? 0;
}
<style>


    /* ============================================================
           GLOBAL
           ============================================================ */

    * {
        box-sizing: border-box;
    }

    html,
