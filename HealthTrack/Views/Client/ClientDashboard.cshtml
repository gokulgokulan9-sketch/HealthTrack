        display: flex;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

        .message-item:last-child {
            border-bottom: none;
        }

    .message-avatar {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        object-fit: cover;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.12);
    }

    .message-info {
        margin-left: 9px;
        min-width: 0;
        flex: 1;
    }

    .message-name {
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
    }

    .message-preview {
        margin-top: 3px;
        color: #838890;
        font-size: 9px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .message-time {
        color: #8a8f97;
        font-size: 9px;
    }

    .message-unread {
        width: 17px;
        height: 17px;
        margin-left: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #18A957;
        color: #ffffff;
        font-size: 8px;
        font-weight: 700;
    }

    /* ============================================================
           RECENT ACTIVITY
           ============================================================ */

    .activity-card {
        margin-bottom: 0;
    }

    .activity-list {
        display: flex;
        flex-direction: column;
    }

    .activity-item {
        min-height: 48px;
        display: flex;
        align-items: center;
        border-top: 1px solid rgba(255,255,255,0.06);
    }

    .activity-icon {
        width: 31px;
        height: 31px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        color: #ffffff;
        background: #18A957;
        font-size: 12px;
    }

        .activity-icon.green {
            background: #20a968;
        }

        .activity-icon.purple {
            background: #7a43dd;
        }

        .activity-icon.orange {
            background: #f28c1b;
        }

    .activity-name {
        width: 25%;
        margin-left: 11px;
        color: #ffffff;
        font-size: 11px;
        font-weight: 600;
    }

    .activity-detail {
        flex: 1;
        color: #8d929a;
        font-size: 10px;
    }

    .activity-time {
        color: #8d929a;
        font-size: 10px;
    }

    /* ============================================================
           RESPONSIVE
           ============================================================ */

    @@media (max-width: 1200px) {

        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .dashboard-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

            .dashboard-grid .dashboard-card:last-child {
                grid-column: span 2;
            }
    }

    @@media (max-width: 900px) {

        .client-sidebar {
            transform: translateX(-100%);
            transition: 0.25s ease;
        }

            .client-sidebar.open {
                transform: translateX(0);
            }

        .client-main {
            margin-left: 0;
        }

        .mobile-menu-btn {
            display: flex;
            margin-right: 12px;
        }

        .search-box {
            width: 250px;
        }
    }

    @@media (max-width: 700px) {

        .dashboard-content {
            padding: 18px 15px 25px;
        }

        .welcome-row {
            flex-direction: column;
        }

        .today-card {
            width: 100%;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }

            .dashboard-grid .dashboard-card:last-child {
                grid-column: span 1;
            }

        .top-profile-text {
            display: none;
        }

        .search-box {
            flex: 1;
            width: auto;
        }

        .hero-banner {
            padding: 25px;
        }

        .hero-title {
            font-size: 22px;
        }

        .activity-name {
            width: 32%;
        }
    }

    @@media (max-width: 480px) {

        .client-topbar {
            padding: 0 12px;
        }

        .topbar-right {
            gap: 8px;
        }

        .search-box {
            display: none;
        }

        .welcome-title {
            font-size: 23px;
        }

        .trainer-box {
            align-items: flex-start;
        }

        .trainer-image {
            width: 70px;
            height: 70px;
        }

        .activity-detail {
            display: none;
        }

        .activity-name {
            flex: 1;
            width: auto;
        }
    }

</style>

