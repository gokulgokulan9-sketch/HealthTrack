@using System

@{
    Layout = null;
    ViewData["Title"] = "Client Dashboard";

    // ============================================================
    // CLIENT INFORMATION
    // ============================================================

    var clientName = ViewBag.ClientName as string;

    if (string.IsNullOrWhiteSpace(clientName))
    {
        clientName = User?.Identity?.Name;
    }

    if (string.IsNullOrWhiteSpace(clientName))
    {
        clientName = "Client";
    }

    if (clientName.Contains("@"))
    {
        clientName = clientName.Split('@')[0];
    }

    var clientInitial =
        !string.IsNullOrWhiteSpace(clientName)
            ? clientName.Substring(0, 1).ToUpper()
            : "C";

    // ============================================================
    // PROFILE IMAGE
    // ============================================================

    var profileImage = ViewBag.ProfileImage as string;

    // Database stores only the filename (example: user2.jpg).
    // Convert it to the real static-files path.
    if (string.IsNullOrWhiteSpace(profileImage))
    {
        profileImage = "/images/default-user.png";
    }
    else
    {
        profileImage = profileImage.Trim();

        if (!profileImage.StartsWith("/images/", StringComparison.OrdinalIgnoreCase))
        {
            profileImage = "/images/" + profileImage.TrimStart('/');
        }
    }

    // ============================================================
    // TRAINER
    // ============================================================

    var trainerName = ViewBag.TrainerName as string;

    if (string.IsNullOrWhiteSpace(trainerName))
    {
        trainerName = "Nimal Perera";
    }

    var trainerImage = ViewBag.TrainerImage as string;

    if (string.IsNullOrWhiteSpace(trainerImage))
    {
        trainerImage = "/images/default-trainer.jpg";
    }

    // ============================================================
    // DASHBOARD COUNTS
    // ============================================================

    var activeWorkoutPlans = ViewBag.ActiveWorkoutPlans ?? 2;
    var activeDietPlans = ViewBag.ActiveDietPlans ?? 2;
    var upcomingAppointments = ViewBag.UpcomingAppointments ?? 1;
    var overallProgress = ViewBag.OverallProgress ?? 68;

    // ============================================================
    // DATE
    // ============================================================

    var today = DateTime.Now;
    var dayName = today.ToString("dddd");
    var fullDate = today.ToString("MMMM dd, yyyy");
}

