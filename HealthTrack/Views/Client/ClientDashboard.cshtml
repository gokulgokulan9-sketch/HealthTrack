</style>

<div id="clientChatOverlay" class="client-chat-overlay" onclick="clientChatOverlayClick(event)">
    <div class="client-chat-box" onclick="event.stopPropagation();">

        <div class="client-chat-header">
            <img id="clientChatTrainerImage"
                 src="@trainerImage"
                 alt="Trainer"
                 onerror="this.src='/images/default-trainer.jpg';" />

            <div class="client-chat-header-info">
                <div id="clientChatTrainerName" class="client-chat-header-name">
                    @trainerName
                </div>
                <div class="client-chat-header-status">
                    Fitness Trainer
                </div>
            </div>

            <button type="button"
                    class="client-chat-close"
                    onclick="closeClientChat()"
                    aria-label="Close">
                &times;
            </button>
        </div>

        <div id="clientChatMessages" class="client-chat-messages">
            <div class="client-chat-empty">
                Loading conversation...
            </div>
        </div>

        <div class="client-chat-compose">
            <form id="clientChatForm" class="client-chat-form">
                @Html.AntiForgeryToken()
                <textarea id="clientChatInput"
                          class="client-chat-input"
                          placeholder="Type a message..."
                          maxlength="2000"
                          rows="1"></textarea>

                <button id="clientChatSend"
                        type="submit"
                        class="client-chat-send"
                        title="Send">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </form>
        </div>

    </div>
</div>

<script>
/* ============================================================
   CLIENT - TRAINER CHAT
   ============================================================ */

let clientChatTrainerId = 0;
let clientChatLoading = false;

function openClientChat() {
    const overlay = document.getElementById("clientChatOverlay");
    if (!overlay) return;

    overlay.classList.add("show");
    document.body.style.overflow = "hidden";

    loadClientChat();
}

function closeClientChat() {
    const overlay = document.getElementById("clientChatOverlay");
    if (overlay) {
        overlay.classList.remove("show");
    }

    document.body.style.overflow = "";
}

function clientChatOverlayClick(event) {
    if (event.target && event.target.id === "clientChatOverlay") {
        closeClientChat();
    }
}

async function loadClientChat() {
    if (clientChatLoading) return;

    const container = document.getElementById("clientChatMessages");
    if (!container) return;

    clientChatLoading = true;
    container.innerHTML =
        '<div class="client-chat-empty">Loading conversation...</div>';

    try {
        const response = await fetch('@Url.Action("ClientChatHistory", "Home")', {
            method: "GET",
            credentials: "same-origin",
            headers: {
                "X-Requested-With": "XMLHttpRequest"
            }
        });

        if (response.status === 401) {
            window.location.href = '@Url.Action("Login", "Account")';
            return;
        }

        const data = await response.json();

        if (!response.ok || !data.success) {
            container.innerHTML =
                '<div class="client-chat-error">' +
                escapeClientChatHtml(data.message || "Unable to load chat.") +
                '</div>';
            return;
        }

        if (!data.hasTrainer || !data.trainerId) {
            clientChatTrainerId = 0;
            container.innerHTML =
                '<div class="client-chat-empty">' +
                'No trainer is currently assigned to you.' +
                '</div>';
            return;
        }

        clientChatTrainerId = Number(data.trainerId);

        const nameElement = document.getElementById("clientChatTrainerName");
        const imageElement = document.getElementById("clientChatTrainerImage");

        if (nameElement) {
            nameElement.textContent = data.trainerName || "Trainer";
        }

        if (imageElement) {
            imageElement.src =
                data.trainerImage || "/images/default-trainer.jpg";
        }

        renderClientChatMessages(data.messages || []);

    } catch (error) {
        console.error("Client chat load error:", error);

        container.innerHTML =
            '<div class="client-chat-error">' +
            'Unable to connect to the chat.' +
            '</div>';
    } finally {
        clientChatLoading = false;
    }
}

function renderClientChatMessages(messages) {
    const container = document.getElementById("clientChatMessages");
    if (!container) return;

    if (!messages || messages.length === 0) {
        container.innerHTML =
            '<div class="client-chat-empty">' +
            'No messages yet. Start the conversation.' +
            '</div>';
        return;
    }

    container.innerHTML = "";

    messages.forEach(function (item) {
    const row = document.createElement("div");

    row.className =
        "client-chat-row " +
        (item.isClient ? "mine" : "theirs");

    const bubble = document.createElement("div");
    bubble.className = "client-chat-bubble";

    const messageText = document.createElement("div");

    messageText.textContent =
        item.messageText || "";

    const time = document.createElement("span");

    time.className = "client-chat-time";

    time.textContent =
        item.sentAt || "";

    bubble.appendChild(messageText);
    bubble.appendChild(time);

    row.appendChild(bubble);

    container.appendChild(row);
});

    container.scrollTop = container.scrollHeight;
}

async function sendClientChatMessage(event) {
    event.preventDefault();

    const input = document.getElementById("clientChatInput");
    const sendButton = document.getElementById("clientChatSend");

    if (!input || !sendButton) return;

    const message = input.value.trim();

    if (!message) {
        input.focus();
        return;
    }

    if (!clientChatTrainerId) {
        await loadClientChat();
        return;
    }

    const form = document.getElementById("clientChatForm");

    if (!form) {
        alert("Chat form is not available. Please refresh the page.");
        return;
    }

    sendButton.disabled = true;

    try {
        const body = new URLSearchParams(new FormData(form));

        body.set("receiverId", String(clientChatTrainerId));
        body.set("message", message);

        const response = await fetch(
            '@Url.Action("SendClientMessage", "Home")',
            {
                method: "POST",
                credentials: "same-origin",
                headers: {
                    "Content-Type":
                        "application/x-www-form-urlencoded; charset=UTF-8",
                    "X-Requested-With": "XMLHttpRequest"
                },
                body: body.toString()
            }
        );

        if (response.status === 401) {
            window.location.href = '@Url.Action("Login", "Account")';
            return;
        }

        const contentType = response.headers.get("content-type") || "";
        const raw = await response.text();

        if (!contentType.includes("application/json")) {
            console.error("Send message server response:", raw);
            alert("Server rejected the message request. Please refresh the page and try again.");
            return;
        }

        const data = JSON.parse(raw);

        if (!response.ok || !data.success) {
            alert(data.message || "Message could not be sent.");
            return;
        }

        input.value = "";
        await loadClientChat();
        input.focus();

    } catch (error) {
        console.error("Client chat send error:", error);
        alert(error.message || "Unable to send the message.");
    } finally {
        sendButton.disabled = false;
    }
}

function escapeClientChatHtml(value) {
    const div = document.createElement("div");
    div.textContent = value == null ? "" : String(value);
    return div.innerHTML;
}

document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("clientChatForm");

    if (form) {
        form.addEventListener("submit", sendClientChatMessage);
    }

    const input = document.getElementById("clientChatInput");

    if (input) {
        input.addEventListener("keydown", function (event) {
            if (event.key === "Enter" && !event.shiftKey) {
                event.preventDefault();

                if (form) {
                    form.requestSubmit();
                }
            }
        });
    }

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            closeClientChat();
        }
    });
});



    function toggleClientSidebar() {

        const sidebar =
            document.getElementById("clientSidebar");

        if (sidebar) {
            sidebar.classList.toggle("open");
        }

    }
</script>
