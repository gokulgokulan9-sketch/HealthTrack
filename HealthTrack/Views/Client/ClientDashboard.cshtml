    }

    .message-unread {
        width: 17px;
        height: 17px;
        margin-left: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #ef233c;
        color: #ffffff;
        font-size: 8px;
        font-weight: 700;
