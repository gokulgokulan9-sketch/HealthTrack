<script>

    function toggleClientSidebar() {

        const sidebar =
            document.getElementById("clientSidebar");

        if (sidebar) {
            sidebar.classList.toggle("open");
        }

    }
    /* ============================================================
    FIX TOP WHITE SPACE / LAYOUT OFFSET
    ============================================================ */

    /* Remove any default spacing from the page */
    html,
        body {
        margin: 0!important;
        padding: 0!important;
    }

    /* Force the HealthTrack dashboard to start from the very top */
    .client - layout {
        margin: 0!important;
        padding: 0!important;
        position: relative!important;
        top: 0!important;
    }

    /* Override any global main element spacing */
    main.client - main {
        margin - top: 0!important;
        padding - top: 0!important;
        position: relative!important;
        top: 0!important;
    }

    /* Top bar must touch the top of dashboard */
    .client - topbar {
        margin - top: 0!important;
        padding - top: 0!important;
    }

    /* Dashboard content */
    .dashboard - content {
        margin - top: 0!important;
        padding - top: 20px!important;
    }

    /* Sidebar remains fixed at the very top */
    .client - sidebar {
        top: 0!important;
        margin - top: 0!important;
    }

    /* Remove spacing from common global layout wrappers */
    main,
    .main,
