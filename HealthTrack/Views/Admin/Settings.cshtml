@{
    ViewData["Title"] = "Settings";

    string adminName =
        ViewBag.AdminName ??
        ViewBag.UserName ??
        "Admin";

    string adminEmail =
        ViewBag.AdminEmail ??
        ViewBag.UserEmail ??
        "";

    string adminRole =
        ViewBag.AdminRole ??
        ViewBag.UserRole ??
        "ADMIN";

    string adminImage =
        ViewBag.AdminProfileImage ??
        ViewBag.ProfileImage ??
        "/images/default-user.png";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>HealthTrack - Settings</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #0f1115;
            color: #f4f6f8;
            font-family: Arial, Helvetica, sans-serif;
        }

        .admin-sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: 250px;
            background: #15181d;
            border-right: 1px solid rgba(255,255,255,.07);
            z-index: 1000;
            overflow-y: auto;
        }

        .logo-area {
            height: 82px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 25px;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #32d58c;
            color: #0d1712;
            font-size: 18px;
        }

        .logo-text {
            font-size: 21px;
            font-weight: 800;
            color: white;
        }

        .logo-text span {
            color: #32d58c;
        }

        .admin-profile {
            padding: 22px 18px;
        }

        .profile-box {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 13px;
            border-radius: 14px;
            background: #1c2027;
        }

        .profile-image,
        .profile-letter {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            object-fit: cover;
        }

        .profile-letter {
            display: flex;
            align-items: center;
            justify-content: center;
            background: #32d58c;
            color: #0c1711;
            font-weight: 800;
        }

        .profile-name {
            font-size: 13px;
            font-weight: 700;
            color: #fff;
        }

        .profile-role {
            margin-top: 4px;
            font-size: 10px;
            color: #32d58c;
            font-weight: 700;
            letter-spacing: .7px;
        }

        .menu-title {
            padding: 0 22px 10px;
            color: #6f7884;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
        }

        .sidebar-menu {
            padding: 0 12px;
        }

        .sidebar-menu a,
        .sidebar-bottom a {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 12px 14px;
            margin-bottom: 4px;
            color: #aeb5be;
            text-decoration: none;
            border-radius: 9px;
            font-size: 13px;
            transition: .2s;
        }

        .sidebar-menu a:hover,
        .sidebar-menu a.active {
            background: rgba(50,213,140,.10);
            color: #32d58c;
        }

        .sidebar-menu i {
            width: 19px;
            text-align: center;
        }

        .sidebar-bottom {
            padding: 15px 12px 25px;
        }

        .sidebar-divider {
            height: 1px;
            background: rgba(255,255,255,.07);
            margin-bottom: 12px;
        }

        .sidebar-bottom a:hover {
            background: rgba(255,255,255,.05);
            color: white;
        }

        .admin-topbar {
            position: fixed;
            left: 250px;
            right: 0;
            top: 0;
            height: 82px;
            background: #15181d;
            border-bottom: 1px solid rgba(255,255,255,.07);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            z-index: 900;
        }

        .topbar-left,
        .topbar-right {
            display: flex;
            align-items: center;
        }

        .topbar-left {
            gap: 13px;
        }

        .topbar-page {
            color: #a9b0b8;
            font-size: 13px;
        }

        .topbar-divider {
            color: #555d67;
        }

        .topbar-current {
            color: white;
            font-size: 13px;
            font-weight: 600;
        }

        .topbar-right {
            gap: 18px;
        }

        .topbar-notification {
            position: relative;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #cbd1d7;
            text-decoration: none;
            border-radius: 10px;
        }

        .topbar-notification:hover {
            color: #32d58c;
            background: rgba(50,213,140,.08);
        }

        .notification-count {
            position: absolute;
            right: 0;
            top: 0;
            min-width: 17px;
            height: 17px;
            padding: 0 4px;
            border-radius: 20px;
            background: #ff3152;
            color: white;
            font-size: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }

        .topbar-user {
            display: flex;
            align-items: center;
            gap: 10px;
            color: white;
            text-decoration: none;
        }

        .topbar-user img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(50,213,140,.35);
        }

        .topbar-user-name {
            font-size: 12px;
            font-weight: 700;
        }

        .topbar-user-role {
            margin-top: 3px;
            color: #32d58c;
            font-size: 9px;
            font-weight: 700;
        }

        .admin-main {
            margin-left: 250px;
            padding-top: 82px;
        }

        .main-content {
            padding: 30px;
            max-width: 1250px;
            margin: auto;
        }

        .page-header {
            margin-bottom: 25px;
        }

        .page-title {
            margin: 0;
            font-size: 28px;
            font-weight: 800;
        }

        .page-subtitle {
            margin: 7px 0 0;
            color: #7f8791;
            font-size: 13px;
        }

        .alert-box {
            padding: 13px 16px;
            border-radius: 10px;
            margin-bottom: 18px;
            font-size: 13px;
        }

        .alert-success-box {
            background: rgba(50,213,140,.10);
            border: 1px solid rgba(50,213,140,.25);
            color: #6ff0b2;
        }

        .alert-error-box {
            background: rgba(255,49,82,.10);
            border: 1px solid rgba(255,49,82,.25);
            color: #ff8da0;
        }

        .settings-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 22px;
        }

        .settings-card {
            background: #171a20;
            border: 1px solid rgba(255,255,255,.07);
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 15px 35px rgba(0,0,0,.16);
        }

        .settings-card.full {
            grid-column: 1 / -1;
        }

        .card-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 16px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .card-title i {
            color: #32d58c;
        }

        .card-subtitle {
            color: #747d88;
            font-size: 12px;
            margin-bottom: 22px;
        }

        .profile-editor {
            display: flex;
            align-items: center;
            gap: 22px;
            margin-bottom: 24px;
        }

        .profile-preview {
            position: relative;
            flex: 0 0 auto;
        }

        .profile-preview img {
            width: 105px;
            height: 105px;
            object-fit: cover;
            border-radius: 50%;
            border: 3px solid rgba(50,213,140,.55);
            background: #222730;
        }

        .upload-label {
            position: absolute;
            right: -2px;
            bottom: -2px;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #32d58c;
            color: #0c1711;
            cursor: pointer;
            border: 3px solid #171a20;
        }

        .upload-label input {
            display: none;
        }

        .upload-help {
            color: #77808a;
            font-size: 11px;
            line-height: 1.6;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 17px;
        }

        .form-group {
            margin-bottom: 0;
        }

        .form-group.full {
            grid-column: 1 / -1;
        }

        .form-label {
            display: block;
            color: #b8c0c9;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .form-control,
        .form-select {
            width: 100%;
            min-height: 44px;
            border-radius: 9px;
            border: 1px solid #2c323b;
            background: #111419;
            color: #f3f5f7;
            padding: 10px 12px;
            font-size: 12px;
            outline: none;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #32d58c;
            box-shadow: 0 0 0 3px rgba(50,213,140,.08);
        }

        .form-select option {
            background: #171a20;
            color: white;
        }

        .role-note {
            margin-top: 8px;
            color: #6f7882;
            font-size: 10px;
            line-height: 1.5;
        }

        .save-row {
            margin-top: 22px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn-save {
            border: 0;
            background: #32d58c;
            color: #08130d;
            padding: 11px 20px;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 800;
            cursor: pointer;
        }

        .btn-save:hover {
            background: #45e39c;
        }

        .btn-cancel {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            background: #242932;
            color: #c5cbd2;
            padding: 11px 18px;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 700;
        }

        .security-note {
            margin-top: 14px;
            color: #6f7882;
            font-size: 10px;
            line-height: 1.6;
        }

        @@media (max-width: 950px) {
            .settings-grid {
                grid-template-columns: 1fr;
            }

            .settings-card.full {
                grid-column: auto;
            }

            .admin-sidebar {
                transform: translateX(-100%);
            }

            .admin-topbar {
                left: 0;
            }

            .admin-main {
                margin-left: 0;
            }

            .topbar-user-info {
                display: none;
            }
        }

        @@media (max-width: 650px) {
            .main-content {
                padding: 20px 15px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full {
                grid-column: auto;
            }

            .profile-editor {
                align-items: flex-start;
            }
        }
    </style>
</head>

<body>

    <!-- SIDEBAR -->
    <aside class="admin-sidebar">

        <div class="logo-area">
            <div class="logo-icon">
                <i class="fa-solid fa-dumbbell"></i>
            </div>

            <div class="logo-text">
                Health<span>Track</span>
            </div>
        </div>

        <div class="admin-profile">
            <div class="profile-box">

                <img class="profile-image"
                     src="@adminImage"
                     alt="Admin Profile"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />

                <div class="profile-letter" style="display:none;">
                    @(string.IsNullOrWhiteSpace(adminName)
                        ? "A"
                        : adminName.Substring(0, 1).ToUpper())
                </div>

                <div>
                    <div class="profile-name">@adminName</div>
                    <div class="profile-role">@adminRole</div>
                </div>

            </div>
        </div>

        <div class="menu-title">MAIN MENU</div>

        <nav class="sidebar-menu">

            <a href="/Home/Dashboard">
                <i class="fa-solid fa-gauge-high"></i>
                <span>Dashboard</span>
            </a>

            <a href="/Home/Clients">
                <i class="fa-solid fa-users"></i>
                <span>Clients</span>
            </a>

            <a href="/Home/Trainers">
                <i class="fa-solid fa-user-tie"></i>
                <span>Trainers</span>
            </a>

            <a href="/Home/Appointments">
                <i class="fa-solid fa-calendar-check"></i>
                <span>Appointments</span>
            </a>

            <a href="/Home/WorkoutPlans">
                <i class="fa-solid fa-dumbbell"></i>
                <span>Workout Plans</span>
            </a>

            <a href="/Home/DietPlans">
                <i class="fa-solid fa-utensils"></i>
                <span>Diet Plans</span>
            </a>

            <a href="/Home/HealthMetrics">
                <i class="fa-solid fa-chart-line"></i>
                <span>Health Metrics</span>
            </a>

            <a href="/Home/Reports">
                <i class="fa-solid fa-chart-pie"></i>
                <span>Reports</span>
            </a>

            <a href="/Home/Notifications">
                <i class="fa-solid fa-bell"></i>
                <span>Notifications</span>
            </a>

            <a href="/Home/Settings" class="active">
                <i class="fa-solid fa-gear"></i>
                <span>Settings</span>
            </a>

        </nav>

        <div class="sidebar-bottom">
            <div class="sidebar-divider"></div>

            <a href="/Account/Logout">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span>Logout</span>
            </a>
        </div>

    </aside>

    <!-- TOPBAR -->
    <header class="admin-topbar">

        <div class="topbar-left">
            <div class="topbar-page">Admin</div>
            <div class="topbar-divider">/</div>
            <div class="topbar-current">Settings</div>
        </div>

        <div class="topbar-right">

            <a href="/Home/Notifications"
               class="topbar-notification"
               title="Notifications">

                <i class="fa-regular fa-bell"></i>

                <span class="notification-count">
                    @(ViewBag.TotalNotifications ?? 0)
                </span>

            </a>

            <a href="/Home/Settings"
               class="topbar-user"
               title="Settings">

                <img src="@adminImage"
                     alt="Admin Profile" />

                <div class="topbar-user-info">
                    <div class="topbar-user-name">@adminName</div>
                    <div class="topbar-user-role">@adminRole</div>
                </div>
            </a>

        </div>

    </header>

    <!-- MAIN -->
    <div class="admin-main">
        <main class="main-content">

            <div class="page-header">
                <h1 class="page-title">Settings</h1>
                <p class="page-subtitle">
                    Manage your HealthTrack administrator profile and account settings.
                </p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert-box alert-success-box">
                    <i class="fa-solid fa-circle-check me-2"></i>
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert-box alert-error-box">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>
                    @TempData["Error"]
                </div>
            }

            <form method="post"
                  action="/Home/SaveSettings"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="settings-grid">

                    <!-- PROFILE -->
                    <section class="settings-card">

                        <div class="card-title">
                            <i class="fa-solid fa-user"></i>
                            Profile Information
                        </div>

                        <div class="card-subtitle">
                            Update your personal information and profile photo.
                        </div>

                        <div class="profile-editor">

                            <div class="profile-preview">

                                <img id="profilePreview"
                                     src="@adminImage"
                                     alt="Profile Image" />

                                <label class="upload-label"
                                       title="Change profile image">

                                    <i class="fa-solid fa-camera"></i>

                                    <input type="file"
                                           name="ProfileImage"
                                           id="ProfileImage"
                                           accept=".jpg,.jpeg,.png,.webp" />
                                </label>

                            </div>

                            <div class="upload-help">
                                <strong style="color:#dce1e6;">
                                    Profile Photo
                                </strong>
                                <br />
                                JPG, JPEG, PNG or WEBP
                                <br />
                                Maximum size: 5 MB
                            </div>

                        </div>

                        <div class="form-grid">

                            <div class="form-group full">
                                <label class="form-label">Full Name</label>
                                <input class="form-control"
                                       type="text"
                                       name="FullName"
                                       value="@adminName"
                                       maxlength="150"
                                       required />
                            </div>

                            <div class="form-group">
                                <label class="form-label">Email Address</label>
                                <input class="form-control"
                                       type="email"
                                       name="Email"
                                       value="@adminEmail"
                                       maxlength="150"
                                       required />
                            </div>

                            <div class="form-group">
                                <label class="form-label">Phone Number</label>
                                <input class="form-control"
                                       type="text"
                                       name="Phone"
                                       value=""
                                       placeholder="Enter phone number" />
                            </div>

                        </div>

                    </section>

                    <!-- ROLE -->
                    <section class="settings-card">

                        <div class="card-title">
                            <i class="fa-solid fa-shield-halved"></i>
                            Account Role
                        </div>

                        <div class="card-subtitle">
                            Change the role assigned to your account.
                        </div>

                        <div class="form-group">

                            <label class="form-label">
                                User Role
                            </label>

                            <select class="form-select"
                                    name="Role"
                                    required>

                                <option value="ADMIN"
                                    selected="@(adminRole == "ADMIN" ? "selected" : null)">
                                    ADMIN
                                </option>

                                <option value="TRAINER"
                                    selected="@(adminRole == "TRAINER" ? "selected" : null)">
                                    TRAINER
                                </option>

                                <option value="CLIENT"
                                    selected="@(adminRole == "CLIENT" ? "selected" : null)">
                                    CLIENT
                                </option>

                            </select>

                            <div class="role-note">
                                <i class="fa-solid fa-circle-info me-1"></i>
                                If you change your own role from ADMIN to TRAINER or CLIENT,
                                the current admin session will end and you will be redirected
                                to the Login page.
                            </div>

                        </div>

                    </section>

                    <!-- PASSWORD -->
                    <section class="settings-card full">

                        <div class="card-title">
                            <i class="fa-solid fa-lock"></i>
                            Change Password
                        </div>

                        <div class="card-subtitle">
                            Leave these fields empty if you do not want to change your password.
                        </div>

                        <div class="form-grid">

                            <div class="form-group">
                                <label class="form-label">Current Password</label>
                                <input class="form-control"
                                       type="password"
                                       name="CurrentPassword"
                                       autocomplete="current-password"
                                       placeholder="Current password" />
                            </div>

                            <div class="form-group">
                                <label class="form-label">New Password</label>
                                <input class="form-control"
                                       type="password"
                                       name="NewPassword"
                                       autocomplete="new-password"
                                       minlength="6"
                                       placeholder="Minimum 6 characters" />
                            </div>

                            <div class="form-group">
                                <label class="form-label">Confirm New Password</label>
                                <input class="form-control"
                                       type="password"
                                       name="ConfirmPassword"
                                       autocomplete="new-password"
                                       minlength="6"
                                       placeholder="Repeat new password" />
                            </div>

                        </div>

                        <div class="security-note">
                            <i class="fa-solid fa-shield-halved me-1"></i>
                            Your password is stored using the same PBKDF2-SHA256 format used by HealthTrack login.
                        </div>

                    </section>

                </div>

                <div class="save-row">

                    <a href="/Home/Dashboard"
                       class="btn-cancel">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn-save">
                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Save Changes
                    </button>

                </div>

            </form>

        </main>
    </div>

    <script>
        const profileInput = document.getElementById("ProfileImage");
        const profilePreview = document.getElementById("profilePreview");

        if (profileInput) {
            profileInput.addEventListener("change", function () {
                const file = this.files && this.files[0];

                if (!file) return;

                if (file.size > 5 * 1024 * 1024) {
                    alert("Profile image must be smaller than 5 MB.");
                    this.value = "";
                    return;
                }

                const allowed = [
                    "image/jpeg",
                    "image/png",
                    "image/webp"
                ];

                if (!allowed.includes(file.type)) {
                    alert("Only JPG, JPEG, PNG and WEBP images are allowed.");
                    this.value = "";
                    return;
                }

                const reader = new FileReader();

                reader.onload = function (event) {
                    profilePreview.src = event.target.result;
                };

                reader.readAsDataURL(file);
            });
        }
    </script>

</body>
</html>
