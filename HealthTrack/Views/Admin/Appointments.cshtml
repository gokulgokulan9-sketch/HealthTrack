@using HealthTrack.Models
@using System.Linq

@{
    Layout = null;

    var appointments = ViewBag.Appointments as IEnumerable<Appointment>
                       ?? Enumerable.Empty<Appointment>();

    var clients = ViewBag.Clients as IEnumerable<User>
                  ?? Enumerable.Empty<User>();

    var trainers = ViewBag.Trainers as IEnumerable<User>
                   ?? Enumerable.Empty<User>();

    var adminName = ViewBag.AdminName as string ?? "Admin";
    var adminEmail = ViewBag.AdminEmail as string ?? "";
    var adminProfileImage = ViewBag.AdminProfileImage as string ?? "";

    var searchText = ViewBag.Search as string ?? "";

    var totalAppointments = appointments.Count();

    var pendingCount = appointments.Count(x =>
        string.Equals(x.Status, "Pending", StringComparison.OrdinalIgnoreCase));

    var confirmedCount = appointments.Count(x =>
        string.Equals(x.Status, "Confirmed", StringComparison.OrdinalIgnoreCase));

    var completedCount = appointments.Count(x =>
        string.Equals(x.Status, "Completed", StringComparison.OrdinalIgnoreCase));

    var cancelledCount = appointments.Count(x =>
        string.Equals(x.Status, "Cancelled", StringComparison.OrdinalIgnoreCase));
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Appointments - HealthTrack</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html,
            body {
                width: 100%;
                min-height: 100%;
                font-family: "Segoe UI", Arial, sans-serif;
                background: #090b0f;
                color: white;
            }

            body {
                overflow-x: hidden;
            }

            /* =========================================================
                       SIDEBAR
                    ========================================================= */

            .admin-sidebar {
                position: fixed;
                left: 0;
                top: 0;
                width: 245px;
                height: 100vh;
                background: linear-gradient( 180deg, #08090c 0%, #111318 55%, #090a0d 100% );
                border-right: 1px solid rgba(255,255,255,0.08);
                z-index: 1000;
                overflow-y: auto;
            }

            .logo-area {
                height: 82px;
                display: flex;
                align-items: center;
                padding: 0 25px;
                border-bottom: 1px solid rgba(255,255,255,0.07);
            }

            .logo-icon {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #ff1735;
                color: white;
                font-size: 21px;
                box-shadow: 0 0 22px rgba(255,23,53,0.35);
            }

            .logo-text {
                margin-left: 12px;
                font-size: 22px;
                font-weight: 800;
                letter-spacing: -0.5px;
            }

                .logo-text span {
                    color: #ff1735;
                }

            /* =========================================================
                       ADMIN PROFILE
                    ========================================================= */

            .admin-profile {
                padding: 20px 18px;
                border-bottom: 1px solid rgba(255,255,255,0.06);
            }

            .profile-box {
                display: flex;
                align-items: center;
                padding: 12px;
                border-radius: 14px;
                background: linear-gradient( 135deg, rgba(255,255,255,0.06), rgba(255,255,255,0.015) );
            }

            .profile-image {
                width: 46px;
                height: 46px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid #ff1735;
                background: #20242b;
            }

            .profile-letter {
                width: 46px;
                height: 46px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #ff1735;
                font-size: 18px;
                font-weight: 700;
            }

            .profile-info {
                margin-left: 12px;
                min-width: 0;
            }

            .profile-name {
                font-size: 14px;
                font-weight: 700;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .profile-role {
                margin-top: 4px;
                font-size: 11px;
                color: #aeb4bf;
                letter-spacing: 0.8px;
            }

            /* =========================================================
                       MENU
                    ========================================================= */

            .menu-title {
                padding: 20px 24px 10px;
                font-size: 10px;
                color: #777d88;
                font-weight: 700;
                letter-spacing: 1.5px;
            }

            .sidebar-menu {
                padding: 0 12px 25px;
            }

                .sidebar-menu a {
                    height: 48px;
                    display: flex;
                    align-items: center;
                    padding: 0 15px;
                    margin-bottom: 6px;
                    border-radius: 10px;
                    color: #cdd1d8;
                    text-decoration: none;
                    font-size: 14px;
                    font-weight: 500;
                    transition: 0.25s;
                }

                    .sidebar-menu a i {
                        width: 25px;
                        margin-right: 10px;
                        font-size: 16px;
                        text-align: center;
                    }

                    .sidebar-menu a:hover {
                        color: white;
                        background: rgba(255,255,255,0.06);
                    }

                    .sidebar-menu a.active {
                        color: white;
                        background: linear-gradient( 90deg, #ff102f, #e90029 );
                        box-shadow: 0 8px 22px rgba(255,16,47,0.22);
                    }

                    .sidebar-menu a.logout {
                        margin-top: 18px;
                        color: #ff6679;
                    }

            /* =========================================================
                       MAIN
                    ========================================================= */

            .admin-main {
                margin-left: 245px;
                min-height: 100vh;
                background: radial-gradient( circle at 85% 0%, rgba(255,23,53,0.10), transparent 28% ), #090b0f;
            }

            /* =========================================================
                       TOPBAR
                    ========================================================= */

            .topbar {
                height: 72px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 30px;
                background: linear-gradient( 90deg, #090a0d, #111318 );
                border-bottom: 1px solid rgba(255,255,255,0.07);
                position: sticky;
                top: 0;
                z-index: 900;
            }

            .topbar-left {
                display: flex;
                align-items: center;
                gap: 15px;
            }

            .mobile-menu {
                display: none;
                width: 40px;
                height: 40px;
                border: none;
                border-radius: 10px;
                color: white;
                background: #171a20;
                cursor: pointer;
            }

            .page-title-small {
                color: #8f96a2;
                font-size: 13px;
            }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 20px;
            }

            .notification {
                position: relative;
                width: 40px;
                height: 40px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #d5d9df;
                font-size: 17px;
            }

            .notification-link {
                text-decoration: none;
                cursor: pointer;
            }

            .notification-link:hover {
                color: inherit;
                text-decoration: none;
            }

            .notification-badge {
                position: absolute;
                right: 1px;
                top: 0;
                width: 17px;
                height: 17px;
                border-radius: 50%;
                background: #ff1735;
                color: white;
                font-size: 9px;
                font-weight: 700;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .top-admin {
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .top-admin img,
                .top-admin-letter {
                    width: 40px;
                    height: 40px;
                    border-radius: 50%;
                    object-fit: cover;
                    border: 2px solid rgba(255,23,53,0.8);
                }

            .top-admin-letter {
                display: flex;
                align-items: center;
                justify-content: center;
                background: #ff1735;
                font-weight: 700;
            }

            .top-admin-info strong {
                display: block;
                font-size: 13px;
            }

            .top-admin-info span {
                display: block;
                margin-top: 2px;
                color: #858b96;
                font-size: 10px;
            }

            /* =========================================================
                       CONTENT
                    ========================================================= */

            .content {
                padding: 30px;
            }

            .page-heading {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                margin-bottom: 25px;
            }

            .heading-left h1 {
                font-size: 28px;
                font-weight: 800;
            }

            .heading-left p {
                margin-top: 7px;
                color: #858c97;
                font-size: 13px;
            }

            .add-btn {
                border: none;
                padding: 13px 20px;
                border-radius: 10px;
                color: white;
                background: linear-gradient( 135deg, #ff1735, #d90027 );
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                box-shadow: 0 8px 22px rgba(255,23,53,0.20);
                transition: 0.2s;
            }

                .add-btn:hover {
                    transform: translateY(-2px);
                }

                .add-btn i {
                    margin-right: 7px;
                }

            /* =========================================================
                       STAT CARDS
                    ========================================================= */

            .stats-grid {
                display: grid;
                grid-template-columns: repeat(4, minmax(0,1fr));
                gap: 18px;
                margin-bottom: 22px;
            }

            .stat-card {
                padding: 20px;
                border-radius: 15px;
                background: linear-gradient( 135deg, rgba(255,255,255,0.055), rgba(255,255,255,0.018) );
                border: 1px solid rgba(255,255,255,0.07);
            }

            .stat-top {
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .stat-icon {
                width: 45px;
                height: 45px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(255,23,53,0.12);
                color: #ff3150;
                font-size: 18px;
            }

            .stat-number {
                font-size: 27px;
                font-weight: 800;
                margin-top: 14px;
            }

            .stat-label {
                margin-top: 3px;
                color: #9299a5;
                font-size: 12px;
            }

            /* =========================================================
                       APPOINTMENT AREA
                    ========================================================= */

            .appointments-card {
                border-radius: 17px;
                overflow: hidden;
                background: linear-gradient( 145deg, rgba(255,255,255,0.055), rgba(255,255,255,0.018) );
                border: 1px solid rgba(255,255,255,0.07);
            }

            .toolbar {
                padding: 20px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 15px;
                border-bottom: 1px solid rgba(255,255,255,0.06);
            }

            .search-box {
                width: 390px;
                height: 44px;
                display: flex;
                align-items: center;
                padding: 0 14px;
                border-radius: 10px;
                background: #11141a;
                border: 1px solid rgba(255,255,255,0.08);
            }

                .search-box i {
                    color: #777f8b;
                    margin-right: 10px;
                }

                .search-box input {
                    width: 100%;
                    border: none;
                    outline: none;
                    background: transparent;
                    color: white;
                    font-size: 13px;
                }

                    .search-box input::placeholder {
                        color: #666d78;
                    }

            .toolbar-info {
                color: #838a96;
                font-size: 12px;
            }

            /* =========================================================
                       APPOINTMENT GRID
                    ========================================================= */

            .appointment-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0,1fr));
                gap: 18px;
                padding: 20px;
            }

            .appointment-card {
                position: relative;
                padding: 20px;
                border-radius: 15px;
                background: linear-gradient( 145deg, rgba(255,255,255,0.055), rgba(255,255,255,0.018) );
                border: 1px solid rgba(255,255,255,0.07);
                transition: 0.25s;
            }

                .appointment-card:hover {
                    transform: translateY(-3px);
                    border-color: rgba(255,23,53,0.28);
                    box-shadow: 0 15px 35px rgba(0,0,0,0.25);
                }

            .appointment-top {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                margin-bottom: 18px;
            }

            .appointment-id {
                color: #727985;
                font-size: 10px;
                margin-top: 4px;
            }

            .appointment-status {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 6px 10px;
                border-radius: 20px;
                font-size: 10px;
                font-weight: 700;
            }

                .appointment-status.pending {
                    color: #ffc34d;
                    background: rgba(255,195,77,0.10);
                }

                .appointment-status.confirmed {
                    color: #55a8ff;
                    background: rgba(70,150,255,0.10);
                }

                .appointment-status.completed {
                    color: #48df9b;
                    background: rgba(43,215,137,0.10);
                }

                .appointment-status.cancelled {
                    color: #ff6478;
                    background: rgba(255,23,53,0.10);
                }

            .status-dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: currentColor;
            }

            /* =========================================================
                       PEOPLE
                    ========================================================= */

            .people-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
                margin-bottom: 18px;
            }

            .person-box {
                display: flex;
                align-items: center;
                padding: 12px;
                border-radius: 12px;
                background: rgba(255,255,255,0.035);
                border: 1px solid rgba(255,255,255,0.05);
            }

            .person-image,
            .person-letter {
                width: 44px;
                height: 44px;
                flex-shrink: 0;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid rgba(255,23,53,0.55);
            }

            .person-letter {
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient( 135deg, #ff1735, #a9001d );
                font-weight: 700;
            }

            .person-info {
                min-width: 0;
                margin-left: 10px;
            }

            .person-label {
                color: #707783;
                font-size: 9px;
                text-transform: uppercase;
                letter-spacing: 0.8px;
            }

            .person-name {
                margin-top: 4px;
                color: white;
                font-size: 12px;
                font-weight: 700;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            /* =========================================================
                       DETAILS
                    ========================================================= */

            .appointment-details {
                display: grid;
                grid-template-columns: repeat(2, minmax(0,1fr));
                gap: 10px;
                margin-bottom: 18px;
            }

            .detail-box {
                padding: 12px;
                border-radius: 10px;
                background: rgba(255,255,255,0.025);
                border: 1px solid rgba(255,255,255,0.045);
            }

            .detail-label {
                color: #707783;
                font-size: 9px;
                text-transform: uppercase;
                letter-spacing: 0.7px;
            }

            .detail-value {
                margin-top: 5px;
                color: #e4e7eb;
                font-size: 12px;
                word-break: break-word;
            }

            .reason-box {
                margin-bottom: 18px;
                padding: 12px;
                border-radius: 10px;
                background: rgba(255,255,255,0.025);
                border: 1px solid rgba(255,255,255,0.045);
            }

            .reason-text {
                margin-top: 6px;
                color: #bfc4cc;
                font-size: 11px;
                line-height: 1.5;
            }

            /* =========================================================
                       ACTIONS
                    ========================================================= */

            .card-actions {
                display: flex;
                gap: 8px;
                padding-top: 15px;
                border-top: 1px solid rgba(255,255,255,0.055);
            }

            .action-btn {
                height: 36px;
                border: none;
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: 0.2s;
                font-size: 11px;
                font-weight: 700;
            }

                .action-btn i {
                    margin-right: 6px;
                }

            .view-btn {
                flex: 1;
                color: #5da8ff;
                background: rgba(70,150,255,0.10);
            }

            .edit-btn {
                flex: 1;
                color: #ffc34d;
                background: rgba(255,195,77,0.10);
            }

            .delete-btn {
                flex: 1;
                color: #ff5a70;
                background: rgba(255,23,53,0.10);
            }

            .action-btn:hover {
                transform: translateY(-2px);
            }

            /* =========================================================
                       EMPTY
                    ========================================================= */

            .empty-state {
                grid-column: 1 / -1;
                padding: 70px 20px;
                text-align: center;
                color: #747b87;
            }

                .empty-state i {
                    font-size: 42px;
                    color: #ff1735;
                    margin-bottom: 15px;
                }

                .empty-state h3 {
                    color: white;
                    font-size: 18px;
                }

                .empty-state p {
                    margin-top: 7px;
                    font-size: 12px;
                }

            /* =========================================================
                       MODAL
                    ========================================================= */

            .modal-overlay {
                position: fixed;
                inset: 0;
                display: none;
                align-items: center;
                justify-content: center;
                padding: 20px;
                background: rgba(0,0,0,0.78);
                backdrop-filter: blur(7px);
                z-index: 3000;
            }

                .modal-overlay.show {
                    display: flex;
                }

            .modal {
                width: 100%;
                max-width: 650px;
                max-height: 90vh;
                overflow-y: auto;
                border-radius: 18px;
                background: linear-gradient( 145deg, #171a20, #0e1014 );
                border: 1px solid rgba(255,255,255,0.09);
                box-shadow: 0 25px 70px rgba(0,0,0,0.55);
            }

            .modal-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 20px 22px;
                border-bottom: 1px solid rgba(255,255,255,0.07);
            }

                .modal-header h2 {
                    font-size: 18px;
                }

            .modal-close {
                width: 34px;
                height: 34px;
                border: none;
                border-radius: 8px;
                background: #252932;
                color: #cdd1d7;
                cursor: pointer;
            }

            .modal-body {
                padding: 22px;
            }

            .form-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0,1fr));
                gap: 15px;
            }

            .form-group.full {
                grid-column: 1 / -1;
            }

            .form-group label {
                display: block;
                margin-bottom: 7px;
                color: #9da4ae;
                font-size: 11px;
                font-weight: 600;
            }

            .form-control {
                width: 100%;
                height: 43px;
                padding: 0 12px;
                border-radius: 9px;
                outline: none;
                border: 1px solid rgba(255,255,255,0.08);
                background: #0c0f13;
                color: white;
                font-size: 13px;
            }

            textarea.form-control {
                height: 90px;
                padding-top: 11px;
                resize: vertical;
            }

            select.form-control option {
                background: #101318;
                color: white;
            }

            .form-control:focus {
                border-color: rgba(255,23,53,0.65);
                box-shadow: 0 0 0 3px rgba(255,23,53,0.08);
            }

            .modal-footer {
                padding: 18px 22px;
                display: flex;
                justify-content: flex-end;
                gap: 10px;
                border-top: 1px solid rgba(255,255,255,0.07);
            }

            .btn-cancel,
            .btn-save {
                height: 42px;
                padding: 0 18px;
                border: none;
                border-radius: 9px;
                cursor: pointer;
                font-size: 12px;
                font-weight: 700;
            }

            .btn-cancel {
                background: #272b33;
                color: #c9ced6;
            }

            .btn-save {
                background: linear-gradient( 135deg, #ff1735, #d90027 );
                color: white;
            }

            /* =========================================================
                       DETAILS MODAL
                    ========================================================= */

            .view-profile {
                text-align: center;
                padding: 5px 0 20px;
            }

            .view-avatar {
                width: 82px;
                height: 82px;
                border-radius: 50%;
                object-fit: cover;
                border: 3px solid #ff1735;
                background: #22262e;
            }

            .view-name {
                margin-top: 10px;
                font-size: 20px;
                font-weight: 800;
            }

            .view-role {
                margin-top: 4px;
                color: #ff4b63;
                font-size: 11px;
                font-weight: 700;
            }

            .view-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0,1fr));
                gap: 10px;
            }

            /* =========================================================
                       TOAST
                    ========================================================= */

            .toast {
                position: fixed;
                right: 25px;
                bottom: 25px;
                min-width: 280px;
                padding: 14px 17px;
                border-radius: 11px;
                background: #191c22;
                border: 1px solid rgba(255,255,255,0.08);
                box-shadow: 0 15px 40px rgba(0,0,0,0.45);
                color: white;
                font-size: 12px;
                display: none;
                z-index: 5000;
            }

                .toast.show {
                    display: block;
                }

                .toast.success {
                    border-left: 4px solid #32d58c;
                }

                .toast.error {
                    border-left: 4px solid #ff1735;
                }

            /* =========================================================
                       RESPONSIVE
                    ========================================================= */

            @@media (max-width: 1200px) {

                .stats-grid {
                    grid-template-columns: repeat(2, minmax(0,1fr));
                }

                .appointment-grid {
                    grid-template-columns: 1fr;
                }
            }

            @@media (max-width: 800px) {

                .admin-sidebar {
                    transform: translateX(-100%);
                    transition: 0.25s;
                }

                    .admin-sidebar.open {
                        transform: translateX(0);
                    }

                .admin-main {
                    margin-left: 0;
                }

                .mobile-menu {
                    display: block;
                }

                .content {
                    padding: 20px;
                }

                .page-heading {
                    flex-direction: column;
                    gap: 15px;
                }

                .toolbar {
                    flex-direction: column;
                    align-items: stretch;
                }

                .search-box {
                    width: 100%;
                }

                .stats-grid {
                    grid-template-columns: 1fr;
                }

                .people-row,
                .appointment-details,
                .form-grid,
                .view-grid {
                    grid-template-columns: 1fr;
                }

                .form-group.full {
                    grid-column: auto;
                }
            }

    </style>
</head>

<body>

    <!-- =========================================================
         SIDEBAR
    ========================================================= -->

    <aside class="admin-sidebar" id="adminSidebar">

        <div class="logo-area">

            <div class="logo-icon">
                <i class="fa-solid fa-dumbbell"></i>
            </div>

            <div class="logo-text">
                Health<span>Track</span>
            </div>

        </div>


        <div class="admin-profile">

            <div class="profile-box">

                @{
                    var safeAdminImage =
                        string.IsNullOrWhiteSpace(adminProfileImage)
                            ? ""
                            : (
                                adminProfileImage.StartsWith("/")
                                    ? adminProfileImage
                                    : "/images/" + adminProfileImage
                              );
                }

                @if (!string.IsNullOrWhiteSpace(safeAdminImage))
                {
                    <img class="profile-image"
                         src="@safeAdminImage"
