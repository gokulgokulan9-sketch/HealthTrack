                else
                {
                    <div class="profile-letter">
                        @(string.IsNullOrWhiteSpace(adminName)
                            ? "A"
                            : adminName.Substring(0, 1).ToUpper())
                    </div>
                }

                <div class="profile-info">

                    <div class="profile-name">
                        @adminName
                    </div>

                    <div class="profile-role">
                        ADMINISTRATOR
                    </div>

                </div>

            </div>

        </div>


        <div class="menu-title">
            MAIN MENU
        </div>

        <nav class="sidebar-menu">

            <a href="@Url.Action("Dashboard", "Home")">
                <i class="fa-solid fa-chart-pie"></i>
                Dashboard
            </a>

            <a href="@Url.Action("Clients", "Home")">
                <i class="fa-solid fa-users"></i>
                Clients
            </a>

            <a href="@Url.Action("Trainers", "Home")">
                <i class="fa-solid fa-user-tie"></i>
                Trainers
            </a>

            <a class="active"
               href="@Url.Action("Appointments", "Home")">
                <i class="fa-solid fa-calendar-check"></i>
                Appointments
            </a>

            <a href="@Url.Action("WorkoutPlans", "Home")">
                <i class="fa-solid fa-dumbbell"></i>
                Workout Plans
            </a>

            <a href="@Url.Action("DietPlans", "Home")">
                <i class="fa-solid fa-utensils"></i>
                Diet Plans
            </a>

            <a href="@Url.Action("HealthMetrics", "Home")">
                <i class="fa-solid fa-heart-pulse"></i>
                Health Metrics
            </a>

            <a href="@Url.Action("Reports", "Home")">
                <i class="fa-solid fa-chart-column"></i>
                Reports
            </a>

            <a href="@Url.Action("Notifications", "Home")">
                <i class="fa-solid fa-bell"></i>
                Notifications
            </a>

            <a href="@Url.Action("Settings", "Home")">
                <i class="fa-solid fa-gear"></i>
                Settings
            </a>

            <a class="logout"
               href="@Url.Action("Logout", "Account")">
                <i class="fa-solid fa-right-from-bracket"></i>
                Logout
            </a>

        </nav>

    </aside>


    <!-- =========================================================
         MAIN
    ========================================================= -->

    <main class="admin-main">

        <!-- TOPBAR -->

        <header class="topbar">

            <div class="topbar-left">

                <button class="mobile-menu"
                        onclick="toggleSidebar()">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <div class="page-title-small">
                    Admin / Appointments
                </div>

            </div>


            <div class="topbar-right">

                <a href="@Url.Action("Notifications", "Home")"
                   class="notification notification-link"
                   title="Notifications">

                    <i class="fa-regular fa-bell"></i>

                    @{
                        var notificationCount =
                            Convert.ToInt32(ViewBag.UnreadNotifications ?? ViewBag.TotalNotifications ?? 0);
                    }

                    @if (notificationCount > 0)
                    {
                        <span class="notification-badge">
                            @(notificationCount > 99 ? "99+" : notificationCount.ToString())
                        </span>
                    }

                </a>


                <div class="top-admin">

                    @if (!string.IsNullOrWhiteSpace(safeAdminImage))
                    {
                        <img src="@safeAdminImage"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />

                        <div class="top-admin-letter"
                             style="display:none;">
                            @(string.IsNullOrWhiteSpace(adminName)
                                ? "A"
                                : adminName.Substring(0, 1).ToUpper())
                        </div>
                    }
                    else
                    {
                        <div class="top-admin-letter">
                            @(string.IsNullOrWhiteSpace(adminName)
                                ? "A"
                                : adminName.Substring(0, 1).ToUpper())
                        </div>
                    }

                    <div class="top-admin-info">

                        <strong>
                            @adminName
                        </strong>

                        <span>
                            Administrator
                        </span>

                    </div>

                </div>

            </div>

        </header>


        <!-- CONTENT -->

        <section class="content">

            <div class="page-heading">

                <div class="heading-left">

                    <h1>
                        <i class="fa-solid fa-calendar-check"
                           style="color:#ff1735;margin-right:8px;"></i>

                        Appointments
                    </h1>

                    <p>
                        Manage HealthTrack appointments, schedules and sessions.
                    </p>

                </div>

                <button class="add-btn"
                        onclick="openAddModal()">

                    <i class="fa-solid fa-plus"></i>

                    Add Appointment

                </button>

            </div>


            <!-- =====================================================
                 STATS
            ====================================================== -->

            <div class="stats-grid">

                <div class="stat-card">

                    <div class="stat-top">

                        <div>
                            <div class="stat-number">
                                @totalAppointments
                            </div>

                            <div class="stat-label">
                                Total Appointments
                            </div>
                        </div>

                        <div class="stat-icon">
                            <i class="fa-solid fa-calendar-days"></i>
                        </div>

                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-top">

                        <div>
                            <div class="stat-number">
                                @pendingCount
                            </div>

                            <div class="stat-label">
                                Pending
                            </div>
                        </div>

                        <div class="stat-icon">
                            <i class="fa-solid fa-clock"></i>
                        </div>

                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-top">

                        <div>
                            <div class="stat-number">
                                @confirmedCount
                            </div>

                            <div class="stat-label">
                                Confirmed
                            </div>
                        </div>

                        <div class="stat-icon">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>

                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-top">

                        <div>
                            <div class="stat-number">
                                @completedCount
                            </div>

                            <div class="stat-label">
                                Completed
                            </div>
                        </div>

                        <div class="stat-icon">
                            <i class="fa-solid fa-check-double"></i>
                        </div>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 APPOINTMENTS
            ====================================================== -->

            <div class="appointments-card">

                <div class="toolbar">

                    <form method="get"
                          action="@Url.Action("Appointments", "Home")"
                          style="margin:0;">

                        <div class="search-box">

                            <i class="fa-solid fa-magnifying-glass"></i>

                            <input type="text"
                                   name="search"
                                   value="@searchText"
                                   placeholder="Search client, trainer, reason..." />

                        </div>

                    </form>

                    <div class="toolbar-info">

                        @totalAppointments appointment(s)

                    </div>

                </div>


                <div class="appointment-grid">

                    @if (!appointments.Any())
                    {
                        <div class="empty-state">

                            <i class="fa-regular fa-calendar-xmark"></i>

                            <h3>
                                No appointments found
                            </h3>

                            <p>
                                Add a new appointment to get started.
                            </p>

                        </div>
                    }
                    else
                    {
                        foreach (var appointment in appointments)
                        {
                            var clientName =
                                appointment.Client?.FullName ?? "Unknown Client";

                            var trainerName =
                                appointment.Trainer?.FullName ?? "Unknown Trainer";

                            var clientInitial =
                                string.IsNullOrWhiteSpace(clientName)
                                    ? "C"
                                    : clientName.Substring(0, 1).ToUpper();

                            var trainerInitial =
                                string.IsNullOrWhiteSpace(trainerName)
                                    ? "T"
                                    : trainerName.Substring(0, 1).ToUpper();

                            var status =
                                string.IsNullOrWhiteSpace(appointment.Status)
                                    ? "Pending"
                                    : appointment.Status;

                            var statusClass =
                                status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase)
                                    ? "confirmed"
                                    : status.Equals("Completed", StringComparison.OrdinalIgnoreCase)
                                        ? "completed"
                                        : status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase)
                                            ? "cancelled"
                                            : "pending";

                            var clientImage =
                                appointment.Client?.ProfileImage;

                            var trainerImage =
                                appointment.Trainer?.ProfileImage;

                            var clientImageUrl =
                                string.IsNullOrWhiteSpace(clientImage)
                                    ? ""
                                    : (
                                        clientImage.StartsWith("/")
                                            ? clientImage
                                            : "/images/" + clientImage
                                      );

                            var trainerImageUrl =
                                string.IsNullOrWhiteSpace(trainerImage)
                                    ? ""
                                    : (
                                        trainerImage.StartsWith("/")
                                            ? trainerImage
                                            : "/images/" + trainerImage
                                      );

                            <div class="appointment-card">

                                <div class="appointment-top">

                                    <div>

                                        <strong>
                                            Appointment
                                        </strong>

                                        <div class="appointment-id">
                                            ID #@appointment.AppointmentId
                                        </div>

                                    </div>

                                    <span class="appointment-status @statusClass">

                                        <span class="status-dot"></span>

                                        @status

                                    </span>

                                </div>


                                <!-- PEOPLE -->

                                <div class="people-row">

                                    <!-- CLIENT -->

                                    <div class="person-box">

                                        @if (!string.IsNullOrWhiteSpace(clientImageUrl))
                                        {
                                            <img class="person-image"
                                                 src="@clientImageUrl"
                                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />

                                            <div class="person-letter"
                                                 style="display:none;">
                                                @clientInitial
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="person-letter">
                                                @clientInitial
                                            </div>
                                        }

                                        <div class="person-info">

                                            <div class="person-label">
                                                Client
                                            </div>

                                            <div class="person-name">
                                                @clientName
                                            </div>

                                        </div>

                                    </div>


                                    <!-- TRAINER -->

                                    <div class="person-box">

                                        @if (!string.IsNullOrWhiteSpace(trainerImageUrl))
                                        {
                                            <img class="person-image"
                                                 src="@trainerImageUrl"
                                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />

                                            <div class="person-letter"
                                                 style="display:none;">
                                                @trainerInitial
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="person-letter">
                                                @trainerInitial
                                            </div>
                                        }

                                        <div class="person-info">

                                            <div class="person-label">
                                                Trainer
                                            </div>

                                            <div class="person-name">
                                                @trainerName
                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <!-- DETAILS -->

                                <div class="appointment-details">

                                    <div class="detail-box">

                                        <div class="detail-label">
                                            Date
                                        </div>

                                        <div class="detail-value">
                                            @appointment.AppointmentDate.ToString("dd MMM yyyy")
                                        </div>

                                    </div>


                                    <div class="detail-box">

                                        <div class="detail-label">
                                            Time
                                        </div>

                                        <div class="detail-value">
                                            @appointment.AppointmentTime.ToString("hh:mm tt")
                                        </div>

                                    </div>

                                </div>


                                <!-- REASON -->

                                <div class="reason-box">

                                    <div class="detail-label">
                                        Reason
                                    </div>

                                    <div class="reason-text">

                                        @(string.IsNullOrWhiteSpace(appointment.Reason)
                                            ? "No reason provided."
                                            : appointment.Reason)

                                    </div>

                                </div>


                                <!-- ACTIONS -->

                                <div class="card-actions">

                                    <button type="button"
                                            class="action-btn view-btn"
                                            onclick="viewAppointment(
                                        @appointment.AppointmentId,
                                        '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(clientName))',
                                        '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(trainerName))',
                                        '@appointment.AppointmentDate.ToString("dd MMM yyyy")',
                                        '@appointment.AppointmentTime.ToString("hh:mm tt")',
                                        '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(status))',
                                        '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(appointment.Reason ?? ""))',
                                        '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(appointment.Notes ?? ""))'
                                        )">

                                        <i class="fa-solid fa-eye"></i>
                                        View

                                    </button>


                                    <button type="button"
                                            class="action-btn edit-btn"
                                            onclick="openEditModal(
                                        @appointment.AppointmentId,
                                        @appointment.ClientId,
                                        @appointment.TrainerId,
                                        '@appointment.AppointmentDate.ToString("yyyy-MM-dd")',
                                        '@appointment.AppointmentTime.ToString("HH:mm")',
                                        '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(appointment.Reason ?? ""))',
                                        '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(status))',
                                        '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(appointment.Notes ?? ""))'
                                        )">

                                        <i class="fa-solid fa-pen"></i>
                                        Edit

                                    </button>


                                    <form method="post"
                                          action="@Url.Action("DeleteAppointment", "Home")"
                                          style="flex:1;margin:0;"
                                          onsubmit="return confirm('Are you sure you want to delete this appointment?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@appointment.AppointmentId" />

                                        <button type="submit"
                                                class="action-btn delete-btn"
                                                style="width:100%;">

                                            <i class="fa-solid fa-trash"></i>
                                            Delete

                                        </button>

                                    </form>

                                </div>

                            </div>
                        }
                    }

                </div>

            </div>

        </section>

    </main>


    <!-- =========================================================
         ADD / EDIT MODAL
    ========================================================= -->

    <div class="modal-overlay"
         id="appointmentModal">

        <div class="modal">

            <div class="modal-header">

                <h2 id="modalTitle">
                    Add Appointment
                </h2>

                <button class="modal-close"
                        type="button"
                        onclick="closeModal('appointmentModal')">

                    <i class="fa-solid fa-xmark"></i>

                </button>

            </div>


            <form method="post"
                  id="appointmentForm"
                  action="@Url.Action("AddAppointment", "Home")">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="AppointmentId"
                       name="AppointmentId"
                       value="0" />


                <div class="modal-body">

                    <div class="form-grid">

                        <div class="form-group">

                            <label>
                                Client *
                            </label>

                            <select class="form-control"
                                    id="ClientId"
                                    name="ClientId"
                                    required>

                                <option value="">
                                    Select Client
                                </option>

                                @foreach (var client in clients)
                                {
                                    <option value="@client.UserId">
                                        @client.FullName
                                    </option>
                                }

                            </select>

                        </div>


                        <div class="form-group">

                            <label>
                                Trainer *
                            </label>

                            <select class="form-control"
                                    id="TrainerId"
                                    name="TrainerId"
                                    required>

                                <option value="">
                                    Select Trainer
                                </option>

                                @foreach (var trainer in trainers)
                                {
                                    <option value="@trainer.UserId">
                                        @trainer.FullName
                                    </option>
                                }

                            </select>

                        </div>


                        <div class="form-group">

                            <label>
                                Appointment Date *
                            </label>

                            <input type="date"
                                   class="form-control"
                                   id="AppointmentDate"
                                   name="AppointmentDate"
                                   required />

                        </div>


                        <div class="form-group">

                            <label>
                                Appointment Time *
                            </label>

                            <input type="time"
                                   class="form-control"
                                   id="AppointmentTime"
                                   name="AppointmentTime"
                                   required />

                        </div>


                        <div class="form-group full">

                            <label>
                                Reason
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="Reason"
                                   name="Reason"
                                   maxlength="300"
                                   placeholder="Example: Fitness consultation" />

                        </div>


                        <div class="form-group">

                            <label>
                                Status
                            </label>

                            <select class="form-control"
                                    id="Status"
                                    name="Status">

                                <option value="Pending">
                                    Pending
                                </option>

                                <option value="Confirmed">
                                    Confirmed
                                </option>

                                <option value="Completed">
                                    Completed
                                </option>

                                <option value="Cancelled">
                                    Cancelled
                                </option>

                            </select>

                        </div>


                        <div class="form-group">

                            <label>
                                Notes
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="Notes"
                                   name="Notes"
                                   maxlength="500"
                                   placeholder="Optional notes" />

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn-cancel"
                            onclick="closeModal('appointmentModal')">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn-save">

                        <i class="fa-solid fa-floppy-disk"></i>

                        Save Appointment

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- =========================================================
         VIEW MODAL
    ========================================================= -->

    <div class="modal-overlay"
         id="viewModal">

        <div class="modal">

            <div class="modal-header">

                <h2>
                    Appointment Details
                </h2>

                <button class="modal-close"
                        type="button"
                        onclick="closeModal('viewModal')">

                    <i class="fa-solid fa-xmark"></i>

                </button>

            </div>


            <div class="modal-body">

                <div class="view-profile">

                    <div class="person-letter"
                         style="margin:auto;width:82px;height:82px;font-size:28px;"
                         id="viewInitial">

                        A

                    </div>

                    <div class="view-name"
                         id="viewClientName">
                        Client
                    </div>

                    <div class="view-role">
                        APPOINTMENT
                    </div>

                </div>


                <div class="view-grid">

                    <div class="detail-box">

                        <div class="detail-label">
                            Appointment ID
                        </div>

                        <div class="detail-value"
                             id="viewId">
                            -
                        </div>

                    </div>


                    <div class="detail-box">

                        <div class="detail-label">
                            Status
                        </div>

                        <div class="detail-value"
                             id="viewStatus">
                            -
                        </div>

                    </div>


                    <div class="detail-box">

                        <div class="detail-label">
                            Client
                        </div>

                        <div class="detail-value"
                             id="viewClient">
                            -
                        </div>

                    </div>


                    <div class="detail-box">

                        <div class="detail-label">
                            Trainer
                        </div>

                        <div class="detail-value"
                             id="viewTrainer">
                            -
                        </div>

                    </div>


                    <div class="detail-box">

                        <div class="detail-label">
                            Date
                        </div>

                        <div class="detail-value"
                             id="viewDate">
                            -
                        </div>

                    </div>


                    <div class="detail-box">

                        <div class="detail-label">
                            Time
                        </div>

                        <div class="detail-value"
                             id="viewTime">
                            -
                        </div>

                    </div>

                </div>


                <div class="reason-box"
                     style="margin-top:12px;">

                    <div class="detail-label">
                        Reason
                    </div>

                    <div class="reason-text"
                         id="viewReason">
                        -
                    </div>

                </div>


                <div class="reason-box">

                    <div class="detail-label">
                        Notes
                    </div>

                    <div class="reason-text"
                         id="viewNotes">
                        -
                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn-cancel"
                        onclick="closeModal('viewModal')">

                    Close

                </button>

            </div>

        </div>

    </div>


    <!-- =========================================================
         TOAST
    ========================================================= -->

    <div id="toast"
         class="toast">

        <span id="toastMessage"></span>

    </div>


    <script>

            function toggleSidebar() {

                document
                    .getElementById("adminSidebar")
                    .classList
                    .toggle("open");

            }


            function openAddModal() {

                document.getElementById("modalTitle").innerText =
                    "Add Appointment";

                document.getElementById("appointmentForm").action =
                    "@Url.Action("AddAppointment", "Home")";

                document.getElementById("AppointmentId").value = "0";

                document.getElementById("ClientId").value = "";

                document.getElementById("TrainerId").value = "";

                document.getElementById("AppointmentDate").value = "";

                document.getElementById("AppointmentTime").value = "";

                document.getElementById("Reason").value = "";

                document.getElementById("Status").value = "Pending";

                document.getElementById("Notes").value = "";

                document
                    .getElementById("appointmentModal")
                    .classList
                    .add("show");

            }


            function openEditModal(
                id,
                clientId,
                trainerId,
                date,
                time,
                reason,
                status,
                notes
            ) {

                document.getElementById("modalTitle").innerText =
                    "Edit Appointment";

                document.getElementById("appointmentForm").action =
                    "@Url.Action("EditAppointment", "Home")";

                document.getElementById("AppointmentId").value = id;

                document.getElementById("ClientId").value = clientId;

                document.getElementById("TrainerId").value = trainerId;

                document.getElementById("AppointmentDate").value = date;

                document.getElementById("AppointmentTime").value = time;

                document.getElementById("Reason").value = reason;

                document.getElementById("Status").value = status;

                document.getElementById("Notes").value = notes;

                document
                    .getElementById("appointmentModal")
                    .classList
                    .add("show");

            }


            function viewAppointment(
                id,
                client,
                trainer,
                date,
                time,
                status,
                reason,
                notes
            ) {

                document.getElementById("viewId").innerText =
                    id;

                document.getElementById("viewClient").innerText =
                    client;

                document.getElementById("viewClientName").innerText =
                    client;

                document.getElementById("viewTrainer").innerText =
                    trainer;

                document.getElementById("viewDate").innerText =
                    date;

                document.getElementById("viewTime").innerText =
                    time;

                document.getElementById("viewStatus").innerText =
                    status;

                document.getElementById("viewReason").innerText =
                    reason || "No reason provided.";

                document.getElementById("viewNotes").innerText =
                    notes || "No notes.";

                document.getElementById("viewInitial").innerText =
                    client
                        ? client.substring(0, 1).toUpperCase()
                        : "C";

                document
                    .getElementById("viewModal")
                    .classList
                    .add("show");

            }


            function closeModal(id) {

                document
                    .getElementById(id)
                    .classList
                    .remove("show");

            }


            window.addEventListener("click", function(event) {

                if (event.target.classList.contains("modal-overlay")) {

                    event.target.classList.remove("show");

                }

            });


            document.addEventListener("keydown", function(event) {

                if (event.key === "Escape") {

                    document
                        .querySelectorAll(".modal-overlay")
                        .forEach(function(modal) {

                            modal.classList.remove("show");

                        });

                }

            });


            @if (TempData["Success"] != null)
                {
                    <text>

                            document.addEventListener("DOMContentLoaded", function () {

                                showToast(
                                    "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Success"]!.ToString()!))",
                                    "success"
                                );

                                    });

                    </text>
            }


                @if (TempData["Error"] != null)
                {
                    <text>

                            document.addEventListener("DOMContentLoaded", function () {

                                showToast(
                                    "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Error"]!.ToString()!))",
                                    "error"
                                );

                                    });

                    </text>
            }


                function showToast(message, type) {

                    var toast =
                        document.getElementById("toast");

                    var messageBox =
                        document.getElementById("toastMessage");

                    messageBox.innerText = message;

                    toast.className =
                        "toast show " + type;

                    setTimeout(function() {

                        toast.classList.remove("show");

                    }, 3500);

                }

    </script>

</body>
</html>