@{
    Layout = null;

    var trainerName = ViewBag.UserName ?? "Trainer";
    var trainerEmail = ViewBag.UserEmail ?? "";
    var trainerRole = ViewBag.UserRole ?? "TRAINER";
    var profileImage = ViewBag.ProfileImage;

    var totalClients = Convert.ToInt32(ViewBag.TotalClients ?? 0);
    var totalWorkoutPlans = Convert.ToInt32(ViewBag.TotalWorkoutPlans ?? 0);
    var totalDietPlans = Convert.ToInt32(ViewBag.TotalDietPlans ?? 0);
    var totalAppointments = Convert.ToInt32(ViewBag.TotalAppointments ?? 0);
    var totalHealthMetrics = Convert.ToInt32(ViewBag.TotalHealthMetrics ?? 0);
    var totalNotifications = Convert.ToInt32(ViewBag.TotalNotifications ?? 0);

    var clients = ViewBag.Clients as List<HealthTrack.Models.User> ?? new List<HealthTrack.Models.User>();
    var trainerAppointments = ViewBag.TrainerAppointments as List<HealthTrack.Models.Appointment> ?? new List<HealthTrack.Models.Appointment>();
    var recentAppointments = ViewBag.RecentAppointments as List<HealthTrack.Models.Appointment> ?? new List<HealthTrack.Models.Appointment>();
    var upcomingAppointments = ViewBag.UpcomingAppointments as List<HealthTrack.Models.Appointment> ?? new List<HealthTrack.Models.Appointment>();
    var workoutPlans = ViewBag.WorkoutPlansList as List<HealthTrack.Models.WorkoutPlan> ?? new List<HealthTrack.Models.WorkoutPlan>();
    var dietPlans = ViewBag.DietPlansList as List<HealthTrack.Models.DietPlan> ?? new List<HealthTrack.Models.DietPlan>();

    var trainerInitial = string.IsNullOrWhiteSpace(trainerName.ToString()) ? "T" : trainerName.ToString().Trim().Substring(0, 1).ToUpper();
    string profilePath = "";

    // Database stores only the filename (example: trainer1.jpg).
    // Convert it to the real static-files path: /images/trainer1.jpg
    if (profileImage != null && !string.IsNullOrWhiteSpace(profileImage.ToString()))
    {
        profilePath = profileImage.ToString().Trim();

        if (!profilePath.StartsWith("/images/", StringComparison.OrdinalIgnoreCase))
        {
            profilePath = "/images/" + profilePath.TrimStart('/');
        }
    }
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Trainer Dashboard - HealthTrack</title>

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: "Segoe UI", Arial, sans-serif;
                background: linear-gradient( rgba(232,241,248,0.70), rgba(239,247,251,0.76) ), url("https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=2200&q=85");
                background-size: cover;
                background-position: center;
                background-attachment: fixed;
                color: #172033;
                min-height: 100vh;
                overflow-x: hidden;
            }


            /* =====================================================
                       SIDEBAR
                    ===================================================== */

            .sidebar {
                position: fixed;
                left: 0;
                top: 0;
                width: 245px;
                height: 100vh;
                background: linear-gradient( 180deg, #061522 0%, #0B2438 55%, #04101C 100% );
                color: white;
                z-index: 1000;
                display: flex;
                flex-direction: column;
                box-shadow: 5px 0 30px rgba(0,0,0,0.22);
                overflow-y: auto;
                scrollbar-width: thin;
            }

                .sidebar::-webkit-scrollbar {
                    width: 5px;
                }

                .sidebar::-webkit-scrollbar-thumb {
                    background: #00B894;
                    border-radius: 10px;
                }


            /* =====================================================
                       LOGO
                    ===================================================== */

            .brand {
                height: 82px;
                display: flex;
                align-items: center;
                padding: 0 22px;
                border-bottom: 1px solid rgba(255,255,255,0.06);
            }

            .brand-icon {
                width: 43px;
                height: 43px;
                border-radius: 12px;
                background: #00B894;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                box-shadow: 0 7px 20px rgba(239,35,60,0.30);
            }

            .brand-text {
                margin-left: 12px;
                font-size: 22px;
                font-weight: 800;
                letter-spacing: -0.6px;
            }

                .brand-text span {
                    color: #00B894;
                }


            /* =====================================================
                       PROFILE
                    ===================================================== */

            .side-profile {
                margin: 18px 15px 10px;
                padding: 14px;
                border-radius: 15px;
                background: rgba(255,255,255,0.06);
                border: 1px solid rgba(255,255,255,0.06);
                display: flex;
                align-items: center;
            }

            .side-profile-image {
                width: 48px;
                height: 48px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid #00B894;
                background: #222;
            }

            .side-profile-fallback {
                width: 48px;
                height: 48px;
                border-radius: 50%;
                background: #00B894;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
            }

            .side-profile-info {
                margin-left: 11px;
                min-width: 0;
            }

            .side-profile-name {
                color: white;
                font-size: 14px;
                font-weight: 700;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .side-profile-role {
                color: #aaa;
                font-size: 11px;
                margin-top: 4px;
                text-transform: uppercase;
            }


            /* =====================================================
                       MENU
                    ===================================================== */

            .menu-title {
                padding: 13px 22px 8px;
                color: #777;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1.2px;
            }

            .sidebar-menu {
                padding: 0 10px 25px;
            }

            .menu-item {
                height: 46px;
                margin-bottom: 5px;
                padding: 0 14px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                gap: 13px;
                color: #d7d7d7;
                text-decoration: none;
                font-size: 13px;
                font-weight: 500;
                transition: 0.2s ease;
            }

                .menu-item i {
                    width: 20px;
                    text-align: center;
                    font-size: 15px;
                }

                .menu-item:hover {
                    background: rgba(255,255,255,0.08);
                    color: white;
                    transform: translateX(2px);
                }

                .menu-item.active {
                    background: #00B894;
                    color: white;
                    box-shadow: 0 7px 18px rgba(239,35,60,0.30);
                }

            .menu-arrow {
                margin-left: auto;
                font-size: 10px;
                color: #888;
            }

            .menu-item.active .menu-arrow {
                color: white;
            }


            /* =====================================================
                       SIDEBAR BOTTOM
                    ===================================================== */

            .sidebar-bottom {
                margin-top: auto;
                padding: 18px 18px 22px;
                border-top: 1px solid rgba(255,255,255,0.06);
            }

            .sidebar-motivation {
                color: white;
                font-size: 14px;
                line-height: 1.25;
                font-weight: 800;
                text-transform: uppercase;
            }

                .sidebar-motivation span {
                    color: #00B894;
                }

            .motivation-line {
                width: 40px;
                height: 3px;
                background: #00B894;
                margin-top: 10px;
                border-radius: 5px;
            }


            /* =====================================================
                       MAIN
                    ===================================================== */

            .main {
                margin-left: 245px;
                min-height: 100vh;
                padding: 0 0 35px;
            }


            /* =====================================================
                       TOP BAR
                    ===================================================== */

            .topbar {
                height: 70px;
                width: 100%;
                display: flex;
                align-items: center;
                gap: 18px;
                position: sticky;
                top: 0;
                z-index: 100;
                margin: 0;
                padding: 0 22px;
                background: linear-gradient(180deg, #061522 0%, #0B2438 55%, #04101C 100%);
                border-left: 0;
                border-top: 0;
                border-right: 0;
                border-bottom: 1px solid rgba(0,184,148,0.28);
                box-shadow: 0 8px 25px rgba(0,0,0,0.18);
            }

            .search-box {
                width: 370px;
                height: 40px;
                background: rgba(255,255,255,0.09);
                border: 1px solid rgba(255,255,255,0.12);
                border-radius: 10px;
                display: flex;
                align-items: center;
                padding: 0 14px;
                color: #6f747b;
            }

                .search-box i {
                    margin-right: 10px;
                }

                .search-box input {
                    border: none;
                    outline: none;
                    background: transparent;
                    width: 100%;
                    font-size: 12px;
                    color: #EAF4FA;
                }


            .topbar-spacer {
                flex: 1;
            }

            .date-box {
                display: flex;
                align-items: center;
                gap: 9px;
                font-size: 11px;
                color: #D7E4EE;
            }

                .date-box i {
                    color: #00B894;
                    font-size: 16px;
                }

            .report-btn {
                border: none;
                background: #00B894;
                color: white;
                height: 40px;
                padding: 0 16px;
                border-radius: 9px;
                font-size: 11px;
                font-weight: 700;
                cursor: pointer;
                box-shadow: 0 5px 15px rgba(239,35,60,0.22);
            }

                .report-btn i {
                    margin-right: 7px;
                }


            .notification {
                position: relative;
                width: 38px;
                height: 38px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                color: #EAF4FA;
            }

                .notification i {
                    font-size: 18px;
                }

            .notification-badge {
                position: absolute;
                right: 1px;
                top: 1px;
                min-width: 17px;
                height: 17px;
                padding: 0 4px;
                border-radius: 20px;
                background: #00B894;
                color: white;
                font-size: 9px;
                display: flex;
                align-items: center;
                justify-content: center;
            }


            .top-profile {
                display: flex;
                align-items: center;
                gap: 9px;
                cursor: pointer;
            }

                .top-profile img {
                    width: 39px;
                    height: 39px;
                    border-radius: 50%;
                    object-fit: cover;
                    border: 2px solid #00B894;
                }

            .top-profile-fallback {
                width: 39px;
                height: 39px;
                border-radius: 50%;
                background: #00B894;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                font-weight: 700;
            }

            .top-profile-name {
                font-size: 12px;
                font-weight: 800;
                color: #FFFFFF;
                line-height: 1.15;
            }

            .top-profile-role {
                font-size: 10px;
                color: #9FB5C7;
                margin-top: 3px;
            }

            .top-profile-chevron {
                font-size: 9px;
                margin-left: 3px;
                color: #9FB5C7;
            }

            /* =====================================================
                       TOP PROFILE DROPDOWN
                    ===================================================== */

            .top-profile-wrap {
                position: relative;
            }

            .top-profile {
                user-select: none;
            }

            .top-profile-menu {
                position: absolute;
                top: calc(100% + 10px);
                right: 0;
                width: 190px;
                padding: 7px;
                background: #0B2438;
                border: 1px solid rgba(0,184,148,.25);
                border-radius: 12px;
                box-shadow: 0 18px 40px rgba(0,0,0,.30);
                display: none;
                z-index: 3000;
            }

            .top-profile-menu.show {
                display: block;
            }

            .top-profile-menu a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 11px;
                border-radius: 8px;
                color: #D8E6EE;
                text-decoration: none;
                font-size: 11px;
                font-weight: 700;
            }

            .top-profile-menu a i {
                width: 16px;
                text-align: center;
                color: #00B894;
            }

            .top-profile-menu a:hover {
                background: rgba(0,184,148,.12);
                color: #fff;
            }

            .top-profile-menu .menu-divider {
                height: 1px;
                margin: 5px 3px;
                background: rgba(255,255,255,.08);
            }

            .top-profile-menu a.logout-item i {
                color: #ff7b7b;
            }


            /* =====================================================
                       DASHBOARD CONTENT
                    ===================================================== */

            .content {
                padding: 20px 22px 0;
            }


            /* =====================================================
                       WELCOME CARD
                    ===================================================== */

            .welcome-card {
                min-height: 88px;
                border-radius: 17px;
                background: linear-gradient( 110deg, #071A2B, #0D2B45 55%, #102A43 );
                color: white;
                padding: 17px 23px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: relative;
                overflow: hidden;
                box-shadow: 0 15px 35px rgba(0,0,0,0.13);
            }

                .welcome-card::after {
                    content: "";
                    position: absolute;
                    right: -60px;
                    top: -100px;
                    width: 290px;
                    height: 290px;
                    border-radius: 50%;
                    border: 1px solid rgba(239,35,60,0.25);
                    box-shadow: 0 0 0 40px rgba(239,35,60,0.04), 0 0 0 80px rgba(239,35,60,0.03);
                }

            .welcome-small {
                color: #00B894;
                font-size: 10px;
                font-weight: 800;
                letter-spacing: 1px;
                text-transform: uppercase;
                margin-bottom: 4px;
            }

            .welcome-title {
                font-size: 25px;
                font-weight: 800;
                letter-spacing: -0.7px;
            }

                .welcome-title span {
                    color: #00B894;
                }

            .welcome-subtitle {
                color: #bdc2c8;
                font-size: 11px;
                margin-top: 4px;
            }

            .welcome-icon {
                position: relative;
                z-index: 2;
                width: 62px;
                height: 62px;
                border-radius: 50%;
                border: 1px solid rgba(239,35,60,0.30);
                background: rgba(239,35,60,0.12);
                display: flex;
                align-items: center;
                justify-content: center;
                margin-right: 15px;
            }

                .welcome-icon i {
                    color: #00B894;
                    font-size: 26px;
                }


            /* =====================================================
                       STAT CARDS
                    ===================================================== */

            .stats-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 13px;
                margin-top: 14px;
            }

            .stat-card {
                background: linear-gradient(145deg, rgba(248,252,255,0.97), rgba(218,232,242,0.94));
                border: 1.5px solid rgba(11,31,51,0.42);
                border-top: 3px solid #00B894;
                border-radius: 16px;
                min-height: 105px;
                padding: 15px;
                display: flex;
                align-items: center;
                box-shadow: 0 10px 28px rgba(6,21,34,0.13), inset 0 1px 0 rgba(255,255,255,0.85);
                transition: 0.25s ease;
            }

                .stat-card:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 12px 30px rgba(0,0,0,0.10);
                }

            .stat-icon {
                width: 48px;
                height: 48px;
                border-radius: 13px;
                background: #E6F8F3;
                color: #00B894;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 19px;
                margin-right: 12px;
            }

            .stat-title {
                font-size: 10px;
                color: #767b82;
                margin-bottom: 3px;
            }

            .stat-number {
                font-size: 24px;
                font-weight: 800;
                color: #1d232a;
                line-height: 1;
            }

            .stat-change {
                color: #18a957;
                font-size: 9px;
                margin-top: 6px;
                font-weight: 600;
            }


            /* =====================================================
                       GENERAL CARD
                    ===================================================== */

            .card {
                position: relative;
                background: linear-gradient(145deg, rgba(250,253,255,0.97), rgba(224,236,244,0.94));
                border: 1.5px solid rgba(6,21,34,0.38);
                border-top: 3px solid #0B2438;
                border-radius: 16px;
                box-shadow: 0 12px 32px rgba(6,21,34,0.14), inset 0 1px 0 rgba(255,255,255,0.9);
                overflow: hidden;
                transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
            }

            .card:hover {
                transform: translateY(-3px);
                border-color: rgba(0,184,148,0.65);
                box-shadow: 0 18px 38px rgba(6,21,34,0.18), 0 0 0 1px rgba(0,184,148,0.08);
            }

            .card-header {
                height: 58px;
                padding: 0 17px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                background: linear-gradient(180deg, rgba(235,244,249,0.96), rgba(216,231,240,0.78));
                border-bottom: 1px solid rgba(11,31,51,0.18);
                box-shadow: inset 0 -1px 0 rgba(255,255,255,0.55);
            }

            .card-title {
                font-size: 14px;
                font-weight: 800;
                color: #0B1F33;
                display: flex;
                align-items: center;
                gap: 9px;
            }

                .card-title i {
                    color: #00B894;
                    font-size: 14px;
                }

            .view-all {
                color: #00B894;
                font-size: 10px;
                font-weight: 700;
                text-decoration: none;
            }


            /* =====================================================
                       TWO COLUMN
                    ===================================================== */

            .two-column {
                display: grid;
                grid-template-columns: 1.35fr 1fr;
                gap: 13px;
                margin-top: 13px;
            }


            /* =====================================================
                       APPOINTMENTS
                    ===================================================== */

            .appointment-table {
                width: 100%;
                border-collapse: collapse;
            }

                .appointment-table th {
                    background: #D8E8F1;
                    padding: 10px 12px;
                    text-align: left;
                    font-size: 10px;
                    color: #676c72;
                    font-weight: 700;
                }

                .appointment-table td {
                    padding: 10px 12px;
                    border-bottom: 1px solid rgba(11,31,51,0.10);
                    font-size: 10px;
                    color: #30343a;
                }

            .client-cell {
                display: flex;
                align-items: center;
                gap: 8px;
                font-weight: 700;
            }

            .client-avatar {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                object-fit: cover;
                background: #eceff1;
            }

            .status {
                display: inline-flex;
                padding: 4px 8px;
                border-radius: 20px;
                font-size: 8px;
                font-weight: 700;
            }

            .status-confirmed {
                color: #087d42;
                background: #ddf7e9;
            }

            .status-pending {
                color: #9a6700;
                background: #fff1cc;
            }

            .status-completed {
                color: #1769aa;
                background: #e0efff;
            }

            .view-btn {
                border: 1px solid #00B894;
                color: #00B894;
                background: white;
                border-radius: 6px;
                padding: 4px 9px;
                font-size: 8px;
                cursor: pointer;
            }

                .view-btn:hover {
                    background: #00B894;
                    color: white;
                }


            /* =====================================================
                       CLIENT PROGRESS
                    ===================================================== */

            .progress-list {
                padding: 5px 16px 13px;
            }

            .progress-item {
                padding: 10px 0;
                border-bottom: 1px solid rgba(11,31,51,0.10);
                display: grid;
                grid-template-columns: 145px 1fr 35px;
                align-items: center;
                gap: 10px;
            }

            .progress-client {
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .progress-avatar {
                width: 31px;
                height: 31px;
                border-radius: 50%;
                object-fit: cover;
                background: #eee;
            }

            .progress-name {
                font-size: 10px;
                font-weight: 700;
            }

            .progress-goal {
                color: #888;
                font-size: 8px;
                margin-top: 2px;
            }

            .progress-track {
                height: 8px;
                background: #e5e8ea;
                border-radius: 20px;
                overflow: hidden;
            }

            .progress-fill {
                height: 100%;
                background: linear-gradient( 90deg, #00B894, #5ADDBE );
                border-radius: 20px;
            }

            .progress-percent {
                color: #0B2438;
                font-size: 9px;
                font-weight: 800;
                text-align: right;
            }


            /* =====================================================
                       THREE COLUMN
                    ===================================================== */

            .three-column {
                display: grid;
                grid-template-columns: 1.15fr 1fr 0.82fr;
                gap: 13px;
                margin-top: 13px;
            }


            /* =====================================================
                       RECENT CLIENTS
                    ===================================================== */

            .client-row {
                display: grid;
                grid-template-columns: 1.3fr 1fr 1fr 45px;
                align-items: center;
                gap: 8px;
                padding: 10px 15px;
                border-bottom: 1px solid rgba(11,31,51,0.10);
            }

            .client-row-header {
                background: #D8E8F1;
                font-size: 9px;
                color: #777;
                font-weight: 700;
            }

            .client-name-small {
                display: flex;
                align-items: center;
                gap: 7px;
                font-size: 10px;
                font-weight: 700;
            }

            .small-avatar {
                width: 27px;
                height: 27px;
                border-radius: 50%;
                object-fit: cover;
                background: #eee;
            }

            .goal-text {
                font-size: 9px;
                color: #666;
            }

            .mini-progress {
                display: flex;
                align-items: center;
                gap: 5px;
            }

            .mini-track {
                width: 50px;
                height: 6px;
                background: #e5e7e9;
                border-radius: 20px;
                overflow: hidden;
            }

            .mini-fill {
                height: 100%;
                background: #00B894;
                border-radius: 20px;
            }

            .mini-percent {
                font-size: 8px;
                font-weight: 700;
            }


            /* =====================================================
                       WEEKLY CHART
                    ===================================================== */

            .chart-area {
                height: 225px;
                padding: 15px 15px 8px;
                display: flex;
                flex-direction: column;
            }

            .chart-bars {
                flex: 1;
                display: flex;
                align-items: flex-end;
                justify-content: space-around;
                gap: 7px;
                padding: 15px 5px 0;
            }

            .bar-column {
                height: 100%;
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: flex-end;
            }

            .bar-value {
                font-size: 8px;
                font-weight: 700;
                margin-bottom: 5px;
            }

            .bars {
                width: 100%;
                max-width: 22px;
                display: flex;
                align-items: flex-end;
                height: 145px;
            }

            .bar {
                width: 100%;
                background: linear-gradient( to top, #00B894, #45D6B1 );
                border-radius: 5px 5px 2px 2px;
            }

            .bar-label {
                margin-top: 7px;
                font-size: 8px;
                color: #777;
            }

            .chart-legend {
                display: flex;
                justify-content: center;
                gap: 15px;
                font-size: 8px;
                color: #777;
                padding-top: 8px;
            }

            .legend-dot {
                width: 7px;
                height: 7px;
                display: inline-block;
                border-radius: 50%;
                background: #00B894;
                margin-right: 4px;
            }


            /* =====================================================
                       UPCOMING
                    ===================================================== */

            .upcoming-list {
                padding: 4px 15px 10px;
            }

            .upcoming-item {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 10px 0;
                border-bottom: 1px solid rgba(11,31,51,0.10);
            }

            .upcoming-avatar {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                object-fit: cover;
                background: #eee;
            }

            .upcoming-name {
                font-size: 10px;
                font-weight: 700;
            }

            .upcoming-date {
                font-size: 8px;
                color: #777;
                margin-top: 3px;
            }

                .upcoming-date i {
                    color: #00B894;
                    margin-right: 3px;
                }


            /* =====================================================
                       BOTTOM THREE
                    ===================================================== */

            .bottom-grid {
                display: grid;
                grid-template-columns: 1.15fr 1fr 1fr;
                gap: 13px;
                margin-top: 13px;
            }


            /* =====================================================
                       MESSAGES
                    ===================================================== */

            .message-item {
                display: grid;
                grid-template-columns: 32px 1fr auto;
                align-items: center;
                gap: 8px;
                padding: 11px 15px;
                border-bottom: 1px solid rgba(11,31,51,0.10);
            }

            .message-avatar {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                object-fit: cover;
                background: #eee;
            }

            .message-name {
                font-size: 10px;
                font-weight: 700;
            }

            .message-text {
                font-size: 8px;
                color: #777;
                margin-top: 3px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .message-time {
                font-size: 8px;
                color: #999;
            }


            /* =====================================================
                       DONUT CHART
                    ===================================================== */

            .donut-layout {
                min-height: 210px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 20px;
                padding: 15px;
            }

            .donut {
                width: 125px;
                height: 125px;
                border-radius: 50%;
                background: conic-gradient( #00B894 0 33%, #45D6B1 33% 58%, #7DE0C5 58% 75%, #C8F0E5 75% 90%, #d9dde0 90% 100% );
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
            }

                .donut::after {
                    content: "";
                    width: 78px;
                    height: 78px;
                    border-radius: 50%;
                    background: #F4F9FC;
                    position: absolute;
                }

            .donut-center {
                position: relative;
                z-index: 2;
                text-align: center;
            }

            .donut-number {
                font-size: 22px;
                font-weight: 800;
            }

            .donut-label {
                font-size: 8px;
                color: #777;
            }

            .legend-list {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            .legend-row {
                display: flex;
                align-items: center;
                gap: 7px;
                font-size: 9px;
                color: #34495A;
                font-weight: 600;
            }

            .legend-color {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: #00B894;
            }



            /* =====================================================
                       WELCOME CHAT BUTTON
                    ===================================================== */

            .welcome-title-row {
                display: flex;
                align-items: center;
                gap: 13px;
                flex-wrap: wrap;
            }

            .welcome-chat-btn {
                position: relative;
                z-index: 5;
                height: 44px;
                padding: 0 18px;
                border: 1px solid rgba(117,230,194,0.48);
                border-radius: 12px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 9px;
                color: #052018;
                background: linear-gradient(135deg, #22D3A5, #00B894);
                box-shadow: 0 9px 22px rgba(0,184,148,0.28);
                font-size: 12px;
                font-weight: 800;
                cursor: pointer;
                transition: .2s ease;
                white-space: nowrap;
            }

            .welcome-chat-btn i {
                font-size: 13px;
            }

            .welcome-actions {
                position: relative;
                z-index: 3;
                display: flex;
                align-items: center;
                gap: 13px;
                margin-left: auto;
            }

            .welcome-chat-btn:hover {
                color: #02140F;
                transform: translateY(-2px);
                box-shadow: 0 10px 22px rgba(0,184,148,0.30);
            }

            @@media (max-width: 650px) {
                .welcome-title-row {
                    gap: 8px;
                }

                .welcome-chat-btn {
                    height: 31px;
                    padding: 0 10px;
                }
            }

        /* =========================================================
           PREMIUM CLIENT CHAT DRAWER
           ========================================================= */
        .chat-overlay {
            position: fixed;
            inset: 0;
            background: rgba(2, 10, 20, .58);
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
            opacity: 0;
            visibility: hidden;
            transition: .25s ease;
            z-index: 1900;
        }

        .chat-overlay.show {
            opacity: 1;
            visibility: visible;
        }

        .chat-drawer {
            position: fixed;
            top: 0;
            right: -455px;
            width: 440px;
            height: 100vh;
            display: flex;
            flex-direction: column;
            background: linear-gradient(180deg, #0b2239 0%, #081a2d 100%);
            border-left: 1px solid rgba(65, 108, 139, .55);
            box-shadow: -18px 0 45px rgba(0,0,0,.35);
            z-index: 2000;
            transition: right .28s cubic-bezier(.22,.61,.36,1);
        }

        .chat-drawer.open {
            right: 0;
        }

        .chat-drawer-header {
            min-height: 78px;
            padding: 14px 17px;
            display: flex;
            align-items: center;
            gap: 11px;
            border-bottom: 1px solid #21425e;
            background: linear-gradient(135deg, #102f4b, #0a2036);
        }

        .chat-header-avatar {
            width: 43px;
            height: 43px;
            flex: 0 0 43px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(32,201,151,.65);
            background: #173b57;
        }

        .chat-header-info {
            flex: 1;
            min-width: 0;
        }

        .chat-header-title {
            color: #f4fbff;
            font-size: 14px;
            font-weight: 800;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .chat-header-status {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-top: 3px;
            color: #72dfbd;
            font-size: 10px;
        }

        .chat-header-actions {
            display: flex;
            gap: 6px;
        }

        .chat-icon-btn {
            width: 35px;
            height: 35px;
            border-radius: 9px;
            border: 1px solid #315674;
            background: #122f49;
            color: #a8bfd1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: .18s ease;
        }

        .chat-icon-btn:hover {
            color: #fff;
            border-color: var(--emerald);
            background: rgba(32,201,151,.10);
        }

        .chat-close-btn:hover {
            color: #ff91a2;
            border-color: rgba(255,107,129,.55);
            background: rgba(255,107,129,.08);
        }

        .chat-client-list {
            padding: 12px 12px 8px;
            border-bottom: 1px solid #1d3d58;
            background: #0a1e32;
        }

        .chat-list-search {
            position: relative;
            margin-bottom: 9px;
        }

        .chat-list-search i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #718ba2;
            font-size: 12px;
        }

        .chat-list-search input {
            width: 100%;
            height: 38px;
            padding: 0 12px 0 35px;
            border-radius: 9px;
            border: 1px solid #2c506b;
            outline: none;
            background: #102b44;
            color: #eef7ff;
            font-size: 11px;
        }

        .chat-list-search input:focus {
            border-color: rgba(32,201,151,.75);
            box-shadow: 0 0 0 3px rgba(32,201,151,.08);
        }

        .chat-list {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 2px;
        }

        .chat-client-chip {
            flex: 0 0 auto;
            min-width: 125px;
            padding: 8px 9px;
            border-radius: 10px;
            border: 1px solid #254963;
            background: #102b44;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: .18s;
        }

        .chat-client-chip:hover,
        .chat-client-chip.active {
            border-color: rgba(32,201,151,.65);
            background: rgba(32,201,151,.08);
        }

        .chat-chip-avatar {
            width: 29px;
            height: 29px;
            flex: 0 0 29px;
            border-radius: 50%;
            object-fit: cover;
            background: #31536f;
            border: 1px solid #456984;
        }

        .chat-chip-name {
            max-width: 80px;
            color: #dfeaf3;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .chat-chip-status {
            margin-top: 2px;
            color: #718ba2;
            font-size: 9px;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 18px 15px;
            background:
                radial-gradient(circle at 20% 15%, rgba(32,201,151,.035), transparent 25%),
                linear-gradient(180deg, #081b2e, #07192a);
        }

        .chat-date-label {
            text-align: center;
            margin: 0 auto 16px;
            color: #67829a;
            font-size: 9px;
        }

        .chat-message-row {
            display: flex;
            margin-bottom: 12px;
        }

        .chat-message-row.client {
            justify-content: flex-start;
        }

        .chat-message-row.trainer {
            justify-content: flex-end;
        }

        .chat-bubble {
            max-width: 76%;
            padding: 10px 12px;
            border-radius: 13px;
            font-size: 11px;
            line-height: 1.5;
            position: relative;
        }

        .chat-message-row.client .chat-bubble {
            background: #163550;
            border: 1px solid #28516d;
            color: #dbe8f2;
            border-bottom-left-radius: 4px;
        }

        .chat-message-row.trainer .chat-bubble {
            background: linear-gradient(135deg, #169d79, #117f63);
            border: 1px solid rgba(117,230,194,.25);
            color: #effff9;
            border-bottom-right-radius: 4px;
        }

        .chat-time {
            display: block;
            margin-top: 5px;
            opacity: .62;
            font-size: 8px;
            text-align: right;
        }

        .chat-composer {
            padding: 11px 12px;
            border-top: 1px solid #21415c;
            background: #0a2035;
        }

        .chat-compose-row {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .chat-attach-btn,
        .chat-send-btn {
            width: 39px;
            height: 39px;
            flex: 0 0 39px;
            border-radius: 10px;
            border: 1px solid #315675;
            background: #122f49;
            color: #a7bed0;
            cursor: pointer;
        }

        .chat-send-btn {
            border-color: rgba(32,201,151,.45);
            background: linear-gradient(135deg, #22cf9f, #159f7b);
            color: #062018;
        }

        .chat-message-input {
            flex: 1;
            min-width: 0;
            height: 39px;
            border: 1px solid #315675;
            border-radius: 10px;
            background: #102d47;
            color: #fff;
            outline: none;
            padding: 0 12px;
            font-size: 11px;
        }

        .chat-message-input:focus {
            border-color: var(--emerald);
            box-shadow: 0 0 0 3px rgba(32,201,151,.08);
        }

        .call-panel {
            position: absolute;
            inset: 0;
            z-index: 5;
            display: none;
            flex-direction: column;
            background: #061522;
        }

        .call-panel.show {
            display: flex;
        }

        .call-topbar {
            height: 64px;
            padding: 0 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #1f425c;
            background: #0a2034;
        }

        .call-title {
            color: #f2fbff;
            font-size: 13px;
            font-weight: 800;
        }

        .call-subtitle {
            color: #7894aa;
            font-size: 9px;
            margin-top: 2px;
        }

        .call-stage {
            flex: 1;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(circle at 50% 40%, rgba(32,201,151,.10), transparent 27%),
                #05121f;
        }

        .call-avatar-large {
            width: 112px;
            height: 112px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(32,201,151,.72);
            box-shadow: 0 0 0 12px rgba(32,201,151,.045), 0 18px 45px rgba(0,0,0,.45);
            background: #173b57;
        }

        .call-name {
            position: absolute;
            bottom: 78px;
            color: #eaf7ff;
            font-size: 14px;
            font-weight: 800;
        }

        .call-status {
            position: absolute;
            bottom: 58px;
            color: #6ee4bd;
            font-size: 10px;
        }

        .call-controls {
            min-height: 78px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            background: #0a2034;
            border-top: 1px solid #1e4059;
        }

        .call-control {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: 1px solid #315675;
            background: #132f48;
            color: #c8d8e5;
            cursor: pointer;
        }

        .call-control:hover {
            border-color: var(--emerald);
            color: #fff;
        }

        .call-control.end {
            background: #d94b63;
            border-color: #ee7185;
            color: #fff;
        }

        .chat-no-clients {
            padding: 18px;
            color: #7992a8;
            font-size: 10px;
            text-align: center;
        }


            /* =====================================================
                       RESPONSIVE
                    ===================================================== */

            @@media (max-width: 1200px) {

                .stats-grid {
                    grid-template-columns: repeat(2, 1fr);
                }

                .two-column,
                .three-column,
                .bottom-grid {
                    grid-template-columns: 1fr;
                }

                .search-box {
                    width: 260px;
                }
            }

            @@media (max-width: 850px) {

                .sidebar {
                    width: 215px;
                }

                .main {
                    margin-left: 215px;
                }

                .date-box {
                    display: none;
                }

                .report-btn {
                    display: none;
                }

                .top-profile-info {
                    display: none;
                }
            }

            @@media (max-width: 650px) {

                .sidebar {
                    position: relative;
                    width: 100%;
                    height: auto;
                }

                .main {
                    margin-left: 0;
                }

                .stats-grid {
                    grid-template-columns: 1fr;
                }

                .topbar {
                    position: relative;
                }

                .search-box {
                    width: 100%;
                }

                .welcome-card {
                    padding: 15px;
                }

                .welcome-title {
                    font-size: 20px;
                }

                .welcome-icon {
                    display: none;
                }
            }


        @@media (max-width: 500px) {
            .chat-drawer {
                width: 100%;
                right: -100%;
            }

            .chat-drawer.open {
                right: 0;
            }
        }

    </style>

</head>


<body>

    <aside class="sidebar">
        <div class="brand">
            <div class="brand-icon"><i class="fa-solid fa-dumbbell"></i></div>
            <div class="brand-text">Health<span>Track</span></div>
        </div>

        <div class="side-profile">
            @if (!string.IsNullOrWhiteSpace(profilePath))
            {
                <img src="@profilePath" class="side-profile-image" alt="Trainer" />
            }
            else
            {
                <div class="side-profile-fallback">@trainerInitial</div>
            }
            <div class="side-profile-info">
                <div class="side-profile-name">@trainerName</div>
                <div class="side-profile-role">Trainer</div>
            </div>
        </div>

        <div class="menu-title">MAIN MENU</div>
        <nav class="sidebar-menu">
            <a href="@Url.Action("TrainerDashboard", "Home")" class="menu-item active">
                <i class="fa-solid fa-chart-line"></i><span>Dashboard</span>
            </a>
            <a href="@Url.Action("MyClients", "Home")" class="menu-item"><i class="fa-solid fa-users"></i><span>My Clients</span><i class="fa-solid fa-chevron-right menu-arrow"></i></a>
            <a href="#" class="menu-item"><i class="fa-regular fa-calendar-check"></i><span>Appointments</span><i class="fa-solid fa-chevron-right menu-arrow"></i></a>
            <a href="#" class="menu-item"><i class="fa-solid fa-dumbbell"></i><span>Workout Plans</span><i class="fa-solid fa-chevron-right menu-arrow"></i></a>
            <a href="#" class="menu-item"><i class="fa-solid fa-apple-whole"></i><span>Diet Plans</span><i class="fa-solid fa-chevron-right menu-arrow"></i></a>
            <a href="#" class="menu-item"><i class="fa-solid fa-chart-simple"></i><span>Progress Reports</span><i class="fa-solid fa-chevron-right menu-arrow"></i></a>
            <a href="@Url.Action("TrainerMessages", "Home")"
               class="menu-item">
                <i class="fa-solid fa-message"></i>
                <span>Messages</span>
                <span class="menu-arrow">0</span>
            </a>
            <a href="#" class="menu-item"><i class="fa-regular fa-bell"></i><span>Notifications</span></a>
        </nav>

        <div class="sidebar-bottom">
            <div class="sidebar-motivation">STRONGER <span>PEOPLE</span><br />HEALTHIER TOMORROW</div>
            <div class="motivation-line"></div>
        </div>
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input id="dashboardSearch" type="text" placeholder="Search clients, appointments..." />
            </div>
            <div class="topbar-spacer"></div>
            <div class="date-box"><i class="fa-regular fa-calendar"></i><span id="currentDate"></span></div>
            <div class="notification">
                <i class="fa-regular fa-bell"></i>
                @if (totalNotifications > 0) { <span class="notification-badge">@totalNotifications</span> }
            </div>
            <div class="top-profile-wrap">
                <div class="top-profile" id="trainerProfileMenuButton" role="button" tabindex="0" aria-expanded="false">
                    @if (!string.IsNullOrWhiteSpace(profilePath))
                    {
                        <img src="@profilePath" alt="Trainer" />
                    }
                    else
                    {
                        <div class="top-profile-fallback">@trainerInitial</div>
                    }
                    <div>
                        <div class="top-profile-name">@trainerName</div>
                        <div class="top-profile-role">Trainer</div>
                    </div>
                    <i class="fa-solid fa-chevron-down top-profile-chevron"></i>
                </div>

                <div class="top-profile-menu" id="trainerProfileMenu">
                    <a href="@Url.Action("TrainerSettings", "Home")">
                        <i class="fa-solid fa-gear"></i>
                        <span>Settings</span>
                    </a>

                    <div class="menu-divider"></div>

                    <a href="@Url.Action("Logout", "Home")" class="logout-item">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Logout</span>
                    </a>
                </div>
            </div>
        </header>

        <section class="content">
            <div class="welcome-card">
                <div>
                    <div class="welcome-small">Trainer Dashboard</div>
                    <div class="welcome-title-row">
                        <div class="welcome-title">Welcome back, <span>@trainerName</span></div>
                    </div>
                    <div class="welcome-subtitle">Manage your clients, appointments and fitness plans from one place.</div>
                </div>

                <div class="welcome-actions">
                    <button type="button"
                            class="welcome-chat-btn"
                            onclick="openDashboardChat()"
                            title="Chat with your clients">
                        <i class="fa-solid fa-comments"></i>
                        <span>Chat with Client</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>

                    <div class="welcome-icon">
                        <i class="fa-solid fa-person-running"></i>
                    </div>
                </div>
            </div>

            <div class="stats-grid">
                <div class="stat-card"><div class="stat-icon"><i class="fa-solid fa-users"></i></div><div><div class="stat-title">My Clients</div><div class="stat-number">@totalClients</div><div class="stat-change"><i class="fa-solid fa-link"></i> Assigned to you</div></div></div>
                <div class="stat-card"><div class="stat-icon"><i class="fa-regular fa-calendar-check"></i></div><div><div class="stat-title">Appointments</div><div class="stat-number">@totalAppointments</div><div class="stat-change"><i class="fa-solid fa-calendar-day"></i> Your appointments</div></div></div>
                <div class="stat-card"><div class="stat-icon"><i class="fa-solid fa-dumbbell"></i></div><div><div class="stat-title">Workout Plans</div><div class="stat-number">@totalWorkoutPlans</div><div class="stat-change"><i class="fa-solid fa-user-check"></i> Your plans</div></div></div>
                <div class="stat-card"><div class="stat-icon"><i class="fa-solid fa-apple-whole"></i></div><div><div class="stat-title">Diet Plans</div><div class="stat-number">@totalDietPlans</div><div class="stat-change"><i class="fa-solid fa-user-check"></i> Your plans</div></div></div>
            </div>

            <div class="two-column">
                <div class="card">
                    <div class="card-header"><div class="card-title"><i class="fa-regular fa-calendar-check"></i> Today's / Recent Appointments</div><a href="#" class="view-all">View All</a></div>
                    <div style="overflow-x:auto;">
                        <table class="appointment-table" id="appointmentsTable">
                            <thead><tr><th>Client</th><th>Date</th><th>Time</th><th>Status</th><th></th></tr></thead>
                            <tbody>
                            @if (recentAppointments.Count == 0)
                            {
                                <tr><td colspan="5" style="text-align:center;color:#888;padding:25px;">No appointments for this trainer.</td></tr>
                            }
                            else
                            {
                                foreach (var appointment in recentAppointments)
                                {
                                    var clientName = appointment.Client?.FullName ?? "Client";
                                    var initial = string.IsNullOrWhiteSpace(clientName) ? "C" : clientName.Substring(0,1).ToUpper();
                                    var status = appointment.Status ?? "Pending";
                                    var statusClass = status.Equals("Completed", StringComparison.OrdinalIgnoreCase) ? "status-completed" : status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) ? "status-confirmed" : "status-pending";
                                    <tr class="search-row">
                                        <td><div class="client-cell"><div class="client-avatar" style="display:flex;align-items:center;justify-content:center;background:#E2F8F1;color:#00B894;font-weight:700;">@initial</div>@clientName</div></td>
                                        <td>@appointment.AppointmentDate.ToString("dd MMM yyyy")</td>
                                        <td>@appointment.AppointmentTime.ToString("hh:mm tt")</td>
                                        <td><span class="status @statusClass">@status</span></td>
                                        <td><button type="button" class="view-btn">View</button></td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header"><div class="card-title"><i class="fa-solid fa-chart-simple"></i> Client Overview</div></div>
                    <div class="progress-list">
                        @if (clients.Count == 0)
                        {
                            <div style="padding:25px;text-align:center;color:#888;font-size:11px;">No clients assigned yet.</div>
                        }
                        else
                        {
                            foreach (var client in clients.Take(5))
                            {
                                var clientInitial = string.IsNullOrWhiteSpace(client.FullName) ? "C" : client.FullName.Substring(0,1).ToUpper();
                                <div class="progress-item search-client-row">
                                    <div class="progress-client"><div class="progress-avatar" style="display:flex;align-items:center;justify-content:center;background:#E2F8F1;color:#00B894;font-weight:700;">@clientInitial</div><div><div class="progress-name">@client.FullName</div><div class="progress-goal">Active client</div></div></div>
                                    <div class="progress-track"><div class="progress-fill" style="width:100%;"></div></div>
                                    <div class="progress-percent">100%</div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="three-column">
                <div class="card">
                    <div class="card-header"><div class="card-title"><i class="fa-solid fa-users"></i> My Clients</div><a href="#" class="view-all">View All</a></div>
                    <div class="client-row client-row-header"><div>Client</div><div>Goal</div><div>Plan</div><div></div></div>
                    @if (clients.Count == 0)
                    {
                        <div style="padding:25px;text-align:center;color:#888;font-size:10px;">No clients linked to this trainer.</div>
                    }
                    else
                    {
                        foreach (var client in clients.Take(5))
                        {
                            var initial = string.IsNullOrWhiteSpace(client.FullName) ? "C" : client.FullName.Substring(0,1).ToUpper();
                            var clientWorkoutCount = workoutPlans.Count(w => w.ClientId == client.UserId);
                            var clientDietCount = dietPlans.Count(d => d.ClientId == client.UserId);
                            <div class="client-row search-client-row">
                                <div class="client-name-small"><div class="small-avatar" style="display:flex;align-items:center;justify-content:center;background:#E2F8F1;color:#00B894;">@initial</div>@client.FullName</div>
                                <div class="goal-text">Fitness</div>
                                <div class="mini-progress"><div class="mini-track"><div class="mini-fill" style="width:@(Math.Min(100, (clientWorkoutCount + clientDietCount) * 25))%;"></div></div><span class="mini-percent">@(clientWorkoutCount + clientDietCount)</span></div>
                                <button class="view-btn" type="button">View</button>
                            </div>
                        }
                    }
                </div>

                <div class="card">
                    <div class="card-header"><div class="card-title"><i class="fa-solid fa-chart-column"></i> Weekly Appointments</div><span style="font-size:9px;border:1px solid #e2e5e8;padding:6px 9px;border-radius:7px;color:#666;">This Week</span></div>
                    <div class="chart-area">
                        <div class="chart-bars">
                        @for (int dayIndex = 0; dayIndex < 7; dayIndex++)
                        {
                            var date = DateTime.Today.Date.AddDays(dayIndex - (int)DateTime.Today.DayOfWeek + 1);
                            var count = trainerAppointments.Count(a => a.AppointmentDate.ToDateTime(TimeOnly.MinValue).Date == date.Date);
                            var height = count == 0 ? 5 : Math.Min(100, 20 + count * 20);
                            <div class="bar-column"><span class="bar-value">@count</span><div class="bars"><div class="bar" style="height:@height%;"></div></div><span class="bar-label">@date.ToString("ddd")</span></div>
                        }
                        </div>
                        <div class="chart-legend"><span><span class="legend-dot"></span>Appointments</span></div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header"><div class="card-title"><i class="fa-regular fa-calendar-check"></i> Upcoming</div><a href="#" class="view-all">View All</a></div>
                    <div class="upcoming-list">
                        @if (upcomingAppointments.Count == 0)
                        {
                            <div style="padding:25px;text-align:center;color:#888;font-size:10px;">No upcoming appointments.</div>
                        }
                        else
                        {
                            foreach (var appointment in upcomingAppointments)
                            {
                                var name = appointment.Client?.FullName ?? "Client";
                                var initial = string.IsNullOrWhiteSpace(name) ? "C" : name.Substring(0,1).ToUpper();
                                <div class="upcoming-item"><div class="upcoming-avatar" style="display:flex;align-items:center;justify-content:center;background:#E2F8F1;color:#00B894;font-weight:700;">@initial</div><div><div class="upcoming-name">@name</div><div class="upcoming-date"><i class="fa-regular fa-calendar"></i>@appointment.AppointmentDate.ToString("dd MMM yyyy") &nbsp; <i class="fa-regular fa-clock"></i>@appointment.AppointmentTime.ToString("hh:mm tt")</div></div></div>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="bottom-grid">
                <div class="card">
                    <div class="card-header"><div class="card-title"><i class="fa-solid fa-message"></i> Recent Messages</div><a href="#" class="view-all">Chat</a></div>
                    <div class="message-item"><div class="message-avatar" style="display:flex;align-items:center;justify-content:center;background:#E2F8F1;color:#00B894;font-weight:700;"><i class="fa-solid fa-message"></i></div><div><div class="message-name">Private Chat</div><div class="message-text">Chat will be enabled for your assigned clients.</div></div><div class="message-time">Ready</div></div>
                    @foreach (var client in clients.Take(3))
                    {
                        var initial = string.IsNullOrWhiteSpace(client.FullName) ? "C" : client.FullName.Substring(0,1).ToUpper();
                        <div class="message-item"><div class="message-avatar" style="display:flex;align-items:center;justify-content:center;background:#E2F8F1;color:#00B894;font-weight:700;">@initial</div><div><div class="message-name">@client.FullName</div><div class="message-text">Open private conversation</div></div><div class="message-time"><i class="fa-regular fa-comment"></i></div></div>
                    }
                </div>

                <div class="card">
                    <div class="card-header"><div class="card-title"><i class="fa-solid fa-dumbbell"></i> Workout Plans</div><a href="#" class="view-all">View All</a></div>
                    <div class="donut-layout">
                        <div class="donut"><div class="donut-center"><div class="donut-number">@totalWorkoutPlans</div><div class="donut-label">Your Plans</div></div></div>
                        <div class="legend-list">
                            @foreach (var plan in workoutPlans.Take(5))
                            {
                                <div class="legend-row"><span class="legend-color"></span>@plan.PlanName</div>
                            }
                            @if (workoutPlans.Count == 0) { <div class="legend-row">No workout plans</div> }
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header"><div class="card-title"><i class="fa-solid fa-apple-whole"></i> Diet Plans</div><a href="#" class="view-all">View All</a></div>
                    <div class="donut-layout">
                        <div class="donut" style="background:conic-gradient(#00B894 0 60%, #45D6B1 60% 80%, #7DE0C5 80% 92%, #d9dde0 92% 100%);"><div class="donut-center"><div class="donut-number">@totalDietPlans</div><div class="donut-label">Your Plans</div></div></div>
                        <div class="legend-list">
                            @foreach (var plan in dietPlans.Take(5))
                            {
                                <div class="legend-row"><span class="legend-color"></span>@plan.PlanName</div>
                            }
                            @if (dietPlans.Count == 0) { <div class="legend-row">No diet plans</div> }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- PREMIUM CHAT DRAWER -->
    <div id="chatOverlay" class="chat-overlay" onclick="closeChatDrawer()"></div>

    <aside id="chatDrawer" class="chat-drawer" aria-label="Client Chat">

        <div class="chat-drawer-header">
            <div id="chatHeaderAvatarWrap">
                <div class="chat-header-avatar d-flex align-items-center justify-content-center">
                    <i class="fa-solid fa-user" style="color:#8da5bc;"></i>
                </div>
            </div>

            <div class="chat-header-info">
                <div id="chatHeaderName" class="chat-header-title">Client Chat</div>
                <div class="chat-header-status">
                    <span class="chat-status-dot"></span>
                    <span id="chatHeaderStatus">Select a client</span>
                </div>
            </div>

            <div class="chat-header-actions">
                <button type="button"
                        class="chat-icon-btn"
                        title="Voice Call"
                        onclick="startClientCall('voice')">
                    <i class="fa-solid fa-phone"></i>
                </button>

                <button type="button"
                        class="chat-icon-btn"
                        title="Video Call"
                        onclick="startClientCall('video')">
                    <i class="fa-solid fa-video"></i>
                </button>

                <button type="button"
                        class="chat-icon-btn chat-close-btn"
                        title="Close"
                        onclick="closeChatDrawer()">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>

        <div class="chat-client-list">

            <div class="chat-list-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text"
                       id="chatClientSearch"
                       placeholder="Search clients..."
                       autocomplete="off" />
            </div>

            <div id="chatClientList" class="chat-list">
                @if (ViewBag.Clients != null && ViewBag.Clients.Count > 0)
                {
                    foreach (var chatClient in ViewBag.Clients)
                    {
                        var chatName = chatClient.FullName?.ToString() ?? "Client";
                        var chatEmail = chatClient.Email?.ToString() ?? "";
                        var chatImage = chatClient.ProfileImage?.ToString();
                        var chatInitial = string.IsNullOrWhiteSpace(chatName)
                            ? "C"
                            : chatName.Substring(0, 1).ToUpper();

                        <button type="button"
                                class="chat-client-chip"
                                data-client-id="@chatClient.UserId"
                                data-client-name="@chatName"
                                data-client-email="@chatEmail"
                                data-client-image="@chatImage"
                                onclick="selectChatClient(this)">

                            @if (!string.IsNullOrWhiteSpace(chatImage))
                            {
                                <img src="@chatImage"
                                     class="chat-chip-avatar"
                                     alt="@chatName" />
                            }
                            else
                            {
                                <span class="chat-chip-avatar d-flex align-items-center justify-content-center"
                                      style="font-weight:800;color:#75e6c2;">
                                    @chatInitial
                                </span>
                            }

                            <span>
                                <span class="chat-chip-name">@chatName</span>
                                <span class="chat-chip-status">Client</span>
                            </span>

                        </button>
                    }
                }
                else
                {
                    <div class="chat-no-clients">No assigned clients available.</div>
                }
            </div>

        </div>

        <div id="chatMessages" class="chat-messages">

            <div class="chat-date-label">HealthTrack Secure Chat</div>

            <div id="chatEmptyState"
                 class="empty-state"
                 style="padding:70px 15px;">
                <i class="fa-solid fa-comments"></i>
                <h5>Select a Client</h5>
                <div>Choose a client above to start a conversation.</div>
            </div>

            <div id="chatConversation" style="display:none;"></div>

        </div>

        <div class="chat-composer">

            <div class="chat-compose-row">
                <button type="button"
                        class="chat-attach-btn"
                        title="Attach">
                    <i class="fa-solid fa-paperclip"></i>
                </button>

                <input type="text"
                       id="chatMessageInput"
                       class="chat-message-input"
                       placeholder="Type a message..."
                       autocomplete="off" />

                <button type="button"
                        class="chat-send-btn"
                        title="Send"
                        onclick="sendDrawerMessage()">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </div>

        </div>

        <!-- CALL SCREEN -->
        <div id="callPanel" class="call-panel">

            <div class="call-topbar">
                <div>
                    <div id="callTitle" class="call-title">Client Call</div>
                    <div id="callSubtitle" class="call-subtitle">Connecting...</div>
                </div>

                <button type="button"
                        class="chat-icon-btn"
                        onclick="endClientCall()">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="call-stage">

                <div id="callAvatarWrap">
                    <div class="call-avatar-large d-flex align-items-center justify-content-center">
                        <i class="fa-solid fa-user" style="color:#8da5bc;font-size:35px;"></i>
                    </div>
                </div>

                <div id="callName" class="call-name">Client</div>
                <div id="callStatus" class="call-status">Calling...</div>

            </div>

            <div class="call-controls">

                <button type="button"
                        class="call-control"
                        title="Mute"
                        onclick="toggleCallMute(this)">
                    <i class="fa-solid fa-microphone"></i>
                </button>

                <button type="button"
                        class="call-control"
                        title="Camera"
                        onclick="toggleCallCamera(this)">
                    <i class="fa-solid fa-video"></i>
                </button>

                <button type="button"
                        class="call-control end"
                        title="End Call"
                        onclick="endClientCall()">
                    <i class="fa-solid fa-phone-slash"></i>
                </button>

            </div>

        </div>

    </aside>

    <form id="chatAntiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <script>

        // =========================================================
        // DASHBOARD CLIENT CHAT
        // Opens the same premium chat drawer used on My Clients.
        // =========================================================

        function openDashboardChat() {
            const firstClient = document.querySelector(".chat-client-chip");

            if (firstClient) {
                openChatDrawer(
                    firstClient.dataset.clientId,
                    firstClient.dataset.clientName,
                    firstClient.dataset.clientEmail,
                    firstClient.dataset.clientImage
                );
            } else {
                openChatDrawer("", "Client", "", "");
            }
        }

        let activeChatClient = null;

        function openChatDrawer(clientId, clientName, clientEmail, clientImage) {
            activeChatClient = {
                id: clientId || "",
                name: clientName || "Client",
                email: clientEmail || "",
                image: clientImage || ""
            };

            updateChatHeader();
            showChatConversation();
            loadChatHistory(activeChatClient.id);

            document.getElementById("chatOverlay")?.classList.add("show");
            document.getElementById("chatDrawer")?.classList.add("open");

            const firstMatching = Array.from(
                document.querySelectorAll(".chat-client-chip")
            ).find(btn => btn.dataset.clientName === activeChatClient.name);

            document.querySelectorAll(".chat-client-chip")
                .forEach(btn => btn.classList.remove("active"));

            firstMatching?.classList.add("active");
        }

        function selectChatClient(button) {
            activeChatClient = {
                id: button.dataset.clientId || "",
                name: button.dataset.clientName || "Client",
                email: button.dataset.clientEmail || "",
                image: button.dataset.clientImage || ""
            };

            document.querySelectorAll(".chat-client-chip")
                .forEach(btn => btn.classList.remove("active"));

            button.classList.add("active");

            updateChatHeader();
            showChatConversation();
            loadChatHistory(activeChatClient.id);
        }

        function updateChatHeader() {
            if (!activeChatClient) return;

            const name = document.getElementById("chatHeaderName");
            const status = document.getElementById("chatHeaderStatus");
            const wrap = document.getElementById("chatHeaderAvatarWrap");

            if (name) name.textContent = activeChatClient.name;
            if (status) status.textContent = "Ready to chat";

            if (wrap) {
                if (activeChatClient.image) {
                    wrap.innerHTML =
                        `<img src="${escapeHtmlAttribute(activeChatClient.image)}"
                              class="chat-header-avatar"
                              alt="${escapeHtmlAttribute(activeChatClient.name)}">`;
                } else {
                    const initial = (activeChatClient.name || "C").charAt(0).toUpperCase();
                    wrap.innerHTML =
                        `<div class="chat-header-avatar d-flex align-items-center justify-content-center"
                              style="font-weight:800;color:#75e6c2;">
                            ${escapeHtml(initial)}
                         </div>`;
                }
            }
        }

        function showChatConversation() {
            document.getElementById("chatEmptyState")?.style.setProperty("display", "none");
            document.getElementById("chatConversation")?.style.setProperty("display", "block");
        }

        function closeChatDrawer() {
            document.getElementById("chatOverlay")?.classList.remove("show");
            document.getElementById("chatDrawer")?.classList.remove("open");
            endClientCall(true);
        }

        function focusFirstChatClient(event) {
            event?.preventDefault();

            const tableFirstChat = document.querySelector(".client-chat-trigger");
            if (tableFirstChat) {
                tableFirstChat.click();
                return;
            }

            const firstClient = document.querySelector(".chat-client-chip");
            if (firstClient) {
                openChatDrawer(
                    firstClient.dataset.clientId,
                    firstClient.dataset.clientName,
                    firstClient.dataset.clientEmail,
                    firstClient.dataset.clientImage
                );
            } else {
                openChatDrawer("", "Client", "", "");
            }
        }

        async function sendDrawerMessage() {
            const input = document.getElementById("chatMessageInput");
            const text = (input?.value || "").trim();

            if (!text || !activeChatClient?.id) return;

            const token = document.querySelector(
                '#chatAntiForgeryForm input[name="__RequestVerificationToken"]'
            )?.value;

            if (!token) {
                alert("Security token is missing. Please refresh the page.");
                return;
            }

            const body = new URLSearchParams();
            body.append("__RequestVerificationToken", token);
            body.append("receiverId", activeChatClient.id);
            body.append("message", text);

            try {
                input.disabled = true;

                const response = await fetch(
                    '@Url.Action("SendTrainerMessage", "Home")',
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
                        },
                        body: body.toString()
                    }
                );

                if (!response.ok) {
                    throw new Error("Message could not be sent.");
                }

                input.value = "";
                await loadChatHistory(activeChatClient.id);
            }
            catch (error) {
                console.error(error);
                alert("Message could not be sent. Please try again.");
            }
            finally {
                input.disabled = false;
                input.focus();
            }
        }

        async function loadChatHistory(clientId) {
            const conversation = document.getElementById("chatConversation");
            if (!conversation || !clientId) return;

            conversation.innerHTML = `
                <div style="padding:30px;text-align:center;color:#7f9bb2;font-size:11px;">
                    Loading messages...
                </div>`;

            try {
                const url =
                    '@Url.Action("TrainerMessages", "Home")' +
                    '?clientId=' + encodeURIComponent(clientId);

                const response = await fetch(url, {
                    method: "GET",
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });

                if (!response.ok) {
                    throw new Error("Chat history could not be loaded.");
                }

                const html = await response.text();
                const doc = new DOMParser().parseFromString(html, "text/html");
                const source = doc.querySelector("#chatMessages");
                const sourceRows = source
                    ? source.querySelectorAll(".message-row")
                    : [];

                conversation.innerHTML = "";

                if (!sourceRows.length) {
                    conversation.innerHTML = `
                        <div class="chat-empty" style="height:100%;display:flex;align-items:center;justify-content:center;text-align:center;">
                            <div>
                                <i class="fa-regular fa-comments" style="font-size:30px;color:#4d718d;margin-bottom:10px"></i>
                                <div>Start a conversation with this client.</div>
                            </div>
                        </div>`;
                    return;
                }

                sourceRows.forEach(sourceRow => {
                    const sourceBubble = sourceRow.querySelector(".bubble");
                    if (!sourceBubble) return;

                    const isTrainer = sourceRow.classList.contains("trainer");
                    const timeElement = sourceBubble.querySelector(".message-time");
                    const timeText = timeElement?.textContent?.trim() || "";

                    if (timeElement) timeElement.remove();
                    const messageText = sourceBubble.textContent.trim();

                    const row = document.createElement("div");
                    row.className = "chat-message-row " + (isTrainer ? "trainer" : "client");

                    const bubble = document.createElement("div");
                    bubble.className = "chat-bubble";
                    bubble.appendChild(document.createTextNode(messageText));

                    if (timeText) {
                        const time = document.createElement("span");
                        time.className = "chat-time";
                        time.textContent = timeText;
                        bubble.appendChild(time);
                    }

                    row.appendChild(bubble);
                    conversation.appendChild(row);
                });

                const messages = document.getElementById("chatMessages");
                if (messages) messages.scrollTop = messages.scrollHeight;
            }
            catch (error) {
                console.error(error);
                conversation.innerHTML = `
                    <div style="padding:30px;text-align:center;color:#d88;font-size:11px;">
                        Unable to load chat history.
                    </div>`;
            }
        }

        function startClientCall(type) {
            if (!activeChatClient) {
                const firstClient = document.querySelector(".chat-client-chip");
                if (!firstClient) return;

                selectChatClient(firstClient);
            }

            const panel = document.getElementById("callPanel");
            if (!panel) return;

            const title = document.getElementById("callTitle");
            const subtitle = document.getElementById("callSubtitle");
            const callName = document.getElementById("callName");
            const callStatus = document.getElementById("callStatus");
            const avatarWrap = document.getElementById("callAvatarWrap");

            const isVideo = type === "video";

            if (title) {
                title.textContent = isVideo ? "Video Call" : "Voice Call";
            }

            if (subtitle) {
                subtitle.textContent = activeChatClient.name;
            }

            if (callName) {
                callName.textContent = activeChatClient.name;
            }

            if (callStatus) {
                callStatus.textContent = isVideo
                    ? "Starting video call..."
                    : "Starting voice call...";
            }

            if (avatarWrap) {
                if (activeChatClient.image) {
                    avatarWrap.innerHTML =
                        `<img src="${escapeHtmlAttribute(activeChatClient.image)}"
                              class="call-avatar-large"
                              alt="${escapeHtmlAttribute(activeChatClient.name)}">`;
                } else {
                    const initial = (activeChatClient.name || "C").charAt(0).toUpperCase();
                    avatarWrap.innerHTML =
                        `<div class="call-avatar-large d-flex align-items-center justify-content-center"
                              style="font-weight:800;color:#75e6c2;font-size:34px;">
                            ${escapeHtml(initial)}
                         </div>`;
                }
            }

            panel.classList.add("show");

            setTimeout(() => {
                if (callStatus) {
                    callStatus.textContent = isVideo
                        ? "Waiting for client..."
                        : "Calling client...";
                }
            }, 700);
        }

        function endClientCall(silent = false) {
            const panel = document.getElementById("callPanel");
            panel?.classList.remove("show");

            if (!silent) {
                const status = document.getElementById("chatHeaderStatus");
                if (status && activeChatClient) {
                    status.textContent = "Ready to chat";
                }
            }
        }

        function toggleCallMute(button) {
            button.classList.toggle("active");
            const icon = button.querySelector("i");
            if (icon) {
                icon.className = button.classList.contains("active")
                    ? "fa-solid fa-microphone-slash"
                    : "fa-solid fa-microphone";
            }
        }

        function toggleCallCamera(button) {
            button.classList.toggle("active");
            const icon = button.querySelector("i");
            if (icon) {
                icon.className = button.classList.contains("active")
                    ? "fa-solid fa-video-slash"
                    : "fa-solid fa-video";
            }
        }

        function escapeHtml(value) {
            const div = document.createElement("div");
            div.textContent = value ?? "";
            return div.innerHTML;
        }

        function escapeHtmlAttribute(value) {
            return String(value ?? "")
                .replace(/&/g, "&amp;")
                .replace(/"/g, "&quot;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");
        }

        document.getElementById("chatClientSearch")?.addEventListener("input", function () {
            const query = (this.value || "").toLowerCase().trim();

            document.querySelectorAll(".chat-client-chip").forEach(button => {
                const name = (button.dataset.clientName || "").toLowerCase();
                const email = (button.dataset.clientEmail || "").toLowerCase();

                button.style.display =
                    !query || name.includes(query) || email.includes(query)
                        ? ""
                        : "none";
            });
        });

        document.getElementById("chatMessageInput")?.addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                sendDrawerMessage();
            }
        });

        // =========================================================
        // TRAINER PROFILE DROPDOWN
        // Settings + Logout
        // =========================================================

        const trainerProfileButton =
            document.getElementById("trainerProfileMenuButton");

        const trainerProfileMenu =
            document.getElementById("trainerProfileMenu");

        if (trainerProfileButton && trainerProfileMenu) {

            function toggleTrainerProfileMenu() {
                const isOpen =
                    trainerProfileMenu.classList.toggle("show");

                trainerProfileButton.setAttribute(
                    "aria-expanded",
                    isOpen ? "true" : "false"
                );
            }

            trainerProfileButton.addEventListener(
                "click",
                function (event) {
                    event.stopPropagation();
                    toggleTrainerProfileMenu();
                }
            );

            trainerProfileButton.addEventListener(
                "keydown",
                function (event) {
                    if (event.key === "Enter" ||
                        event.key === " ") {
                        event.preventDefault();
                        toggleTrainerProfileMenu();
                    }
                }
            );

            trainerProfileMenu.addEventListener(
                "click",
                function (event) {
                    event.stopPropagation();
                }
            );

            document.addEventListener(
                "click",
                function () {
                    trainerProfileMenu.classList.remove("show");
                    trainerProfileButton.setAttribute(
                        "aria-expanded",
                        "false"
                    );
                }
            );
        }


        const now = new Date();
        document.getElementById('currentDate').textContent = now.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' });

        const search = document.getElementById('dashboardSearch');
        if (search) {
            search.addEventListener('input', function () {
                const term = this.value.toLowerCase().trim();
                document.querySelectorAll('.search-row, .search-client-row').forEach(row => {
                    row.style.display = row.textContent.toLowerCase().includes(term) ? '' : 'none';
                });
            });
        }
    </script>
</body>
</html>
