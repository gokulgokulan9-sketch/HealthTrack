@{
    ViewData["Title"] = "Appointments";
    Layout = null;

    var trainerName = ViewBag.UserName ?? "Trainer";
    var profileImage = ViewBag.ProfileImage;
    var trainerInitial = string.IsNullOrWhiteSpace(trainerName.ToString())
        ? "T"
        : trainerName.ToString().Trim().Substring(0, 1).ToUpper();

    string profilePath = "";
    if (profileImage != null && !string.IsNullOrWhiteSpace(profileImage.ToString()))
    {
        profilePath = profileImage.ToString().Trim();
        if (!profilePath.StartsWith("/images/", StringComparison.OrdinalIgnoreCase))
            profilePath = "/images/" + profilePath.TrimStart('/');
    }

    var appointments = ViewBag.TrainerAppointments as IEnumerable<HealthTrack.Models.Appointment>
        ?? ViewBag.Appointments as IEnumerable<HealthTrack.Models.Appointment>
        ?? new List<HealthTrack.Models.Appointment>();

    var appointmentList = appointments.ToList();
    var totalAppointments = appointmentList.Count;
    var pendingAppointments = appointmentList.Count(a => string.Equals(a.Status, "Pending", StringComparison.OrdinalIgnoreCase));
    var confirmedAppointments = appointmentList.Count(a => string.Equals(a.Status, "Confirmed", StringComparison.OrdinalIgnoreCase));
    var completedAppointments = appointmentList.Count(a => string.Equals(a.Status, "Completed", StringComparison.OrdinalIgnoreCase));
}
