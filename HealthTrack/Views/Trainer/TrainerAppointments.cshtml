            color: #fff;
            border-color: var(--emerald);
            background: rgba(32,201,151,.10);
        }

        .chat-close-btn:hover {
            color: #ff91a2;
            border-color: rgba(255,107,129,.55);
            background: rgba(255,107,129,.08);
        }

        .chat-client-list {
            padding: 12px 12px 8px;
            border-bottom: 1px solid #1d3d58;
            background: #0a1e32;
        }

        .chat-list-search {
            position: relative;
            margin-bottom: 9px;
        }

        .chat-list-search i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #718ba2;
            font-size: 12px;
        }

        .chat-list-search input {
            width: 100%;
            height: 38px;
            padding: 0 12px 0 35px;
            border-radius: 9px;
            border: 1px solid #2c506b;
            outline: none;
            background: #102b44;
            color: #eef7ff;
            font-size: 11px;
        }

        .chat-list-search input:focus {
            border-color: rgba(32,201,151,.75);
            box-shadow: 0 0 0 3px rgba(32,201,151,.08);
        }

        .chat-list {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 2px;
        }

        .chat-client-chip {
            flex: 0 0 auto;
            min-width: 125px;
            padding: 8px 9px;
            border-radius: 10px;
            border: 1px solid #254963;
            background: #102b44;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: .18s;
        }

        .chat-client-chip:hover,
        .chat-client-chip.active {
            border-color: rgba(32,201,151,.65);
            background: rgba(32,201,151,.08);
        }

        .chat-chip-avatar {
            width: 29px;
            height: 29px;
            flex: 0 0 29px;
            border-radius: 50%;
            object-fit: cover;
            background: #31536f;
            border: 1px solid #456984;
        }

        .chat-chip-name {
            max-width: 80px;
            color: #dfeaf3;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .chat-chip-status {
            margin-top: 2px;
            color: #718ba2;
            font-size: 9px;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 18px 15px;
            background:
                radial-gradient(circle at 20% 15%, rgba(32,201,151,.035), transparent 25%),
                linear-gradient(180deg, #081b2e, #07192a);
        }

        .chat-date-label {
            text-align: center;
            margin: 0 auto 16px;
            color: #67829a;
            font-size: 9px;
        }

        .chat-message-row {
            display: flex;
            margin-bottom: 12px;
        }

        .chat-message-row.client {
            justify-content: flex-start;
        }

        .chat-message-row.trainer {
            justify-content: flex-end;
        }

        .chat-bubble {
            max-width: 76%;
            padding: 10px 12px;
            border-radius: 13px;
            font-size: 11px;
            line-height: 1.5;
            position: relative;
        }

        .chat-message-row.client .chat-bubble {
            background: #163550;
            border: 1px solid #28516d;
            color: #dbe8f2;
            border-bottom-left-radius: 4px;
        }

        .chat-message-row.trainer .chat-bubble {
            background: linear-gradient(135deg, #169d79, #117f63);
            border: 1px solid rgba(117,230,194,.25);
            color: #effff9;
            border-bottom-right-radius: 4px;
        }

        .chat-time {
            display: block;
            margin-top: 5px;
            opacity: .62;
            font-size: 8px;
            text-align: right;
        }

        .chat-composer {
            padding: 11px 12px;
            border-top: 1px solid #21415c;
            background: #0a2035;
        }

        .chat-compose-row {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .chat-attach-btn,
        .chat-send-btn {
            width: 39px;
            height: 39px;
            flex: 0 0 39px;
            border-radius: 10px;
            border: 1px solid #315675;
            background: #122f49;
            color: #a7bed0;
            cursor: pointer;
        }

        .chat-send-btn {
            border-color: rgba(32,201,151,.45);
            background: linear-gradient(135deg, #22cf9f, #159f7b);
            color: #062018;
        }

        .chat-message-input {
            flex: 1;
            min-width: 0;
            height: 39px;
            border: 1px solid #315675;
            border-radius: 10px;
            background: #102d47;
            color: #fff;
            outline: none;
            padding: 0 12px;
            font-size: 11px;
        }

        .chat-message-input:focus {
            border-color: var(--emerald);
            box-shadow: 0 0 0 3px rgba(32,201,151,.08);
        }

        .call-panel {
            position: absolute;
            inset: 0;
            z-index: 5;
            display: none;
            flex-direction: column;
            background: #061522;
        }

        .call-panel.show {
            display: flex;
        }

        .call-topbar {
            height: 64px;
            padding: 0 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #1f425c;
            background: #0a2034;
        }

        .call-title {
            color: #f2fbff;
            font-size: 13px;
            font-weight: 800;
        }

        .call-subtitle {
            color: #7894aa;
            font-size: 9px;
            margin-top: 2px;
        }

        .call-stage {
            flex: 1;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(circle at 50% 40%, rgba(32,201,151,.10), transparent 27%),
                #05121f;
        }

        .call-avatar-large {
            width: 112px;
            height: 112px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(32,201,151,.72);
            box-shadow: 0 0 0 12px rgba(32,201,151,.045), 0 18px 45px rgba(0,0,0,.45);
            background: #173b57;
        }

        .call-name {
            position: absolute;
            bottom: 78px;
            color: #eaf7ff;
            font-size: 14px;
            font-weight: 800;
        }

        .call-status {
            position: absolute;
            bottom: 58px;
            color: #6ee4bd;
            font-size: 10px;
        }

        .call-controls {
            min-height: 78px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            background: #0a2034;
            border-top: 1px solid #1e4059;
        }

        .call-control {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: 1px solid #315675;
            background: #132f48;
            color: #c8d8e5;
            cursor: pointer;
        }

        .call-control:hover {
            border-color: var(--emerald);
            color: #fff;
        }

        .call-control.end {
            background: #d94b63;
            border-color: #ee7185;
            color: #fff;
        }

        .chat-no-clients {
            padding: 18px;
            color: #7992a8;
            font-size: 10px;
            text-align: center;
        }

        @@media (max-width: 760px) {
            .chat-client-banner {
                align-items: flex-start;
                flex-direction: column;
                padding: 18px;
            }

            .open-chat-btn {
                width: 100%;
            }

            .chat-client-left {
                align-items: flex-start;
            }
        }

        @@media (max-width: 850px) {
            .sidebar {
                width: 215px;
            }

            .main {
                margin-left: 215px;
            }
        }

        @@media (max-width: 650px) {
            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .main {
                margin-left: 0;
            }
        }

        @@media (max-width: 1100px) {
            .stats {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 600px) {
            .stats {
                grid-template-columns: 1fr;
            }

            .toolbar {
                flex-direction: column;
                align-items: stretch;
            }

            .search-box {
                max-width: none;
            }
        }
    </style>
<style>
.app-page{padding:22px}
.hero{padding:23px 25px;border-radius:18px;margin-bottom:18px;display:flex;align-items:center;justify-content:space-between;background:radial-gradient(circle at 85% 25%,rgba(32,201,151,.16),transparent 27%),linear-gradient(135deg,#102f49,#0b263e 55%,#0b2035);border:1px solid rgba(32,201,151,.25);box-shadow:0 15px 35px rgba(0,0,0,.20)}
.hero h1{margin:0;color:#f4fbff;font-size:23px;font-weight:800}.hero p{margin:6px 0 0;color:#9db6c9;font-size:12px}.hero-icon{width:62px;height:62px;border-radius:17px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#32dfad,#18b98e);color:#062018;font-size:25px;box-shadow:0 12px 28px rgba(32,201,151,.22)}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px}.stat{padding:16px;border-radius:15px;background:linear-gradient(145deg,#294966,#1e3958);border:1px solid #355a78;border-top:3px solid #20c997;box-shadow:0 12px 28px rgba(0,0,0,.16)}.stat-icon{width:39px;height:39px;border-radius:11px;display:flex;align-items:center;justify-content:center;background:rgba(32,201,151,.11);color:#20c997}.stat-num{margin-top:10px;font-size:25px;font-weight:800}.stat-label{margin-top:4px;color:#9db0c4;font-size:11px}
.toolbar{display:flex;gap:12px;margin-bottom:15px}.search{position:relative;flex:1;max-width:440px}.search i{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#7892aa}.search input{width:100%;height:43px;padding:0 14px 0 38px;border-radius:11px;border:1px solid #41647f;background:#132e4a;color:#fff;outline:0}.filter{height:43px;min-width:145px;border-radius:11px;border:1px solid #41647f;background:#132e4a;color:#dce9f5;padding:0 12px}
.card{border-radius:17px;overflow:hidden;background:linear-gradient(145deg,#294966,#1e3958);border:1px solid #355a78;box-shadow:0 14px 32px rgba(0,0,0,.18)}.card-head{padding:17px 20px;display:flex;justify-content:space-between;border-bottom:1px solid #41617b;background:linear-gradient(90deg,#213f5e,#294966)}.card-title{font-size:15px;font-weight:800}.card-title i{color:#20c997;margin-right:8px}.count{color:#9eb4c9;font-size:11px}.table-wrap{overflow-x:auto}table{width:100%;min-width:900px;border-collapse:collapse}th{padding:13px 16px;background:#183550;color:#9eb4c9;font-size:10px;text-transform:uppercase;letter-spacing:.7px;text-align:left}td{padding:14px 16px;color:#e1ebf4;font-size:12px;border-bottom:1px solid rgba(70,98,122,.42)}tr:hover{background:rgba(32,201,151,.045)}.client{display:flex;align-items:center;gap:10px}.avatar{width:37px;height:37px;border-radius:50%;background:#173b57;color:#75e6c2;border:1px solid #456984;display:flex;align-items:center;justify-content:center;font-weight:800}.name{font-weight:700;color:#f2f8fc}.email{color:#829bb0;font-size:10px;margin-top:2px}.status{display:inline-flex;padding:5px 9px;border-radius:20px;font-size:9px;font-weight:800}.pending{color:#ffd66f;background:rgba(255,200,87,.11)}.confirmed{color:#75e6c2;background:rgba(32,201,151,.11)}.completed{color:#82c7ff;background:rgba(76,160,220,.11)}.cancelled{color:#ff91a2;background:rgba(255,107,129,.11)}.other{color:#b8cad9;background:rgba(255,255,255,.07)}.empty{padding:75px 20px;text-align:center;color:#8299ad}.empty i{font-size:38px;color:#466982;margin-bottom:12px}.footer{padding:13px 18px;border-top:1px solid #355774;color:#7891a7;font-size:10px}.status-form{margin:0}.status-change{min-width:118px;height:34px;padding:0 9px;border-radius:9px;border:1px solid #41647f;background:#132e4a;color:#eaf5f3;font-size:10px;font-weight:700;outline:none;cursor:pointer}.status-change:focus{border-color:#20c997;box-shadow:0 0 0 2px rgba(32,201,151,.12)}
@@media(max-width:1050px){.stats{grid-template-columns:repeat(2,1fr)}}@@media(max-width:700px){.toolbar{flex-direction:column}.search{max-width:none}.filter{width:100%}}@@media(max-width:500px){.stats{grid-template-columns:1fr}.app-page{padding:15px}}
</style>

</head>
<body>
    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-icon"><i class="fa-solid fa-dumbbell"></i></div>
            <div class="brand-text">Health<span>Track</span></div>
        </div>

        <div class="side-profile">
            @if (!string.IsNullOrWhiteSpace(profilePath))
            {
                <img src="@profilePath" class="side-profile-image" alt="Trainer" />
            }
            else
            {
                <div class="side-profile-fallback">@trainerInitial</div>
            }

            <div class="side-profile-info">
                <div class="side-profile-name">@trainerName</div>
                <div class="side-profile-role">Trainer</div>
            </div>
        </div>

        <div class="menu-title">MAIN MENU</div>

        <nav class="sidebar-menu">
            <a href="@Url.Action("TrainerDashboard", "Home")" class="menu-item">
                <i class="fa-solid fa-chart-line"></i>
                <span>Dashboard</span>
            </a>

            <a href="@Url.Action("MyClients", "Home")" class="menu-item active">
                <i class="fa-solid fa-users"></i>
                <span>My Clients</span>
                <i class="fa-solid fa-chevron-right menu-arrow"></i>
            </a>

            <a href="@Url.Action("TrainerAppointments", "Home")" class="menu-item">
                <i class="fa-regular fa-calendar-check"></i>
                <span>Appointments</span>
                <i class="fa-solid fa-chevron-right menu-arrow"></i>
            </a>

            <a href="@Url.Action("TrainerWorkoutPlans", "Home")" class="menu-item">
                <i class="fa-solid fa-dumbbell"></i>
                <span>Workout Plans</span>
                <i class="fa-solid fa-chevron-right menu-arrow"></i>
            </a>

            <a href="@Url.Action("TrainerDietPlans", "Home")" class="menu-item">
                <i class="fa-solid fa-apple-whole"></i>
                <span>Diet Plans</span>
                <i class="fa-solid fa-chevron-right menu-arrow"></i>
            </a>

            <a href="@Url.Action("TrainerHealthRecords", "Home")" class="menu-item">
                <i class="fa-solid fa-chart-simple"></i>
                <span>Progress Reports</span>
                <i class="fa-solid fa-chevron-right menu-arrow"></i>
            </a>

            <a href="#" class="menu-item">
                <i class="fa-solid fa-message"></i>
                <span>Messages</span>
                <span class="menu-arrow">0</span>
            </a>

            <a href="#" class="menu-item">
                <i class="fa-regular fa-bell"></i>
                <span>Notifications</span>
            </a>
        </nav>

        <div class="sidebar-bottom">
            <div class="sidebar-motivation">
                STRONGER <span>PEOPLE</span><br />HEALTHIER TOMORROW
            </div>
            <div class="motivation-line"></div>
        </div>
    </aside>
<main class="main">
        <header class="topbar">

            <div>
                <div class="page-title">My Clients</div>
                <div class="page-subtitle">
                    Manage and monitor your assigned clients
                </div>
            </div>

            <div class="trainer-box">
                @{
                    var profileImage = ViewBag.ProfileImage as string;
                }

                @if (!string.IsNullOrWhiteSpace(profileImage))
                {
                    <img src="@profileImage" class="trainer-avatar" alt="Trainer" />
                }
                else
                {
                    <div class="trainer-avatar d-flex align-items-center justify-content-center">
                        <i class="fa-solid fa-user" style="color:#8da5bc;"></i>
                    </div>
                }

                <div>
                    <div class="trainer-name">@ViewBag.UserName</div>
                    <div class="trainer-role">Trainer</div>
                </div>
            </div>

        </header>

        <section class="app-page">
            <div class="hero">
                <div>
                    <div style="color:#73e4c2;font-size:10px;font-weight:800;letter-spacing:1.1px;text-transform:uppercase;margin-bottom:7px;">Trainer Workspace</div>
                    <h1>Appointments</h1>
                    <p>Manage and review all appointments assigned to you.</p>
                </div>
                <div class="hero-icon"><i class="fa-regular fa-calendar-check"></i></div>
            </div>

            <div class="stats">
                <div class="stat"><div class="stat-icon"><i class="fa-regular fa-calendar"></i></div><div class="stat-num">@totalAppointments</div><div class="stat-label">Total Appointments</div></div>
                <div class="stat"><div class="stat-icon"><i class="fa-regular fa-clock"></i></div><div class="stat-num">@pendingAppointments</div><div class="stat-label">Pending</div></div>
                <div class="stat"><div class="stat-icon"><i class="fa-solid fa-circle-check"></i></div><div class="stat-num">@confirmedAppointments</div><div class="stat-label">Confirmed</div></div>
                <div class="stat"><div class="stat-icon"><i class="fa-solid fa-check-double"></i></div><div class="stat-num">@completedAppointments</div><div class="stat-label">Completed</div></div>
            </div>

            <div class="toolbar">
                <div class="search"><i class="fa-solid fa-magnifying-glass"></i><input id="appointmentSearch" type="text" placeholder="Search client, email, reason or status..." /></div>
                <select id="statusFilter" class="filter">
                    <option value="">All Status</option>
                    <option>Pending</option><option>Confirmed</option><option>Completed</option><option>Cancelled</option>
                </select>
            </div>

            <div class="card">
                <div class="card-head">
                    <div class="card-title"><i class="fa-regular fa-calendar-check"></i>My Appointments</div>
                    <div class="count">@totalAppointments appointment(s)</div>
                </div>

                <div class="table-wrap">
                @if (appointmentList.Count == 0)
                {
                    <div class="empty"><i class="fa-regular fa-calendar-xmark"></i><div style="font-size:15px;color:#dbe8f3;font-weight:700;">No Appointments Found</div><div>You currently have no appointments assigned to you.</div></div>
                }
                else
                {
                    <table id="appointmentsTable">
                        <thead><tr><th>Client</th><th>Date & Time</th><th>Reason</th><th>Status</th><th>Notes</th><th>Action</th></tr></thead>
                        <tbody>
                        @foreach (var appointment in appointmentList)
                        {
                            var clientName = appointment.Client?.FullName ?? "Client";
                            var clientEmail = appointment.Client?.Email ?? "";
                            var initial = string.IsNullOrWhiteSpace(clientName) ? "C" : clientName.Trim().Substring(0,1).ToUpper();
                            var status = string.IsNullOrWhiteSpace(appointment.Status) ? "Pending" : appointment.Status.Trim();
                            var statusClass = status.Equals("Pending", StringComparison.OrdinalIgnoreCase) ? "pending" :
                                              status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) ? "confirmed" :
                                              status.Equals("Completed", StringComparison.OrdinalIgnoreCase) ? "completed" :
                                              status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) ? "cancelled" : "other";
                            <tr class="appointment-row" data-search="@clientName @clientEmail @appointment.Reason @status @appointment.Notes" data-status="@status">
                                <td><div class="client"><div class="avatar">@initial</div><div><div class="name">@clientName</div>@if(!string.IsNullOrWhiteSpace(clientEmail)){<div class="email">@clientEmail</div>}</div></div></td>
                                <td><strong>@appointment.AppointmentDate.ToString("dd MMM yyyy")</strong><div class="email">@appointment.AppointmentTime.ToString("hh:mm tt")</div></td>
                                <td>@(string.IsNullOrWhiteSpace(appointment.Reason) ? "—" : appointment.Reason)</td>
                                <td>
                                    <span class="status @statusClass">@status</span>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(appointment.Notes) ? "—" : appointment.Notes)</td>
                                <td>
                                    <form method="post"
                                          action="@Url.Action("UpdateTrainerAppointmentStatus", "Home")"
                                          class="status-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="appointmentId" value="@appointment.AppointmentId" />
                                        <select name="status"
                                                class="status-change"
                                                onchange="this.form.submit()"
                                                title="Change appointment status">
                                            <option value="Pending" selected="@(status.Equals("Pending", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Pending</option>
                                            <option value="Confirmed" selected="@(status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Confirmed</option>
                                            <option value="Approved" selected="@(status.Equals("Approved", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Approved</option>
                                            <option value="Completed" selected="@(status.Equals("Completed", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Completed</option>
                                            <option value="Cancelled" selected="@(status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Cancelled</option>
                                        </select>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                </div>
                <div class="footer"><i class="fa-solid fa-shield-halved"></i> Showing appointments assigned to the logged-in trainer only.</div>
            </div>
        </section>

</main>

<script>
const search=document.getElementById("appointmentSearch"), filter=document.getElementById("statusFilter");
function applyFilter(){
 const q=(search?.value||"").toLowerCase().trim(), st=(filter?.value||"").toLowerCase();
 document.querySelectorAll(".appointment-row").forEach(r=>{
   const text=(r.dataset.search||"").toLowerCase(), rs=(r.dataset.status||"").toLowerCase();
   r.style.display=(!q||text.includes(q))&&(!st||rs===st)?"":"none";
 });
}
search?.addEventListener("input",applyFilter); filter?.addEventListener("change",applyFilter);
</script>

</body>
</html>
