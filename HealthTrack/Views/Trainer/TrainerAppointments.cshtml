        /* =========================================================
           PREMIUM CLIENT CHAT DRAWER
           ========================================================= */
        .chat-overlay {
            position: fixed;
            inset: 0;
            background: rgba(2, 10, 20, .58);
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
            opacity: 0;
            visibility: hidden;
            transition: .25s ease;
            z-index: 1900;
        }

        .chat-overlay.show {
            opacity: 1;
            visibility: visible;
        }

        .chat-drawer {
            position: fixed;
            top: 0;
            right: -455px;
            width: 440px;
            height: 100vh;
            display: flex;
            flex-direction: column;
            background: linear-gradient(180deg, #0b2239 0%, #081a2d 100%);
            border-left: 1px solid rgba(65, 108, 139, .55);
            box-shadow: -18px 0 45px rgba(0,0,0,.35);
            z-index: 2000;
            transition: right .28s cubic-bezier(.22,.61,.36,1);
        }

        .chat-drawer.open {
            right: 0;
        }

        .chat-drawer-header {
            min-height: 78px;
            padding: 14px 17px;
            display: flex;
            align-items: center;
