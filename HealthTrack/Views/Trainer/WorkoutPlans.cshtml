@using System
@using System.Linq
@using HealthTrack.Models

@{
    ViewData["Title"] = "Workout Plans";
    Layout = null;

    var trainerName = ViewBag.UserName ?? "Trainer";
    var profileImage = ViewBag.ProfileImage;

    var trainerInitial = string.IsNullOrWhiteSpace(trainerName.ToString())
        ? "T"
        : trainerName.ToString().Trim().Substring(0, 1).ToUpper();

    string profilePath = "";

    if (profileImage != null && !string.IsNullOrWhiteSpace(profileImage.ToString()))
    {
        profilePath = profileImage.ToString().Trim();

        if (!profilePath.StartsWith("/images/", StringComparison.OrdinalIgnoreCase))
        {
            profilePath = "/images/" + profilePath.TrimStart('/');
        }
    }

    var workoutPlans =
        ViewBag.WorkoutPlans as IEnumerable<WorkoutPlan>
        ?? Enumerable.Empty<WorkoutPlan>();

    var clients =
        ViewBag.Clients as IEnumerable<User>
        ?? Enumerable.Empty<User>();

    var search = ViewBag.Search?.ToString() ?? "";

    int totalPlans = ViewBag.TotalWorkoutPlans ?? workoutPlans.Count();
    int activePlans = ViewBag.ActiveWorkoutPlans ?? 0;
    int completedPlans = ViewBag.CompletedWorkoutPlans ?? 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Workout Plans - HealthTrack</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <style>

        :root {
            --navy: #071a2f;
            --navy-2: #0b2545;
            --navy-3: #12365d;
            --emerald: #20c997;
            --emerald-dark: #149b76;
            --text: #eef6ff;
            --muted: #9db0c6;
            --card: #203c5c;
            --card-2: #294966;
            --border: #365876;
            --danger: #ff6b81;
            --warning: #ffc857;
            --blue: #4ea8ff;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Segoe UI", Arial, sans-serif;
            background:
                radial-gradient(circle at 85% 10%, rgba(32,201,151,.10), transparent 25%),
                linear-gradient(135deg, #061629 0%, #0a203a 55%, #071a2f 100%);
            color: var(--text);
        }

        /* =====================================================
           SIDEBAR - SAME AS MY CLIENTS
        ===================================================== */

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 245px;
            height: 100vh;
            background: linear-gradient(180deg, #061522 0%, #0B2438 55%, #04101C 100%);
            color: white;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            box-shadow: 5px 0 30px rgba(0,0,0,.22);
            overflow-y: auto;
            scrollbar-width: thin;
        }

        .sidebar::-webkit-scrollbar {
            width: 5px;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: #00B894;
            border-radius: 10px;
        }

        .brand {
            height: 82px;
            display: flex;
            align-items: center;
            padding: 0 22px;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }

        .brand-icon {
            width: 43px;
            height: 43px;
            border-radius: 12px;
            background: #00B894;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            box-shadow: 0 7px 20px rgba(0,184,148,.30);
        }

        .brand-text {
            margin-left: 12px;
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -.6px;
        }

        .brand-text span {
            color: #00B894;
        }

        .side-profile {
            margin: 18px 15px 10px;
            padding: 14px;
            border-radius: 15px;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.06);
            display: flex;
            align-items: center;
        }

        .side-profile-image,
        .side-profile-fallback {
            width: 48px;
            height: 48px;
            border-radius: 50%;
        }

        .side-profile-image {
            object-fit: cover;
            border: 2px solid #00B894;
            background: #222;
        }

        .side-profile-fallback {
            background: #00B894;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }

        .side-profile-info {
            margin-left: 11px;
            min-width: 0;
        }

        .side-profile-name {
            color: white;
            font-size: 14px;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .side-profile-role {
            color: #aaa;
            font-size: 11px;
            margin-top: 4px;
            text-transform: uppercase;
        }

        .menu-title {
            padding: 13px 22px 8px;
            color: #777;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
        }

        .sidebar-menu {
            padding: 0 10px 25px;
        }

        .menu-item {
            height: 46px;
            margin-bottom: 5px;
            padding: 0 14px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 13px;
            color: #d7d7d7;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: .2s ease;
        }

        .menu-item i {
            width: 20px;
            text-align: center;
            font-size: 15px;
        }

        .menu-item:hover {
            background: rgba(255,255,255,.08);
            color: white;
            transform: translateX(2px);
        }

        .menu-item.active {
            background: #00B894;
            color: white;
            box-shadow: 0 7px 18px rgba(0,184,148,.30);
        }

        .menu-arrow {
            margin-left: auto;
            font-size: 10px;
            color: #888;
        }

        .menu-item.active .menu-arrow {
            color: white;
        }

        .sidebar-bottom {
            margin-top: auto;
            padding: 18px 18px 22px;
            border-top: 1px solid rgba(255,255,255,.06);
        }

        .sidebar-motivation {
            color: white;
            font-size: 14px;
            line-height: 1.25;
            font-weight: 800;
        }

        .sidebar-motivation span {
            color: #00B894;
        }

        .motivation-line {
            width: 42px;
            height: 3px;
            background: #00B894;
            margin-top: 10px;
            border-radius: 5px;
        }

        /* =====================================================
           MAIN / TOPBAR
        ===================================================== */

        .main {
            margin-left: 245px;
            min-height: 100vh;
        }

        .topbar {
            height: 86px;
            padding: 0 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: linear-gradient(90deg, rgba(7,26,47,.98), rgba(13,47,78,.95));
            border-bottom: 1px solid rgba(255,255,255,.07);
            position: sticky;
            top: 0;
            z-index: 500;
            box-shadow: 0 8px 30px rgba(0,0,0,.16);
        }

        .page-title {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -.4px;
        }

        .page-subtitle {
            color: #8fa6bd;
            font-size: 12px;
            margin-top: 4px;
        }

        .trainer-box {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .trainer-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #20c997;
            background: #183752;
        }

        .trainer-name {
            font-size: 13px;
            font-weight: 700;
        }

        .trainer-role {
            color: #8da5bc;
            font-size: 10px;
            text-transform: uppercase;
            margin-top: 3px;
        }

        .content {
            padding: 26px 30px 40px;
        }

        /* =====================================================
           STATS
        ===================================================== */

        .stats {
            display: grid;
            grid-template-columns: repeat(4, minmax(0,1fr));
            gap: 15px;
            margin-bottom: 22px;
        }

        .stat-card {
            background: linear-gradient(145deg, #203c5c, #17344f);
            border: 1px solid #365876;
            border-radius: 17px;
            padding: 19px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 12px 30px rgba(0,0,0,.12);
        }

        .stat-card::after {
            content: "";
            position: absolute;
            width: 90px;
            height: 90px;
            border-radius: 50%;
            right: -30px;
            top: -35px;
            background: rgba(32,201,151,.08);
        }

        .stat-icon {
            width: 39px;
            height: 39px;
            border-radius: 11px;
            background: rgba(32,201,151,.15);
            color: #20c997;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 13px;
        }

        .stat-value {
            font-size: 27px;
            font-weight: 800;
        }

        .stat-label {
            color: #9db0c6;
            font-size: 11px;
            margin-top: 4px;
        }

        /* =====================================================
           TOOLBAR
        ===================================================== */

        .toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 22px;
        }

        .search-box {
            flex: 1;
            max-width: 520px;
            height: 45px;
            background: #173550;
            border: 1px solid #365876;
            border-radius: 12px;
            display: flex;
            align-items: center;
            padding: 0 15px;
        }

        .search-box i {
            color: #6f8aa4;
            margin-right: 10px;
        }

        .search-box input {
            width: 100%;
            border: 0;
            outline: 0;
            background: transparent;
            color: white;
            font-size: 12px;
        }

        .search-box input::placeholder {
            color: #708aa3;
        }

        .new-plan-btn {
            height: 45px;
            border: 0;
            border-radius: 12px;
            padding: 0 18px;
            background: linear-gradient(135deg, #20c997, #12a77d);
            color: white;
            font-size: 12px;
            font-weight: 800;
            box-shadow: 0 9px 20px rgba(32,201,151,.20);
        }

        .new-plan-btn:hover {
            transform: translateY(-1px);
            filter: brightness(1.05);
        }

        /* =====================================================
           PLAN CARDS
        ===================================================== */

        .plans-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0,1fr));
            gap: 18px;
        }

        .plan-card {
            background: linear-gradient(145deg, #203c5c 0%, #183550 100%);
            border: 1px solid #365876;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(0,0,0,.16);
            transition: .2s ease;
        }

        .plan-card:hover {
            transform: translateY(-2px);
            border-color: rgba(32,201,151,.55);
            box-shadow: 0 18px 38px rgba(0,0,0,.23);
        }

        .plan-head {
            padding: 19px 20px;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            border-bottom: 1px solid rgba(255,255,255,.07);
            background: linear-gradient(135deg, rgba(32,201,151,.08), rgba(78,168,255,.06));
        }

        .plan-icon {
            width: 45px;
            height: 45px;
            flex: 0 0 45px;
            border-radius: 13px;
            background: rgba(32,201,151,.15);
            color: #20c997;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .plan-title-wrap {
            flex: 1;
            min-width: 0;
        }

        .plan-title {
            font-size: 16px;
            font-weight: 800;
            color: #f4f9ff;
            word-break: break-word;
        }

        .plan-id {
            color: #7891a7;
            font-size: 10px;
            margin-top: 4px;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 9px;
            font-weight: 800;
            white-space: nowrap;
            text-transform: uppercase;
        }

        .status-active {
            color: #69e8bd;
            background: rgba(32,201,151,.12);
            border: 1px solid rgba(32,201,151,.25);
        }

        .status-completed {
            color: #8ecbff;
            background: rgba(78,168,255,.12);
            border: 1px solid rgba(78,168,255,.25);
        }

        .status-inactive,
        .status-cancelled {
            color: #ff9aaa;
            background: rgba(255,107,129,.10);
            border: 1px solid rgba(255,107,129,.22);
        }

        .status-default {
            color: #ffd977;
            background: rgba(255,200,87,.10);
            border: 1px solid rgba(255,200,87,.22);
        }

        .plan-body {
            padding: 18px 20px;
        }

        .description {
            color: #aebed0;
            font-size: 12px;
            line-height: 1.65;
            min-height: 42px;
            margin-bottom: 16px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0,1fr));
            gap: 10px;
            margin-bottom: 16px;
        }

        .info-box {
            padding: 11px;
            border-radius: 11px;
            background: rgba(255,255,255,.045);
            border: 1px solid rgba(255,255,255,.06);
        }

        .info-label {
            color: #718ba4;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .7px;
            margin-bottom: 5px;
        }

        .info-value {
            color: #eaf4ff;
            font-size: 11px;
            font-weight: 700;
            word-break: break-word;
        }

        .client-section {
            border-top: 1px solid rgba(255,255,255,.07);
            padding-top: 15px;
        }

        .client-title {
            color: #819ab2;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .8px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .client-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .client-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #20c997;
            color: #062017;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 900;
            flex: 0 0 36px;
        }

        .client-name {
            color: #eaf4ff;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 2px;
        }

        .client-email {
            color: #718ba4;
            font-size: 9px;
        }

        .assign-form {
            margin-top: 12px;
            display: flex;
            gap: 8px;
        }

        .assign-form select {
            flex: 1;
            min-width: 0;
            height: 38px;
            padding: 0 10px;
            border-radius: 9px;
            border: 1px solid #3b5d79;
            background: #112d48;
            color: #eaf4ff;
            outline: none;
            font-size: 10px;
        }

        .assign-form button {
            height: 38px;
            padding: 0 12px;
            border: 0;
            border-radius: 9px;
            background: #20c997;
            color: #062017;
            font-size: 10px;
            font-weight: 900;
            white-space: nowrap;
        }

        .assign-form button:hover {
            filter: brightness(1.06);
        }

        .plan-footer {
            padding: 13px 20px;
            border-top: 1px solid rgba(255,255,255,.07);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        .created-text {
            color: #718ba4;
            font-size: 9px;
        }

        .edit-btn {
            border: 1px solid #3b5d79;
            background: #15334f;
            color: #cce0f2;
            border-radius: 8px;
            padding: 7px 11px;
            font-size: 9px;
            font-weight: 700;
        }

        .edit-btn:hover {
            border-color: #20c997;
            color: #20c997;
        }

        /* =====================================================
           EMPTY STATE
        ===================================================== */

        .empty-state {
            grid-column: 1 / -1;
            padding: 70px 25px;
            text-align: center;
            background: #183550;
            border: 1px dashed #42637f;
            border-radius: 18px;
        }

        .empty-state i {
            font-size: 45px;
            color: #20c997;
            margin-bottom: 15px;
        }

        .empty-state h4 {
            margin: 0 0 7px;
            font-size: 18px;
        }

        .empty-state p {
            color: #829bb3;
            font-size: 11px;
            margin: 0;
        }

        /* =====================================================
           MODAL
        ===================================================== */

        .modal-content {
            background: #102d49;
            border: 1px solid #365876;
            color: #eef6ff;
            border-radius: 17px;
        }

        .modal-header {
            border-bottom: 1px solid #294965;
        }

        .modal-footer {
            border-top: 1px solid #294965;
        }

        .modal-title {
            font-size: 17px;
            font-weight: 800;
        }

        .form-label {
            color: #a9bdd0;
            font-size: 10px;
            font-weight: 700;
        }

        .form-control,
        .form-select {
            background: #0c2742;
            color: #eef6ff;
            border: 1px solid #385b77;
            border-radius: 9px;
            font-size: 11px;
        }

        .form-control:focus,
        .form-select:focus {
            background: #0c2742;
            color: white;
            border-color: #20c997;
            box-shadow: 0 0 0 2px rgba(32,201,151,.12);
        }

        .btn-save {
            background: #20c997;
            border: 0;
            color: #062017;
            font-weight: 800;
            font-size: 11px;
            border-radius: 9px;
            padding: 9px 15px;
        }

        .btn-cancel {
            background: #173650;
            border: 1px solid #3b5d79;
            color: #b8cbe0;
            font-size: 11px;
            border-radius: 9px;
            padding: 9px 15px;
        }

        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @@media (max-width: 1150px) {
            .stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .plans-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 800px) {
            .sidebar {
                width: 72px;
            }

            .brand {
                justify-content: center;
                padding: 0;
            }

            .brand-text,
            .menu-title,
            .menu-item span,
            .side-profile-info,
            .sidebar-bottom {
                display: none;
            }

            .brand-icon {
                margin: 0;
            }

            .menu-item {
                justify-content: center;
                padding: 0;
            }

            .menu-arrow {
                display: none;
            }

            .main {
                margin-left: 72px;
            }

            .content {
                padding: 18px;
            }

            .topbar {
                padding: 0 18px;
            }

            .trainer-name,
            .trainer-role {
                display: none;
            }
        }

        @@media (max-width: 600px) {
            .stats {
                grid-template-columns: 1fr;
            }

            .toolbar {
                flex-direction: column;
                align-items: stretch;
            }

            .search-box {
                max-width: none;
            }

            .new-plan-btn {
                width: 100%;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }
        }

    </style>
</head>

<body>

    <!-- =====================================================
         SIDEBAR
    ===================================================== -->

    <aside class="sidebar">

        <div class="brand">
            <div class="brand-icon">
                <i class="fa-solid fa-dumbbell"></i>
            </div>

            <div class="brand-text">
                Health<span>Track</span>
            </div>
        </div>

        <div class="side-profile">

            @if (!string.IsNullOrWhiteSpace(profilePath))
            {
                <img src="@profilePath"
                     class="side-profile-image"
                     alt="Trainer" />
            }
            else
            {
                <div class="side-profile-fallback">
                    @trainerInitial
                </div>
            }

            <div class="side-profile-info">
                <div class="side-profile-name">
                    @trainerName
                </div>

                <div class="side-profile-role">
                    Trainer
                </div>
            </div>

        </div>

        <div class="menu-title">
            MAIN MENU
        </div>

        <nav class="sidebar-menu">

            <a href="@Url.Action("TrainerDashboard", "Home")"
               class="menu-item">
                <i class="fa-solid fa-chart-line"></i>
                <span>Dashboard</span>
            </a>

            <a href="@Url.Action("MyClients", "Home")"
               class="menu-item">
                <i class="fa-solid fa-users"></i>
                <span>My Clients</span>
                <i class="fa-solid fa-chevron-right menu-arrow"></i>
            </a>

            <a href="@Url.Action("TrainerAppointments", "Home")"
               class="menu-item">
                <i class="fa-regular fa-calendar-check"></i>
                <span>Appointments</span>
                <i class="fa-solid fa-chevron-right menu-arrow"></i>
            </a>

            <a href="@Url.Action("TrainerWorkoutPlans", "Home")"
               class="menu-item active">
                <i class="fa-solid fa-dumbbell"></i>
                <span>Workout Plans</span>
                <i class="fa-solid fa-chevron-right menu-arrow"></i>
            </a>

            <a href="@Url.Action("TrainerDietPlans", "Home")"
               class="menu-item">
                <i class="fa-solid fa-apple-whole"></i>
                <span>Diet Plans</span>
                <i class="fa-solid fa-chevron-right menu-arrow"></i>
            </a>

            <a href="@Url.Action("TrainerHealthRecords", "Home")"
               class="menu-item">
                <i class="fa-solid fa-chart-simple"></i>
                <span>Progress Reports</span>
                <i class="fa-solid fa-chevron-right menu-arrow"></i>
            </a>

            <a href="#"
               class="menu-item">
                <i class="fa-solid fa-message"></i>
                <span>Messages</span>
                <span class="menu-arrow">0</span>
            </a>

            <a href="#"
               class="menu-item">
                <i class="fa-regular fa-bell"></i>
                <span>Notifications</span>
            </a>

        </nav>

        <div class="sidebar-bottom">

            <div class="sidebar-motivation">
                STRONGER <span>PEOPLE</span><br />
                HEALTHIER TOMORROW
            </div>

            <div class="motivation-line"></div>

        </div>

    </aside>


    <!-- =====================================================
         MAIN
    ===================================================== -->

    <main class="main">

        <!-- TOPBAR -->

        <header class="topbar">

            <div>
                <div class="page-title">
                    Workout Plans
                </div>

                <div class="page-subtitle">
                    Create, manage and assign workout plans to your clients
                </div>
            </div>

            <div class="trainer-box">

                @if (!string.IsNullOrWhiteSpace(profilePath))
                {
                    <img src="@profilePath"
                         class="trainer-avatar"
                         alt="Trainer" />
                }
                else
                {
                    <div class="trainer-avatar d-flex align-items-center justify-content-center">
                        <i class="fa-solid fa-user"
                           style="color:#8da5bc;"></i>
                    </div>
                }

                <div>
                    <div class="trainer-name">
                        @trainerName
                    </div>

                    <div class="trainer-role">
                        Trainer
                    </div>
                </div>

            </div>

        </header>


        <!-- CONTENT -->

        <section class="content">

            <!-- =================================================
                 STATS
            ================================================= -->

            <div class="stats">

                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fa-solid fa-dumbbell"></i>
                    </div>

                    <div class="stat-value">
                        @totalPlans
                    </div>

                    <div class="stat-label">
                        Total Workout Plans
                    </div>
                </div>


                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fa-solid fa-bolt"></i>
                    </div>

                    <div class="stat-value">
                        @activePlans
                    </div>

                    <div class="stat-label">
                        Active Plans
                    </div>
                </div>


                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>

                    <div class="stat-value">
                        @completedPlans
                    </div>

                    <div class="stat-label">
                        Completed Plans
                    </div>
                </div>


                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>

                    <div class="stat-value">
                        @clients.Count()
                    </div>

                    <div class="stat-label">
                        Available Clients
                    </div>
                </div>

            </div>


            <!-- =================================================
                 TOOLBAR
            ================================================= -->

            <div class="toolbar">

                <form method="get"
                      action="@Url.Action("TrainerWorkoutPlans", "Home")"
                      class="search-box">

                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input type="text"
                           name="search"
                           value="@search"
                           placeholder="Search plan, client, description or status..." />

                </form>


                <button type="button"
                        class="new-plan-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#createPlanModal">

                    <i class="fa-solid fa-plus"></i>
                    &nbsp; Create Workout Plan

                </button>

            </div>


            <!-- =================================================
                 WORKOUT PLAN CARDS
            ================================================= -->

            <div class="plans-grid">

                @if (workoutPlans.Any())
                {
                    foreach (var plan in workoutPlans)
                    {
                        var status = string.IsNullOrWhiteSpace(plan.Status)
                            ? "Active"
                            : plan.Status.Trim();

                        var statusClass =
                            status.Equals("Active", StringComparison.OrdinalIgnoreCase)
                                ? "status-active"
                                : status.Equals("Completed", StringComparison.OrdinalIgnoreCase)
                                    ? "status-completed"
                                    : status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase)
                                        ? "status-cancelled"
                                        : status.Equals("Inactive", StringComparison.OrdinalIgnoreCase)
                                            ? "status-inactive"
                                            : "status-default";

                        var clientName =
                            plan.Client?.FullName ?? "Not Assigned";

                        var clientInitial =
                            string.IsNullOrWhiteSpace(clientName)
                                ? "C"
                                : clientName.Trim().Substring(0, 1).ToUpper();

                        <article class="plan-card">

                            <!-- PLAN HEADER -->

                            <div class="plan-head">

                                <div class="plan-icon">
                                    <i class="fa-solid fa-dumbbell"></i>
                                </div>

                                <div class="plan-title-wrap">

                                    <div class="plan-title">
                                        @plan.PlanName
                                    </div>

                                    <div class="plan-id">
                                        PLAN #@plan.WorkoutPlanId
                                    </div>

                                </div>

                                <span class="status-badge @statusClass">
                                    @status
                                </span>

                            </div>


                            <!-- PLAN BODY -->

                            <div class="plan-body">

                                <div class="description">
                                    @(string.IsNullOrWhiteSpace(plan.Description)
                                        ? "No description added for this workout plan."
                                        : plan.Description)
                                </div>


                                <div class="info-grid">

                                    <div class="info-box">

                                        <div class="info-label">
                                            Start Date
                                        </div>

                                        <div class="info-value">
                                            @plan.StartDate.ToString("dd MMM yyyy")
                                        </div>

                                    </div>


                                    <div class="info-box">

                                        <div class="info-label">
                                            End Date
                                        </div>

                                        <div class="info-value">
                                            @(plan.EndDate.HasValue
                                                ? plan.EndDate.Value.ToString("dd MMM yyyy")
                                                : "No end date")
                                        </div>

                                    </div>


                                    <div class="info-box">

                                        <div class="info-label">
                                            Plan Status
                                        </div>

                                        <div class="info-value">
                                            @status
                                        </div>

                                    </div>


                                    <div class="info-box">

                                        <div class="info-label">
                                            Created
                                        </div>

                                        <div class="info-value">
                                            @(plan.CreatedAt.HasValue
                                                ? plan.CreatedAt.Value.ToString("dd MMM yyyy")
                                                : "—")
                                        </div>

                                    </div>

                                </div>


                                <!-- CLIENT ASSIGNMENT -->

                                <div class="client-section">

                                    <div class="client-title">
                                        Assigned Client
                                    </div>

                                    <div class="client-row">

                                        <div class="client-avatar">
                                            @clientInitial
                                        </div>

                                        <div>

                                            <div class="client-name">
                                                @clientName
                                            </div>

                                            <div class="client-email">
                                                @(plan.Client?.Email ?? "No client assigned")
                                            </div>

                                        </div>

                                    </div>


                                    <!-- ASSIGN / REASSIGN -->

                                    <form method="post"
                                          action="@Url.Action("AssignTrainerWorkoutPlan", "Home")"
                                          class="assign-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="workoutPlanId"
                                               value="@plan.WorkoutPlanId" />

                                        <select name="clientId"
                                                required>

                                            <option value="">
                                                Select client to assign...
                                            </option>

                                            @foreach (var client in clients)
                                            {
                                                if (client.UserId == plan.ClientId)
                                                {
                                                    <option value="@client.UserId"
                                                            selected>
                                                        @client.FullName
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@client.UserId">
                                                        @client.FullName
                                                    </option>
                                                }
                                            }

                                        </select>

                                        <button type="submit">
                                            <i class="fa-solid fa-user-check"></i>
                                            Assign
                                        </button>

                                    </form>

                                </div>

                            </div>


                            <!-- PLAN FOOTER -->

                            <div class="plan-footer">

                                

                                <a href="@Url.Action("ViewWorkoutPlan", "Home", new { id = plan.WorkoutPlanId })"
                           class="edit-btn"
                           style="text-decoration:none; display:inline-flex; align-items:center; gap:6px;">

                                    <i class="fa-solid fa-eye"></i>
                                    View Plan

                                </a>

                            </div>

                        </article>


                        <!-- =================================================
                             EDIT PLAN MODAL
                        ================================================= -->

                        <div class="modal fade"
                             id="editPlanModal_@plan.WorkoutPlanId"
                             tabindex="-1"
                             aria-hidden="true">

                            <div class="modal-dialog modal-dialog-centered">

                                <div class="modal-content">

                                    <form method="post"
                                          action="@Url.Action("UpdateTrainerWorkoutPlan", "Home")">

                                        @Html.AntiForgeryToken()

                                        <div class="modal-header">

                                            <h5 class="modal-title">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                                Edit Workout Plan
                                            </h5>

                                            <button type="button"
                                                    class="btn-close btn-close-white"
                                                    data-bs-dismiss="modal"></button>

                                        </div>


                                        <div class="modal-body">

                                            <input type="hidden"
                                                   name="workoutPlanId"
                                                   value="@plan.WorkoutPlanId" />


                                            <div class="mb-3">

                                                <label class="form-label">
                                                    Plan Name
                                                </label>

                                                <input type="text"
                                                       name="planName"
                                                       class="form-control"
                                                       maxlength="150"
                                                       value="@plan.PlanName"
                                                       required />

                                            </div>


                                            <div class="mb-3">

                                                <label class="form-label">
                                                    Description
                                                </label>

                                                <textarea name="description"
                                                          class="form-control"
                                                          rows="3"
                                                          maxlength="500">@plan.Description</textarea>

                                            </div>


                                            <div class="row g-3">

                                                <div class="col-md-6">

                                                    <label class="form-label">
                                                        Assign Client
                                                    </label>

                                                    <select name="clientId"
                                                            class="form-select"
                                                            required>

                                                        @foreach (var client in clients)
                                                        {
                                                            if (client.UserId == plan.ClientId)
                                                            {
                                                                <option value="@client.UserId"
                                                                        selected>
                                                                    @client.FullName
                                                                </option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@client.UserId">
                                                                    @client.FullName
                                                                </option>
                                                            }
                                                        }

                                                    </select>

                                                </div>


                                                <div class="col-md-6">

                                                    <label class="form-label">
                                                        Status
                                                    </label>

                                                    <select name="status"
                                                            class="form-select">

                                                        <option value="Active"
                                                                selected="@(status.Equals("Active", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                                            Active
                                                        </option>

                                                        <option value="Completed"
                                                                selected="@(status.Equals("Completed", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                                            Completed
                                                        </option>

                                                        <option value="Inactive"
                                                                selected="@(status.Equals("Inactive", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                                            Inactive
                                                        </option>

                                                        <option value="Cancelled"
                                                                selected="@(status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                                            Cancelled
                                                        </option>

                                                    </select>

                                                </div>

                                            </div>


                                            <div class="row g-3 mt-1">

                                                <div class="col-md-6">

                                                    <label class="form-label">
                                                        Start Date
                                                    </label>

                                                    <input type="date"
                                                           name="startDate"
                                                           class="form-control"
                                                           value="@plan.StartDate.ToString("yyyy-MM-dd")"
                                                           required />

                                                </div>


                                                <div class="col-md-6">

                                                    <label class="form-label">
                                                        End Date
                                                    </label>

                                                    <input type="date"
                                                           name="endDate"
                                                           class="form-control"
                                                           value="@(plan.EndDate.HasValue ? plan.EndDate.Value.ToString("yyyy-MM-dd") : "")" />

                                                </div>

                                            </div>

                                        </div>


                                        <div class="modal-footer">

                                            <button type="button"
                                                    class="btn-cancel"
                                                    data-bs-dismiss="modal">
                                                Cancel
                                            </button>

                                            <button type="submit"
                                                    class="btn-save">
                                                <i class="fa-solid fa-floppy-disk"></i>
                                                Save Changes
                                            </button>

                                        </div>

                                    </form>

                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">

                        <i class="fa-solid fa-dumbbell"></i>

                        <h4>
                            No Workout Plans Found
                        </h4>

                        <p>
                            Create a workout plan and assign it to one of your clients.
                        </p>

                    </div>
                }

            </div>

        </section>

    </main>


    <!-- =====================================================
         CREATE PLAN MODAL
    ===================================================== -->

    <div class="modal fade"
         id="createPlanModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <form method="post"
                      action="@Url.Action("CreateTrainerWorkoutPlan", "Home")">

                    @Html.AntiForgeryToken()

                    <div class="modal-header">

                        <h5 class="modal-title">
                            <i class="fa-solid fa-plus"></i>
                            Create Workout Plan
                        </h5>

                        <button type="button"
                                class="btn-close btn-close-white"
                                data-bs-dismiss="modal"></button>

                    </div>


                    <div class="modal-body">

                        <div class="mb-3">

                            <label class="form-label">
                                Plan Name
                            </label>

                            <input type="text"
                                   name="planName"
                                   class="form-control"
                                   maxlength="150"
                                   placeholder="e.g. Muscle Building Program"
                                   required />

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Description
                            </label>

                            <textarea name="description"
                                      class="form-control"
                                      rows="3"
                                      maxlength="500"
                                      placeholder="Describe the workout plan..."></textarea>

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Assign Client
                            </label>

                            <select name="clientId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select client...
                                </option>

                                @foreach (var client in clients)
                                {
                                    <option value="@client.UserId">
                                        @client.FullName
                                    </option>
                                }

                            </select>

                        </div>


                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Start Date
                                </label>

                                <input type="date"
                                       name="startDate"
                                       class="form-control"
                                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       required />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    End Date
                                </label>

                                <input type="date"
                                       name="endDate"
                                       class="form-control" />

                            </div>

                        </div>


                        <div class="mt-3">

                            <label class="form-label">
                                Status
                            </label>

                            <select name="status"
                                    class="form-select">

                                <option value="Active">
                                    Active
                                </option>

                                <option value="Inactive">
                                    Inactive
                                </option>

                            </select>

                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn-cancel"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn-save">
                            <i class="fa-solid fa-plus"></i>
                            Create Plan
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
