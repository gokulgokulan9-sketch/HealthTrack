@{
    ViewData["Title"] = "My Clients";
    Layout = null;

    // Sidebar data only - keeps the existing My Clients page logic unchanged.
    var trainerName = ViewBag.UserName?.ToString() ?? "Trainer";
    var profileImage = ViewBag.ProfileImage?.ToString() ?? "";
    var trainerInitial = string.IsNullOrWhiteSpace(trainerName)
        ? "T"
        : trainerName.Trim().Substring(0, 1).ToUpper();

    var profilePath = profileImage.Trim();
    if (!string.IsNullOrWhiteSpace(profilePath) &&
        !profilePath.StartsWith("/images/", StringComparison.OrdinalIgnoreCase))
    {
        profilePath = "/images/" + profilePath.TrimStart('/');
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Clients - HealthTrack</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --navy: #071a2f;
            --navy-2: #0b2545;
            --navy-3: #12365d;
            --emerald: #20c997;
            --emerald-dark: #149b76;
            --text: #eef6ff;
            --muted: #9db0c6;
            --card: #203c5c;
            --card-2: #294966;
            --border: #365876;
            --danger: #ff6b81;
            --warning: #ffc857;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Segoe UI", Arial, sans-serif;
            background:
                radial-gradient(circle at 85% 10%, rgba(32,201,151,.10), transparent 25%),
                linear-gradient(135deg, #061629 0%, #0a203a 55%, #071a2f 100%);
            color: var(--text);
        }

            .sidebar {
                position: fixed;
                left: 0;
                top: 0;
                width: 245px;
                height: 100vh;
                background: linear-gradient( 180deg, #061522 0%, #0B2438 55%, #04101C 100% );
                color: white;
                z-index: 1000;
                display: flex;
                flex-direction: column;
                box-shadow: 5px 0 30px rgba(0,0,0,0.22);
                overflow-y: auto;
                scrollbar-width: thin;
            }

                .sidebar::-webkit-scrollbar {
                    width: 5px;
                }

                .sidebar::-webkit-scrollbar-thumb {
                    background: #00B894;
                    border-radius: 10px;
                }


            /* =====================================================
                       LOGO
                    ===================================================== */

            .brand {
                height: 82px;
                display: flex;
                align-items: center;
                padding: 0 22px;
                border-bottom: 1px solid rgba(255,255,255,0.06);
            }

            .brand-icon {
                width: 43px;
                height: 43px;
                border-radius: 12px;
                background: #00B894;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                box-shadow: 0 7px 20px rgba(239,35,60,0.30);
            }

            .brand-text {
                margin-left: 12px;
                font-size: 22px;
                font-weight: 800;
                letter-spacing: -0.6px;
            }

                .brand-text span {
                    color: #00B894;
                }


            /* =====================================================
                       PROFILE
                    ===================================================== */

            .side-profile {
                margin: 18px 15px 10px;
                padding: 14px;
                border-radius: 15px;
                background: rgba(255,255,255,0.06);
                border: 1px solid rgba(255,255,255,0.06);
                display: flex;
                align-items: center;
            }

            .side-profile-image {
                width: 48px;
                height: 48px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid #00B894;
                background: #222;
            }

            .side-profile-fallback {
                width: 48px;
                height: 48px;
                border-radius: 50%;
                background: #00B894;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
            }

            .side-profile-info {
                margin-left: 11px;
                min-width: 0;
            }

            .side-profile-name {
                color: white;
                font-size: 14px;
                font-weight: 700;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .side-profile-role {
                color: #aaa;
                font-size: 11px;
                margin-top: 4px;
                text-transform: uppercase;
            }


            /* =====================================================
                       MENU
                    ===================================================== */

            .menu-title {
                padding: 13px 22px 8px;
                color: #777;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1.2px;
            }

            .sidebar-menu {
                padding: 0 10px 25px;
            }

            .menu-item {
                height: 46px;
                margin-bottom: 5px;
                padding: 0 14px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                gap: 13px;
                color: #d7d7d7;
                text-decoration: none;
                font-size: 13px;
                font-weight: 500;
                transition: 0.2s ease;
            }

                .menu-item i {
                    width: 20px;
                    text-align: center;
                    font-size: 15px;
                }

                .menu-item:hover {
                    background: rgba(255,255,255,0.08);
                    color: white;
                    transform: translateX(2px);
                }

                .menu-item.active {
                    background: #00B894;
                    color: white;
                    box-shadow: 0 7px 18px rgba(239,35,60,0.30);
                }

            .menu-arrow {
                margin-left: auto;
                font-size: 10px;
                color: #888;
            }

            .menu-item.active .menu-arrow {
                color: white;
            }


            /* =====================================================
                       SIDEBAR BOTTOM
                    ===================================================== */

            .sidebar-bottom {
                margin-top: auto;
                padding: 18px 18px 22px;
                border-top: 1px solid rgba(255,255,255,0.06);
            }

            .sidebar-motivation {
                color: white;
                font-size: 14px;
                line-height: 1.25;
                font-weight: 800;
                text-transform: uppercase;
            }

                .sidebar-motivation span {
                    color: #00B894;
                }

            .motivation-line {
                width: 40px;
                height: 3px;
                background: #00B894;
                margin-top: 10px;
                border-radius: 5px;
            }



        .main {
            margin-left: 245px;
            min-height: 100vh;
        }

        .topbar {
            height: 78px;
            padding: 0 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: linear-gradient(90deg, #071a2f, #0a2544);
            border-bottom: 1px solid #1d3d5c;
            box-shadow: 0 8px 25px rgba(0,0,0,.16);
        }

        .page-title {
            font-size: 21px;
            font-weight: 750;
            margin: 0;
        }

        .page-subtitle {
            color: var(--muted);
            font-size: 12px;
            margin-top: 3px;
        }

        .trainer-box {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .trainer-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(32,201,151,.65);
            background: #173754;
        }

        .trainer-name {
            font-size: 13px;
            font-weight: 700;
        }

        .trainer-role {
            font-size: 11px;
            color: var(--muted);
        }

        .content {
            padding: 22px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 18px;
        }

        .stat-card,
        .main-card {
            background: linear-gradient(145deg, #294966, #1e3958);
            border: 1px solid #355a78;
            box-shadow: 0 12px 30px rgba(0,0,0,.18);
        }

        .stat-card {
            min-height: 112px;
            border-radius: 15px;
            padding: 17px;
            position: relative;
            overflow: hidden;
            border-top: 3px solid var(--emerald);
        }

        .stat-icon {
            width: 43px;
            height: 43px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(32,201,151,.12);
            color: var(--emerald);
            font-size: 18px;
            margin-bottom: 10px;
        }

        .stat-value {
            font-size: 25px;
            font-weight: 800;
            line-height: 1;
        }

        .stat-label {
            margin-top: 6px;
            color: #aebfd1;
            font-size: 12px;
        }

        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 15px;
        }

        .search-box {
            position: relative;
            max-width: 420px;
            width: 100%;
        }

        .search-box i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #7892aa;
        }

        .search-box input {
            width: 100%;
            height: 44px;
            padding: 0 15px 0 42px;
            border-radius: 11px;
            border: 1px solid #41647f;
            background: #132e4a;
            color: #fff;
            outline: none;
        }

        .search-box input::placeholder {
            color: #7892aa;
        }

        .search-box input:focus {
            border-color: var(--emerald);
            box-shadow: 0 0 0 3px rgba(32,201,151,.10);
        }

        .filter-select {
            height: 44px;
            min-width: 150px;
            border-radius: 11px;
            border: 1px solid #41647f;
            background: #132e4a;
            color: #dce9f5;
            padding: 0 12px;
        }

        .main-card {
            border-radius: 17px;
            overflow: hidden;
        }

        .card-header-custom {
            padding: 17px 20px;
            border-bottom: 1px solid #41617b;
            background: linear-gradient(90deg, #213f5e, #294966);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-header-custom h5 {
            margin: 0;
            font-size: 15px;
            font-weight: 750;
        }

        .client-count {
            color: #a8bdcf;
            font-size: 12px;
        }

        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 900px;
        }

        thead th {
            padding: 13px 17px;
            color: #9eb4c9;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .7px;
            background: #183550;
            border-bottom: 1px solid #3b5c77;
            white-space: nowrap;
        }

        tbody td {
            padding: 15px 17px;
            border-bottom: 1px solid rgba(70,98,122,.42);
            font-size: 13px;
            color: #e1ebf4;
            vertical-align: middle;
        }

        tbody tr {
            transition: .18s;
        }

        tbody tr:hover {
            background: rgba(32,201,151,.045);
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        .client-info {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .client-avatar {
            width: 39px;
            height: 39px;
            border-radius: 50%;
            object-fit: cover;
            background: #31536f;
            border: 1px solid #4c6d86;
        }

        .client-name {
            font-weight: 700;
            color: #fff;
        }

        .client-email {
            color: #8fa7bd;
            font-size: 11px;
            margin-top: 2px;
        }

        .badge-status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
        }

        .status-active {
            background: rgba(32,201,151,.12);
            color: #5ee7be;
        }

        .status-inactive {
            background: rgba(255,107,129,.12);
            color: #ff8da0;
        }

        .status-pending {
            background: rgba(255,200,87,.12);
            color: #ffd66f;
        }

        .mini-tag {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 7px;
            background: rgba(255,255,255,.06);
            color: #b9cadd;
            font-size: 10px;
            margin: 2px;
        }

        .action-btn {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            color: #9fb5ca;
            background: #173550;
            border: 1px solid #3c5e79;
            transition: .2s;
        }

        .action-btn:hover {
            color: var(--emerald);
            border-color: var(--emerald);
            background: rgba(32,201,151,.08);
        }

        .chat-client-banner {
            position: relative;
            overflow: hidden;
            min-height: 118px;
            margin: 20px 0 22px;
            padding: 20px 24px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 22px;
            background:
                radial-gradient(circle at 88% 30%, rgba(32,201,151,.16), transparent 28%),
                linear-gradient(135deg, #102f49 0%, #0b263e 52%, #0b2035 100%);
            border: 1px solid rgba(32,201,151,.28);
            box-shadow:
                0 16px 38px rgba(0,0,0,.24),
                inset 0 1px 0 rgba(255,255,255,.035),
                0 0 24px rgba(32,201,151,.055);
        }

        .chat-client-banner::before {
            content: "";
            position: absolute;
            width: 170px;
            height: 170px;
            right: 100px;
            top: -105px;
            border-radius: 50%;
            background: rgba(32,201,151,.055);
            pointer-events: none;
        }

        .chat-client-left {
            display: flex;
            align-items: center;
            gap: 16px;
            min-width: 0;
            position: relative;
            z-index: 1;
        }

        .chat-client-icon {
            width: 58px;
            height: 58px;
            flex: 0 0 58px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #062018;
            background: linear-gradient(135deg, #32dfad, #18b98e);
            box-shadow: 0 10px 26px rgba(32,201,151,.24);
            font-size: 23px;
        }

        .chat-client-copy h4 {
            margin: 0 0 5px;
            color: #f1fbf8;
            font-size: 18px;
            font-weight: 800;
            letter-spacing: .1px;
        }

        .chat-client-copy p {
            margin: 0;
            color: #9db6c9;
            font-size: 12px;
            line-height: 1.5;
        }

        .chat-client-copy .chat-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 8px;
            color: #71e7c2;
            font-size: 10px;
            font-weight: 700;
        }

        .chat-status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #20c997;
            box-shadow: 0 0 9px rgba(32,201,151,.75);
        }

        .open-chat-btn {
            position: relative;
            z-index: 1;
            flex: 0 0 auto;
            min-width: 150px;
            height: 45px;
            padding: 0 19px;
            border: 1px solid rgba(117,230,194,.36);
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            color: #062018;
            background: linear-gradient(135deg, #2fe0ad, #16b98b);
            text-decoration: none;
            font-size: 12px;
            font-weight: 800;
            box-shadow: 0 10px 24px rgba(32,201,151,.18);
            transition: .2s ease;
        }

        .open-chat-btn:hover {
            color: #03140f;
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(32,201,151,.28);
        }

        .open-chat-btn i:last-child {
            font-size: 10px;
        }

        .action-group {
            display: inline-flex;
            gap: 7px;
            align-items: center;
        }

        .action-btn.chat-action {
            color: #75e6c2;
            background: rgba(32,201,151,.08);
            border-color: rgba(117,230,194,.25);
        }

        .action-btn.chat-action:hover {
            color: #071b2b;
            background: var(--emerald);
            border-color: var(--emerald);
        }

        .modal-overlay{position:fixed;inset:0;z-index:2000;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(3,12,22,.78);backdrop-filter:blur(10px)}
        .premium-modal{width:min(720px,100%);max-height:90vh;overflow:auto;border-radius:22px;background:linear-gradient(145deg,#102b43,#0b2034);border:1px solid rgba(117,230,194,.20);box-shadow:0 30px 80px rgba(0,0,0,.50)}
        .premium-modal-header{display:flex;align-items:center;justify-content:space-between;padding:22px 24px;border-bottom:1px solid rgba(255,255,255,.08)}
        .premium-modal-title{display:flex;align-items:center;gap:13px}.premium-modal-title h5{margin:0;color:#edf8f4;font-weight:800}.premium-modal-title small{color:#87a0b4}
        .premium-modal-avatar{width:48px;height:48px;border-radius:15px;object-fit:cover;background:#173550;border:1px solid rgba(117,230,194,.18)}
        .modal-close{border:0;background:rgba(255,255,255,.06);color:#a7b9c9;width:36px;height:36px;border-radius:10px;cursor:pointer}.modal-close:hover{color:#fff;background:rgba(255,255,255,.10)}
        .profile-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;padding:22px 24px}.profile-info-box{padding:16px;border-radius:15px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.07)}
        .profile-info-box span{display:block;color:#7892a8;font-size:10px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px}.profile-info-box strong{color:#e9f4f1;font-size:14px}
        .chat-body{padding:22px 24px 24px}.chat-notice{padding:12px 14px;border-radius:13px;background:rgba(117,230,194,.07);border:1px solid rgba(117,230,194,.13);color:#9fc0b7;font-size:11px;margin-bottom:14px}
        .chat-messages{min-height:180px;max-height:300px;overflow-y:auto;padding:14px;border-radius:16px;background:rgba(3,17,29,.48);border:1px solid rgba(255,255,255,.06)}
        .chat-empty{min-height:150px;display:flex;align-items:center;justify-content:center;text-align:center;color:#718ba0;font-size:12px}.chat-composer{display:flex;gap:10px;margin-top:12px}
        .chat-composer input{flex:1;min-width:0;border:1px solid #294a64;background:#0d263d;color:#eaf6f2;border-radius:12px;padding:12px 14px;outline:none}.chat-composer input:focus{border-color:var(--emerald);box-shadow:0 0 0 3px rgba(117,230,194,.08)}
        .chat-send-btn{border:0;border-radius:12px;padding:0 17px;color:#062018;background:var(--emerald);font-weight:800;cursor:pointer}.chat-bubble{max-width:80%;margin-left:auto;margin-bottom:10px;padding:10px 13px;border-radius:14px 14px 4px 14px;background:rgba(117,230,194,.12);border:1px solid rgba(117,230,194,.14);color:#d9eee8;font-size:12px}
        .empty-state {
            text-align: center;
            padding: 65px 20px;
            color: #91a8bc;
        }

        .empty-state i {
            font-size: 42px;
            color: #45677f;
            margin-bottom: 15px;
        }

        .empty-state h5 {
            color: #dbe8f3;
            margin-bottom: 6px;
        }

        .footer-note {
            padding: 15px 20px;
            border-top: 1px solid #355774;
            color: #7891a7;
            font-size: 11px;
        }


        /* =========================================================
           PREMIUM CLIENT CHAT DRAWER
           ========================================================= */
        .chat-overlay {
            position: fixed;
            inset: 0;
            background: rgba(2, 10, 20, .58);
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
            opacity: 0;
            visibility: hidden;
            transition: .25s ease;
            z-index: 1900;
        }

        .chat-overlay.show {
            opacity: 1;
            visibility: visible;
        }

        .chat-drawer {
            position: fixed;
            top: 0;
            right: -455px;
            width: 440px;
            height: 100vh;
            display: flex;
            flex-direction: column;
            background: linear-gradient(180deg, #0b2239 0%, #081a2d 100%);
            border-left: 1px solid rgba(65, 108, 139, .55);
            box-shadow: -18px 0 45px rgba(0,0,0,.35);
            z-index: 2000;
            transition: right .28s cubic-bezier(.22,.61,.36,1);
        }

        .chat-drawer.open {
            right: 0;
        }

        .chat-drawer-header {
            min-height: 78px;
            padding: 14px 17px;
            display: flex;
            align-items: center;
            gap: 11px;
            border-bottom: 1px solid #21425e;
            background: linear-gradient(135deg, #102f4b, #0a2036);
        }

        .chat-header-avatar {
            width: 43px;
            height: 43px;
            flex: 0 0 43px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(32,201,151,.65);
            background: #173b57;
        }

        .chat-header-info {
            flex: 1;
            min-width: 0;
        }

        .chat-header-title {
            color: #f4fbff;
            font-size: 14px;
            font-weight: 800;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .chat-header-status {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-top: 3px;
            color: #72dfbd;
            font-size: 10px;
        }

        .chat-header-actions {
            display: flex;
            gap: 6px;
        }

        .chat-icon-btn {
            width: 35px;
            height: 35px;
            border-radius: 9px;
            border: 1px solid #315674;
            background: #122f49;
            color: #a8bfd1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: .18s ease;
        }

        .chat-icon-btn:hover {
            color: #fff;
            border-color: var(--emerald);
            background: rgba(32,201,151,.10);
        }

        .chat-close-btn:hover {
            color: #ff91a2;
            border-color: rgba(255,107,129,.55);
            background: rgba(255,107,129,.08);
        }

        .chat-client-list {
            padding: 12px 12px 8px;
            border-bottom: 1px solid #1d3d58;
            background: #0a1e32;
        }

        .chat-list-search {
            position: relative;
            margin-bottom: 9px;
        }

        .chat-list-search i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #718ba2;
            font-size: 12px;
        }

        .chat-list-search input {
            width: 100%;
            height: 38px;
            padding: 0 12px 0 35px;
            border-radius: 9px;
            border: 1px solid #2c506b;
            outline: none;
            background: #102b44;
            color: #eef7ff;
            font-size: 11px;
        }

        .chat-list-search input:focus {
            border-color: rgba(32,201,151,.75);
            box-shadow: 0 0 0 3px rgba(32,201,151,.08);
        }

        .chat-list {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 2px;
        }

        .chat-client-chip {
            flex: 0 0 auto;
            min-width: 125px;
            padding: 8px 9px;
            border-radius: 10px;
            border: 1px solid #254963;
            background: #102b44;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: .18s;
        }

        .chat-client-chip:hover,
        .chat-client-chip.active {
            border-color: rgba(32,201,151,.65);
            background: rgba(32,201,151,.08);
        }

        .chat-chip-avatar {
            width: 29px;
            height: 29px;
            flex: 0 0 29px;
            border-radius: 50%;
            object-fit: cover;
            background: #31536f;
            border: 1px solid #456984;
        }

        .chat-chip-name {
            max-width: 80px;
            color: #dfeaf3;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .chat-chip-status {
            margin-top: 2px;
            color: #718ba2;
            font-size: 9px;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 18px 15px;
            background:
                radial-gradient(circle at 20% 15%, rgba(32,201,151,.035), transparent 25%),
                linear-gradient(180deg, #081b2e, #07192a);
        }

        .chat-date-label {
            text-align: center;
            margin: 0 auto 16px;
            color: #67829a;
            font-size: 9px;
        }

        .chat-message-row {
            display: flex;
            margin-bottom: 12px;
        }

        .chat-message-row.client {
            justify-content: flex-start;
        }

        .chat-message-row.trainer {
            justify-content: flex-end;
        }

        .chat-bubble {
            max-width: 76%;
            padding: 10px 12px;
            border-radius: 13px;
            font-size: 11px;
            line-height: 1.5;
            position: relative;
        }

        .chat-message-row.client .chat-bubble {
            background: #163550;
            border: 1px solid #28516d;
            color: #dbe8f2;
            border-bottom-left-radius: 4px;
        }

        .chat-message-row.trainer .chat-bubble {
            background: linear-gradient(135deg, #169d79, #117f63);
            border: 1px solid rgba(117,230,194,.25);
            color: #effff9;
            border-bottom-right-radius: 4px;
        }

        .chat-time {
            display: block;
            margin-top: 5px;
            opacity: .62;
            font-size: 8px;
            text-align: right;
        }

        .chat-composer {
            padding: 11px 12px;
            border-top: 1px solid #21415c;
            background: #0a2035;
        }

        .chat-compose-row {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .chat-attach-btn,
        .chat-send-btn {
            width: 39px;
            height: 39px;
            flex: 0 0 39px;
            border-radius: 10px;
            border: 1px solid #315675;
            background: #122f49;
            color: #a7bed0;
            cursor: pointer;
        }

        .chat-send-btn {
            border-color: rgba(32,201,151,.45);
            background: linear-gradient(135deg, #22cf9f, #159f7b);
            color: #062018;
        }

        .chat-message-input {
            flex: 1;
            min-width: 0;
            height: 39px;
            border: 1px solid #315675;
            border-radius: 10px;
            background: #102d47;
            color: #fff;
            outline: none;
            padding: 0 12px;
            font-size: 11px;
        }

        .chat-message-input:focus {
            border-color: var(--emerald);
            box-shadow: 0 0 0 3px rgba(32,201,151,.08);
        }

        .call-panel {
            position: absolute;
            inset: 0;
            z-index: 5;
            display: none;
            flex-direction: column;
            background: #061522;
        }

        .call-panel.show {
            display: flex;
        }

        .call-topbar {
            height: 64px;
            padding: 0 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #1f425c;
            background: #0a2034;
        }

        .call-title {
            color: #f2fbff;
            font-size: 13px;
            font-weight: 800;
        }

        .call-subtitle {
            color: #7894aa;
            font-size: 9px;
            margin-top: 2px;
        }

        .call-stage {
            flex: 1;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(circle at 50% 40%, rgba(32,201,151,.10), transparent 27%),
                #05121f;
        }

        .call-avatar-large {
            width: 112px;
            height: 112px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(32,201,151,.72);
            box-shadow: 0 0 0 12px rgba(32,201,151,.045), 0 18px 45px rgba(0,0,0,.45);
            background: #173b57;
        }

        .call-name {
            position: absolute;
            bottom: 78px;
            color: #eaf7ff;
            font-size: 14px;
            font-weight: 800;
        }

        .call-status {
            position: absolute;
            bottom: 58px;
            color: #6ee4bd;
            font-size: 10px;
        }

        .call-controls {
            min-height: 78px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            background: #0a2034;
            border-top: 1px solid #1e4059;
        }

        .call-control {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: 1px solid #315675;
            background: #132f48;
            color: #c8d8e5;
            cursor: pointer;
        }

        .call-control:hover {
            border-color: var(--emerald);
            color: #fff;
        }

        .call-control.end {
            background: #d94b63;
            border-color: #ee7185;
            color: #fff;
        }

        .chat-no-clients {
            padding: 18px;
            color: #7992a8;
            font-size: 10px;
            text-align: center;
        }

        @@media (max-width: 760px) {
            .chat-client-banner {
                align-items: flex-start;
                flex-direction: column;
                padding: 18px;
            }

            .open-chat-btn {
                width: 100%;
            }

            .chat-client-left {
                align-items: flex-start;
            }
        }

        @@media (max-width: 1100px) {
            .stats {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 800px) {
            .sidebar {
                width: 72px;
            }

            .brand {
                justify-content: center;
                padding: 0;
            }

            .brand-title,
            .brand-sub,
            .nav-section,
            .nav-link span {
                display: none;
            }

            .brand-icon {
                margin: 0;
            }

            .nav-link {
                justify-content: center;
                padding: 12px !important;
            }

            .main {
                margin-left: 72px;
            }

            .content {
                padding: 15px;
            }

            .topbar {
                padding: 0 15px;
            }

            .trainer-name,
            .trainer-role {
                display: none;
            }
        }

        @@media (max-width: 600px) {
            .stats {
                grid-template-columns: 1fr;
            }

            .toolbar {
                flex-direction: column;
                align-items: stretch;
            }

            .search-box {
                max-width: none;
            }
        }
    </style>
</head>

<body>

    <!-- SIDEBAR - SAME DESIGN AS TRAINER DASHBOARD -->
    <aside class="sidebar">

        <div class="brand">
            <div class="brand-icon">
                <i class="fa-solid fa-dumbbell"></i>
            </div>
            <div class="brand-text">
                Health<span>Track</span>
            </div>
        </div>

        <div class="side-profile">
            @if (!string.IsNullOrWhiteSpace(profilePath))
            {
                <img src="@profilePath" class="side-profile-image" alt="Trainer" />
            }
            else
            {
                <div class="side-profile-fallback">@trainerInitial</div>
            }

            <div class="side-profile-info">
                <div class="side-profile-name">@trainerName</div>
                <div class="side-profile-role">Trainer</div>
            </div>
        </div>

        <div class="menu-title">MAIN MENU</div>

        <nav class="sidebar-menu">

            <a href="@Url.Action("TrainerDashboard", "Home")" class="menu-item">
                <i class="fa-solid fa-chart-line"></i>
                <span>Dashboard</span>
            </a>

            <a href="@Url.Action("MyClients", "Home")" class="menu-item active">
                <i class="fa-solid fa-users"></i>
                <span>My Clients</span>
                <i class="fa-solid fa-chevron-right menu-arrow"></i>
            </a>

            <a href="@Url.Action("TrainerAppointments", "Home")" class="menu-item">
                <i class="fa-regular fa-calendar-check"></i>
                <span>Appointments</span>
                <i class="fa-solid fa-chevron-right menu-arrow"></i>
            </a>

            <a href="@Url.Action("TrainerWorkoutPlans", "Home")" class="menu-item">
                <i class="fa-solid fa-dumbbell"></i>
                <span>Workout Plans</span>
                <i class="fa-solid fa-chevron-right menu-arrow"></i>
            </a>

            <a href="@Url.Action("TrainerDietPlans", "Home")" class="menu-item">
                <i class="fa-solid fa-apple-whole"></i>
                <span>Diet Plans</span>
                <i class="fa-solid fa-chevron-right menu-arrow"></i>
            </a>

            <a href="@Url.Action("TrainerHealthRecords", "Home")" class="menu-item">
                <i class="fa-solid fa-chart-simple"></i>
                <span>Progress Reports</span>
                <i class="fa-solid fa-chevron-right menu-arrow"></i>
            </a>

            <a href="@Url.Action("TrainerMessages", "Home")" class="menu-item">
                <i class="fa-solid fa-message"></i>
                <span>Messages</span>
            </a>

            <a href="@Url.Action("TrainerNotifications", "Home")" class="menu-item">
                <i class="fa-regular fa-bell"></i>
                <span>Notifications</span>
            </a>

        </nav>

        <div class="sidebar-bottom">
            <div class="sidebar-motivation">
                STRONGER <span>PEOPLE</span><br />
                HEALTHIER TOMORROW
            </div>
            <div class="motivation-line"></div>
        </div>

    </aside>

    <!-- MAIN -->
    <main class="main">

        <!-- TOPBAR -->
        <header class="topbar">

            <div>
                <div class="page-title">My Clients</div>
                <div class="page-subtitle">
                    Manage and monitor your assigned clients
                </div>
            </div>

            <div class="trainer-box">

                @if (!string.IsNullOrWhiteSpace(profilePath))
                {
                    <img src="@profilePath" class="trainer-avatar" alt="Trainer" />
                }
                else
                {
                    <div class="trainer-avatar d-flex align-items-center justify-content-center">
                        <i class="fa-solid fa-user" style="color:#8da5bc;"></i>
                    </div>
                }

                <div>
                    <div class="trainer-name">@ViewBag.UserName</div>
                    <div class="trainer-role">Trainer</div>
                </div>
            </div>

        </header>

        <section class="content">

            <!-- STAT CARDS -->
            <div class="stats">

                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div class="stat-value">@ViewBag.TotalClients</div>
                    <div class="stat-label">Total Clients</div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fa-solid fa-user-check"></i>
                    </div>
                    <div class="stat-value">@ViewBag.ActiveClients</div>
                    <div class="stat-label">Active Clients</div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>
                    <div class="stat-value">@ViewBag.UpcomingAppointments</div>
                    <div class="stat-label">Upcoming Appointments</div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fa-solid fa-dumbbell"></i>
                    </div>
                    <div class="stat-value">@ViewBag.TotalWorkoutPlans</div>
                    <div class="stat-label">Workout Plans</div>
                </div>

            </div>

            <!-- PREMIUM CHAT CLIENT SECTION -->
            <div class="chat-client-banner">

                <div class="chat-client-left">
                    <div class="chat-client-icon">
                        <i class="fa-solid fa-comments"></i>
                    </div>

                    <div class="chat-client-copy">
                        <h4>Chat Clients</h4>
                        <p>
                            Communicate directly with your assigned clients through HealthTrack.
                            Start a conversation from the client list whenever you need.
                        </p>

                        <div class="chat-status">
                            <span class="chat-status-dot"></span>
                            Trainer-to-client communication
                        </div>
                    </div>
                </div>

                <a href="#clientsTable"
                   class="open-chat-btn"
                   onclick="focusFirstChatClient(event)">
                    <i class="fa-solid fa-message"></i>
                    Chat with Client
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

            </div>

            <!-- CLIENTS CARD -->
            <div class="main-card">

                <div class="card-header-custom">

                    <div>
                        <h5>
                            <i class="fa-solid fa-users me-2" style="color:var(--emerald);"></i>
                            My Clients
                        </h5>
                    </div>

                    <div class="client-count">
                        @ViewBag.TotalClients clients
                    </div>

                </div>

                <div class="p-3">

                    <div class="toolbar">

                        <div class="search-box">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="text"
                                   id="clientSearch"
                                   placeholder="Search by client name, email or phone..."
                                   autocomplete="off" />
                        </div>

                        <select id="statusFilter" class="filter-select">
                            <option value="">All Status</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>

                    </div>

                </div>

                <div class="table-wrap">

                    <table id="clientsTable">

                        <thead>
                            <tr>
                                <th>Client</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th>Appointments</th>
                                <th>Workout Plan</th>
                                <th>Diet Plan</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (ViewBag.Clients != null && ViewBag.Clients.Count > 0)
                            {
                                foreach (var client in ViewBag.Clients)
                                {
                                    var status = client.Status?.ToString() ?? "Active";
                                    var statusClass =
                                        status.Equals("Active", StringComparison.OrdinalIgnoreCase)
                                            ? "status-active"
                                            : "status-inactive";

                                    var clientName = client.FullName?.ToString() ?? "Unknown Client";
                                    var email = client.Email?.ToString() ?? "-";
                                    var phone = client.Phone?.ToString() ?? "-";

                                    var appointmentsCount = 0;
                                    var workoutPlanCount = 0;
                                    var dietPlanCount = 0;

                                    if (ViewBag.ClientAppointmentCounts != null &&
                                        ViewBag.ClientAppointmentCounts.ContainsKey(client.UserId))
                                    {
                                        appointmentsCount = ViewBag.ClientAppointmentCounts[client.UserId];
                                    }

                                    if (ViewBag.ClientWorkoutCounts != null &&
                                        ViewBag.ClientWorkoutCounts.ContainsKey(client.UserId))
                                    {
                                        workoutPlanCount = ViewBag.ClientWorkoutCounts[client.UserId];
                                    }

                                    if (ViewBag.ClientDietCounts != null &&
                                        ViewBag.ClientDietCounts.ContainsKey(client.UserId))
                                    {
                                        dietPlanCount = ViewBag.ClientDietCounts[client.UserId];
                                    }

                                    var image = client.ProfileImage?.ToString();
                                    var initial = string.IsNullOrWhiteSpace(clientName)
                                        ? "C"
                                        : clientName.Substring(0, 1).ToUpper();

                                    <tr class="client-row"
                                        data-status="@status.ToLowerInvariant()"
                                        data-search="@($"{clientName} {email} {phone}".ToLowerInvariant())">

                                        <td>
                                            <div class="client-info">

                                                @if (!string.IsNullOrWhiteSpace(image))
                                                {
                                                    <img src="@image"
                                                         class="client-avatar"
                                                         alt="@clientName" />
                                                }
                                                else
                                                {
                                                    <div class="client-avatar d-flex align-items-center justify-content-center"
                                                         style="font-weight:800;color:#75e6c2;">
                                                        @initial
                                                    </div>
                                                }

                                                <div>
                                                    <div class="client-name">@clientName</div>
                                                    <div class="client-email">@email</div>
                                                </div>

                                            </div>
                                        </td>

                                        <td>@phone</td>

                                        <td>
                                            <span class="badge-status @statusClass">
                                                <i class="fa-solid fa-circle" style="font-size:6px;"></i>
                                                @status
                                            </span>
                                        </td>

                                        <td>
                                            <span class="mini-tag">
                                                <i class="fa-solid fa-calendar-check me-1"></i>
                                                @appointmentsCount
                                            </span>
                                        </td>

                                        <td>
                                            <span class="mini-tag">
                                                <i class="fa-solid fa-dumbbell me-1"></i>
                                                @workoutPlanCount
                                            </span>
                                        </td>

                                        <td>
                                            <span class="mini-tag">
                                                <i class="fa-solid fa-utensils me-1"></i>
                                                @dietPlanCount
                                            </span>
                                        </td>

                                        <td>
                                            <div class="action-group">
                                                <button type="button" class="action-btn" title="View Client"
                                                        onclick="openClientView('@client.UserId','@Html.Raw(System.Net.WebUtility.HtmlEncode(clientName))','@Html.Raw(System.Net.WebUtility.HtmlEncode(email))','@Html.Raw(System.Net.WebUtility.HtmlEncode(phone))','@appointmentsCount','@workoutPlanCount','@dietPlanCount','@Html.Raw(System.Net.WebUtility.HtmlEncode(status))')">
                                                    <i class="fa-solid fa-eye"></i>
                                                </button>
                                                <button type="button" class="action-btn chat-action" title="Chat with Client"
                                                        onclick="openChatDrawer('@client.UserId','@Html.Raw(System.Net.WebUtility.HtmlEncode(clientName))','@Html.Raw(System.Net.WebUtility.HtmlEncode(email))','@Html.Raw(System.Net.WebUtility.HtmlEncode(image ?? ""))')">
                                                    <i class="fa-solid fa-comments"></i>
                                                </button>
                                            </div>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7">
                                        <div class="empty-state">
                                            <i class="fa-solid fa-users-slash"></i>
                                            <h5>No Clients Found</h5>
                                            <div>
                                                No clients are currently assigned to you.
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <div id="noSearchResults" class="empty-state" style="display:none;padding:45px 20px;">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <h5>No Matching Clients</h5>
                    <div>Try another name, email, phone number or status.</div>
                </div>

                <div class="footer-note">
                    <i class="fa-solid fa-shield-halved me-1"></i>
                    Showing clients assigned to the currently logged-in trainer.
                </div>

            </div>

        </section>

    </main>

    <div id="clientViewModal" class="modal-overlay" onclick="closeModalOnBackdrop(event,'clientViewModal')">
        <div class="premium-modal">
            <div class="premium-modal-header"><div class="premium-modal-title"><div class="premium-hub-icon" style="margin:0;width:42px;height:42px"><i class="fa-solid fa-user"></i></div><div><h5 id="viewClientName">Client</h5><small>Client Profile Overview</small></div></div><button type="button" class="modal-close" onclick="closeModal('clientViewModal')"><i class="fa-solid fa-xmark"></i></button></div>
            <div class="profile-grid">
                <div class="profile-info-box"><span>Email</span><strong id="viewClientEmail">-</strong></div><div class="profile-info-box"><span>Phone</span><strong id="viewClientPhone">-</strong></div><div class="profile-info-box"><span>Status</span><strong id="viewClientStatus">-</strong></div><div class="profile-info-box"><span>Appointments</span><strong id="viewClientAppointments">0</strong></div><div class="profile-info-box"><span>Workout Plans</span><strong id="viewClientWorkout">0</strong></div><div class="profile-info-box"><span>Diet Plans</span><strong id="viewClientDiet">0</strong></div>
            </div>
        </div>
    </div>
    <div id="clientChatModal" class="modal-overlay" onclick="closeModalOnBackdrop(event,'clientChatModal')">
        <div class="premium-modal">
            <div class="premium-modal-header"><div class="premium-modal-title"><img id="chatClientImage" class="premium-modal-avatar" src="/images/default-user.png" alt="Client" /><div><h5 id="chatClientName">Client Chat</h5><small id="chatClientEmail">Secure trainer-to-client conversation</small></div></div><button type="button" class="modal-close" onclick="closeModal('clientChatModal')"><i class="fa-solid fa-xmark"></i></button></div>
            <div class="chat-body"><div class="chat-notice"><i class="fa-solid fa-shield-halved me-2"></i>Trainer-to-client chat interface. Message storage can be connected to the HealthTrack database.</div><div id="chatMessages" class="chat-messages"><div class="chat-empty"><div><i class="fa-regular fa-comments" style="font-size:30px;color:#4d718d;margin-bottom:10px"></i><div>Start a conversation with this client.</div></div></div></div><div class="chat-composer"><input id="chatInput" type="text" placeholder="Type a message..." autocomplete="off" /><button type="button" class="chat-send-btn" onclick="sendLocalChatMessage()"><i class="fa-solid fa-paper-plane"></i></button></div></div>
        </div>
    </div>


    <!-- PREMIUM CHAT DRAWER -->
    <div id="chatOverlay" class="chat-overlay" onclick="closeChatDrawer()"></div>

    <aside id="chatDrawer" class="chat-drawer" aria-label="Client Chat">

        <div class="chat-drawer-header">
            <div id="chatHeaderAvatarWrap">
                <div class="chat-header-avatar d-flex align-items-center justify-content-center">
                    <i class="fa-solid fa-user" style="color:#8da5bc;"></i>
                </div>
            </div>

            <div class="chat-header-info">
                <div id="chatHeaderName" class="chat-header-title">Client Chat</div>
                <div class="chat-header-status">
                    <span class="chat-status-dot"></span>
                    <span id="chatHeaderStatus">Select a client</span>
                </div>
            </div>

            <div class="chat-header-actions">
                <button type="button"
                        class="chat-icon-btn"
                        title="Voice Call"
                        onclick="startClientCall('voice')">
                    <i class="fa-solid fa-phone"></i>
                </button>

                <button type="button"
                        class="chat-icon-btn"
                        title="Video Call"
                        onclick="startClientCall('video')">
                    <i class="fa-solid fa-video"></i>
                </button>

                <button type="button"
                        class="chat-icon-btn chat-close-btn"
                        title="Close"
                        onclick="closeChatDrawer()">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>

        <div class="chat-client-list">

            <div class="chat-list-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text"
                       id="chatClientSearch"
                       placeholder="Search clients..."
                       autocomplete="off" />
            </div>

            <div id="chatClientList" class="chat-list">
                @if (ViewBag.Clients != null && ViewBag.Clients.Count > 0)
                {
                    foreach (var chatClient in ViewBag.Clients)
                    {
                        var chatName = chatClient.FullName?.ToString() ?? "Client";
                        var chatEmail = chatClient.Email?.ToString() ?? "";
                        var chatImage = chatClient.ProfileImage?.ToString();
                        var chatInitial = string.IsNullOrWhiteSpace(chatName)
                            ? "C"
                            : chatName.Substring(0, 1).ToUpper();

                        <button type="button"
                                class="chat-client-chip"
                                data-client-id="@chatClient.UserId"
                                data-client-name="@chatName"
                                data-client-email="@chatEmail"
                                data-client-image="@chatImage"
                                onclick="selectChatClient(this)">

                            @if (!string.IsNullOrWhiteSpace(chatImage))
                            {
                                <img src="@chatImage"
                                     class="chat-chip-avatar"
                                     alt="@chatName" />
                            }
                            else
                            {
                                <span class="chat-chip-avatar d-flex align-items-center justify-content-center"
                                      style="font-weight:800;color:#75e6c2;">
                                    @chatInitial
                                </span>
                            }

                            <span>
                                <span class="chat-chip-name">@chatName</span>
                                <span class="chat-chip-status">Client</span>
                            </span>

                        </button>
                    }
                }
                else
                {
                    <div class="chat-no-clients">No assigned clients available.</div>
                }
            </div>

        </div>

        <div id="chatMessages" class="chat-messages">

            <div class="chat-date-label">HealthTrack Secure Chat</div>

            <div id="chatEmptyState"
                 class="empty-state"
                 style="padding:70px 15px;">
                <i class="fa-solid fa-comments"></i>
                <h5>Select a Client</h5>
                <div>Choose a client above to start a conversation.</div>
            </div>

            <div id="chatConversation" style="display:none;"></div>

        </div>

        <div class="chat-composer">

            <div class="chat-compose-row">
                <button type="button"
                        class="chat-attach-btn"
                        title="Attach">
                    <i class="fa-solid fa-paperclip"></i>
                </button>

                <input type="text"
                       id="chatMessageInput"
                       class="chat-message-input"
                       placeholder="Type a message..."
                       autocomplete="off" />

                <button type="button"
                        class="chat-send-btn"
                        title="Send"
                        onclick="sendDrawerMessage()">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </div>

        </div>

        <!-- CALL SCREEN -->
        <div id="callPanel" class="call-panel">

            <div class="call-topbar">
                <div>
                    <div id="callTitle" class="call-title">Client Call</div>
                    <div id="callSubtitle" class="call-subtitle">Connecting...</div>
                </div>

                <button type="button"
                        class="chat-icon-btn"
                        onclick="endClientCall()">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="call-stage">

                <div id="callAvatarWrap">
                    <div class="call-avatar-large d-flex align-items-center justify-content-center">
                        <i class="fa-solid fa-user" style="color:#8da5bc;font-size:35px;"></i>
                    </div>
                </div>

                <div id="callName" class="call-name">Client</div>
                <div id="callStatus" class="call-status">Calling...</div>

            </div>

            <div class="call-controls">

                <button type="button"
                        class="call-control"
                        title="Mute"
                        onclick="toggleCallMute(this)">
                    <i class="fa-solid fa-microphone"></i>
                </button>

                <button type="button"
                        class="call-control"
                        title="Camera"
                        onclick="toggleCallCamera(this)">
                    <i class="fa-solid fa-video"></i>
                </button>

                <button type="button"
                        class="call-control end"
                        title="End Call"
                        onclick="endClientCall()">
                    <i class="fa-solid fa-phone-slash"></i>
                </button>

            </div>

        </div>

    </aside>

    <form id="chatAntiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <script>

        let activeChatClient = null;

        function openChatDrawer(clientId, clientName, clientEmail, clientImage) {
            activeChatClient = {
                id: clientId || "",
                name: clientName || "Client",
                email: clientEmail || "",
                image: clientImage || ""
            };

            updateChatHeader();
            showChatConversation();
            loadChatHistory(activeChatClient.id);

            document.getElementById("chatOverlay")?.classList.add("show");
            document.getElementById("chatDrawer")?.classList.add("open");

            const firstMatching = Array.from(
                document.querySelectorAll(".chat-client-chip")
            ).find(btn => btn.dataset.clientName === activeChatClient.name);

            document.querySelectorAll(".chat-client-chip")
                .forEach(btn => btn.classList.remove("active"));

            firstMatching?.classList.add("active");
        }

        function selectChatClient(button) {
            activeChatClient = {
                id: button.dataset.clientId || "",
                name: button.dataset.clientName || "Client",
                email: button.dataset.clientEmail || "",
                image: button.dataset.clientImage || ""
            };

            document.querySelectorAll(".chat-client-chip")
                .forEach(btn => btn.classList.remove("active"));

            button.classList.add("active");

            updateChatHeader();
            showChatConversation();
            loadChatHistory(activeChatClient.id);
        }

        function updateChatHeader() {
            if (!activeChatClient) return;

            const name = document.getElementById("chatHeaderName");
            const status = document.getElementById("chatHeaderStatus");
            const wrap = document.getElementById("chatHeaderAvatarWrap");

            if (name) name.textContent = activeChatClient.name;
            if (status) status.textContent = "Ready to chat";

            if (wrap) {
                if (activeChatClient.image) {
                    wrap.innerHTML =
                        `<img src="${escapeHtmlAttribute(activeChatClient.image)}"
                              class="chat-header-avatar"
                              alt="${escapeHtmlAttribute(activeChatClient.name)}">`;
                } else {
                    const initial = (activeChatClient.name || "C").charAt(0).toUpperCase();
                    wrap.innerHTML =
                        `<div class="chat-header-avatar d-flex align-items-center justify-content-center"
                              style="font-weight:800;color:#75e6c2;">
                            ${escapeHtml(initial)}
                         </div>`;
                }
            }
        }

        function showChatConversation() {
            document.getElementById("chatEmptyState")?.style.setProperty("display", "none");
            document.getElementById("chatConversation")?.style.setProperty("display", "block");
        }

        function closeChatDrawer() {
            document.getElementById("chatOverlay")?.classList.remove("show");
            document.getElementById("chatDrawer")?.classList.remove("open");
            endClientCall(true);
        }

        function focusFirstChatClient(event) {
            event?.preventDefault();

            const tableFirstChat = document.querySelector(".client-chat-trigger");
            if (tableFirstChat) {
                tableFirstChat.click();
                return;
            }

            const firstClient = document.querySelector(".chat-client-chip");
            if (firstClient) {
                openChatDrawer(
                    firstClient.dataset.clientId,
                    firstClient.dataset.clientName,
                    firstClient.dataset.clientEmail,
                    firstClient.dataset.clientImage
                );
            } else {
                openChatDrawer("", "Client", "", "");
            }
        }

        async function sendDrawerMessage() {
            const input = document.getElementById("chatMessageInput");
            const text = (input?.value || "").trim();

            if (!text || !activeChatClient?.id) return;

            const token = document.querySelector(
                '#chatAntiForgeryForm input[name="__RequestVerificationToken"]'
            )?.value;

            if (!token) {
                alert("Security token is missing. Please refresh the page.");
                return;
            }

            const body = new URLSearchParams();
            body.append("__RequestVerificationToken", token);
            body.append("receiverId", activeChatClient.id);
            body.append("message", text);

            try {
                input.disabled = true;

                const response = await fetch(
                    '@Url.Action("SendTrainerMessage", "Home")',
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
                        },
                        body: body.toString()
                    }
                );

                if (!response.ok) {
                    throw new Error("Message could not be sent.");
                }

                input.value = "";
                await loadChatHistory(activeChatClient.id);
            }
            catch (error) {
                console.error(error);
                alert("Message could not be sent. Please try again.");
            }
            finally {
                input.disabled = false;
                input.focus();
            }
        }

        async function loadChatHistory(clientId) {
            const conversation = document.getElementById("chatConversation");
            if (!conversation || !clientId) return;

            conversation.innerHTML = `
                <div style="padding:30px;text-align:center;color:#7f9bb2;font-size:11px;">
                    Loading messages...
                </div>`;

            try {
                const url =
                    '@Url.Action("TrainerMessages", "Home")' +
                    '?clientId=' + encodeURIComponent(clientId);

                const response = await fetch(url, {
                    method: "GET",
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });

                if (!response.ok) {
                    throw new Error("Chat history could not be loaded.");
                }

                const html = await response.text();
                const doc = new DOMParser().parseFromString(html, "text/html");
                const source = doc.querySelector("#chatMessages");
                const sourceRows = source
                    ? source.querySelectorAll(".message-row")
                    : [];

                conversation.innerHTML = "";

                if (!sourceRows.length) {
                    conversation.innerHTML = `
                        <div class="chat-empty" style="height:100%;display:flex;align-items:center;justify-content:center;text-align:center;">
                            <div>
                                <i class="fa-regular fa-comments" style="font-size:30px;color:#4d718d;margin-bottom:10px"></i>
                                <div>Start a conversation with this client.</div>
                            </div>
                        </div>`;
                    return;
                }

                sourceRows.forEach(sourceRow => {
                    const sourceBubble = sourceRow.querySelector(".bubble");
                    if (!sourceBubble) return;

                    const isTrainer = sourceRow.classList.contains("trainer");
                    const timeElement = sourceBubble.querySelector(".message-time");
                    const timeText = timeElement?.textContent?.trim() || "";

                    if (timeElement) timeElement.remove();
                    const messageText = sourceBubble.textContent.trim();

                    const row = document.createElement("div");
                    row.className = "chat-message-row " + (isTrainer ? "trainer" : "client");

                    const bubble = document.createElement("div");
                    bubble.className = "chat-bubble";
                    bubble.appendChild(document.createTextNode(messageText));

                    if (timeText) {
                        const time = document.createElement("span");
                        time.className = "chat-time";
                        time.textContent = timeText;
                        bubble.appendChild(time);
                    }

                    row.appendChild(bubble);
                    conversation.appendChild(row);
                });

                const messages = document.getElementById("chatMessages");
                if (messages) messages.scrollTop = messages.scrollHeight;
            }
            catch (error) {
                console.error(error);
                conversation.innerHTML = `
                    <div style="padding:30px;text-align:center;color:#d88;font-size:11px;">
                        Unable to load chat history.
                    </div>`;
            }
        }

        function startClientCall(type) {
            if (!activeChatClient) {
                const firstClient = document.querySelector(".chat-client-chip");
                if (!firstClient) return;

                selectChatClient(firstClient);
            }

            const panel = document.getElementById("callPanel");
            if (!panel) return;

            const title = document.getElementById("callTitle");
            const subtitle = document.getElementById("callSubtitle");
            const callName = document.getElementById("callName");
            const callStatus = document.getElementById("callStatus");
            const avatarWrap = document.getElementById("callAvatarWrap");

            const isVideo = type === "video";

            if (title) {
                title.textContent = isVideo ? "Video Call" : "Voice Call";
            }

            if (subtitle) {
                subtitle.textContent = activeChatClient.name;
            }

            if (callName) {
                callName.textContent = activeChatClient.name;
            }

            if (callStatus) {
                callStatus.textContent = isVideo
                    ? "Starting video call..."
                    : "Starting voice call...";
            }

            if (avatarWrap) {
                if (activeChatClient.image) {
                    avatarWrap.innerHTML =
                        `<img src="${escapeHtmlAttribute(activeChatClient.image)}"
                              class="call-avatar-large"
                              alt="${escapeHtmlAttribute(activeChatClient.name)}">`;
                } else {
                    const initial = (activeChatClient.name || "C").charAt(0).toUpperCase();
                    avatarWrap.innerHTML =
                        `<div class="call-avatar-large d-flex align-items-center justify-content-center"
                              style="font-weight:800;color:#75e6c2;font-size:34px;">
                            ${escapeHtml(initial)}
                         </div>`;
                }
            }

            panel.classList.add("show");

            setTimeout(() => {
                if (callStatus) {
                    callStatus.textContent = isVideo
                        ? "Waiting for client..."
                        : "Calling client...";
                }
            }, 700);
        }

        function endClientCall(silent = false) {
            const panel = document.getElementById("callPanel");
            panel?.classList.remove("show");

            if (!silent) {
                const status = document.getElementById("chatHeaderStatus");
                if (status && activeChatClient) {
                    status.textContent = "Ready to chat";
                }
            }
        }

        function toggleCallMute(button) {
            button.classList.toggle("active");
            const icon = button.querySelector("i");
            if (icon) {
                icon.className = button.classList.contains("active")
                    ? "fa-solid fa-microphone-slash"
                    : "fa-solid fa-microphone";
            }
        }

        function toggleCallCamera(button) {
            button.classList.toggle("active");
            const icon = button.querySelector("i");
            if (icon) {
                icon.className = button.classList.contains("active")
                    ? "fa-solid fa-video-slash"
                    : "fa-solid fa-video";
            }
        }

        function escapeHtml(value) {
            const div = document.createElement("div");
            div.textContent = value ?? "";
            return div.innerHTML;
        }

        function escapeHtmlAttribute(value) {
            return String(value ?? "")
                .replace(/&/g, "&amp;")
                .replace(/"/g, "&quot;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");
        }

        document.getElementById("chatClientSearch")?.addEventListener("input", function () {
            const query = (this.value || "").toLowerCase().trim();

            document.querySelectorAll(".chat-client-chip").forEach(button => {
                const name = (button.dataset.clientName || "").toLowerCase();
                const email = (button.dataset.clientEmail || "").toLowerCase();

                button.style.display =
                    !query || name.includes(query) || email.includes(query)
                        ? ""
                        : "none";
            });
        });

        document.getElementById("chatMessageInput")?.addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                sendDrawerMessage();
            }
        });

        const searchInput = document.getElementById("clientSearch");
        const statusFilter = document.getElementById("statusFilter");
        const rows = document.querySelectorAll(".client-row");
        const noResults = document.getElementById("noSearchResults");

        function filterClients() {
            const search = (searchInput.value || "").toLowerCase().trim();
            const status = (statusFilter.value || "").toLowerCase();

            let visible = 0;

            rows.forEach(row => {
                const rowSearch = row.getAttribute("data-search") || "";
                const rowStatus = row.getAttribute("data-status") || "";

                const searchMatch = !search || rowSearch.includes(search);
                const statusMatch = !status || rowStatus === status;

                if (searchMatch && statusMatch) {
                    row.style.display = "";
                    visible++;
                } else {
                    row.style.display = "none";
                }
            });

            noResults.style.display = visible === 0 && rows.length > 0
                ? "block"
                : "none";
        }

        searchInput?.addEventListener("input", filterClients);
        statusFilter?.addEventListener("change", filterClients);
    </script>


<script>
function closeModal(id){const m=document.getElementById(id);if(m)m.style.display='none';}
function closeModalOnBackdrop(e,id){if(e.target&&e.target.id===id)closeModal(id);}
function openClientView(id,name,email,phone,appointments,workout,diet,status){document.getElementById('viewClientName').textContent=name||'Client';document.getElementById('viewClientEmail').textContent=email||'-';document.getElementById('viewClientPhone').textContent=phone||'-';document.getElementById('viewClientStatus').textContent=status||'-';document.getElementById('viewClientAppointments').textContent=appointments||'0';document.getElementById('viewClientWorkout').textContent=workout||'0';document.getElementById('viewClientDiet').textContent=diet||'0';document.getElementById('clientViewModal').style.display='flex';}
function openClientChat(id,name,email,image){document.getElementById('chatClientName').textContent=name||'Client Chat';document.getElementById('chatClientEmail').textContent=email||'Secure trainer-to-client conversation';const img=document.getElementById('chatClientImage');img.src=image||'/images/default-user.png';img.onerror=function(){this.src='/images/default-user.png'};document.getElementById('chatInput').value='';document.getElementById('clientChatModal').style.display='flex';setTimeout(()=>document.getElementById('chatInput').focus(),100);}
function sendLocalChatMessage(){const input=document.getElementById('chatInput');const text=input.value.trim();if(!text)return;const area=document.getElementById('chatMessages');const empty=area.querySelector('.chat-empty');if(empty)empty.remove();const bubble=document.createElement('div');bubble.className='chat-bubble';bubble.textContent=text;area.appendChild(bubble);area.scrollTop=area.scrollHeight;input.value='';}
document.addEventListener('keydown',function(e){if(e.key==='Escape'){closeModal('clientViewModal');closeModal('clientChatModal')}if(e.key==='Enter'&&document.activeElement===document.getElementById('chatInput')){e.preventDefault();sendLocalChatMessage()}});
</script>
</body>
</html>
